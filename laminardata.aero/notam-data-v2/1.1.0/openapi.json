    "/countries/{country.code.iso}/notams": {
      "get": {
        "tags": [
          "NOTAMs by Country Code"
        ],
        "summary": "NOTAMs By Country Code",
        "description": "Retrieves a list of all NOTAMs for a given ISO 3166 country code in a GeoJSON response format.</br></br>The NOTAM ```countryCode``` property is derived from the ```location``` property if it is a valid ICAO designator, <b>not</b> from the NOTAM ```text``` or ```geometry``` properties.</br></br>Here are some country code examples to use in the request:</br>- AUS</br>- GBR</br>- LUX</br></br>As mentioned in the response section, if your application does not have the agreed access to a particular country then you will recieve an unauthorized response when requesting NOTAM information for that country.",
        "parameters": [
          {
            "name": "country.code.iso",
            "in": "path",
            "description": "The ISO 3166 code for a country code e.g. GBR.<p></p><b>Country Code ISO rules:</b><ul><li>MUST be letters (case sensitive)</li><li>MUST be only three characters</li></ul>",
            "required": true,
            "type": "string"
          },
          {
            "name": "user_key",
            "in": "query",
            "description": "User Key Authentication Parameter",
            "required": true,
            "type": "string",
            "threescale_name": "user_keys",
            "x-data-threescale-name": "user_keys"
          }
        ],
        "responses": {
          "200": {
            "description": "NOTAMs by Country Code Success Response",
            "schema": {
              "$ref": "#/definitions/successResponseNotam"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              },
              "cache-control": {
                "type": "string",
                "description": "Used to specify directives for caching mechanisms"
              }
            }
          },
          "400": {
            "description": "The request sent was not understood by the system",
            "schema": {
              "$ref": "#/definitions/badRequestFailureResponse"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              }
            }
          },
          "401": {
            "description": "The request sent had unauthorized country codes for supplied user_key",
            "schema": {
              "title": "Unauthorized Country Code Failure Response",
              "type": "object",
              "required": [
                "error"
              ],
              "additionalProperties": false,
              "properties": {
                "error": {
                  "title": "Unauthorized Error",
                  "description": "Contains the unauthorized failure information",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "description": "Response code",
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "description": "Response message",
                      "type": "string",
                      "example": "Authorization Required"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The request sent could not be authenticated by the system",
            "schema": {
              "$ref": "#/definitions/authenticationFailureResponse"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "successResponseNotam": {
      "title": "NOTAMs",
      "description": "NOTAMs are provided as a collection of GeoJSON feature collection objects (RFC 7946)",
      "type": "object",
      "required": [
        "type",
        "features",
        "results"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "title": "The Type Schema ",
          "example": "FeatureCollection"
        },
        "features": {
          "type": "array",
          "title": "GeoJSON Features",
          "items": {
            "title": "GeoJSON Feature Properties",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "title": "The Features Id Schema",
                "example": "116128c3-2fbd-4edc-895f-85c21ceae545"
              },
              "type": {
                "type": "string",
                "title": "The Features Type Schema ",
                "enum": [
                  "Feature"
                ]
              },
              "geometry": {
                "title": "GeoJSON Feature Geometry",
                "description": "The position of the NOTAM.",
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "title": "The Type Schema ",
                    "example": "GeometryCollection"
                  },
                  "geometries": {
                    "type": "array",
                    "items": {
                      "title": "NOTAM Geometries",
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "title": "The Type Schema ",
                          "example": "Polygon"
                        },
                        "lowerLimit": {
                          "title": "NOTAM Geometry Lower Limit",
                          "type": "object",
                          "properties": {
                            "uom": {
                              "type": "string",
                              "title": "The Uom Schema ",
                              "example": "FEET"
                            },
                            "value": {
                              "type": "number",
                              "title": "The Value Schema ",
                              "example": 5000
                            },
                            "reference": {
                              "type": "string",
                              "title": "The Reference Schema ",
                              "example": "AGL"
                            }
                          },
                          "additionalProperties": false
                        },
                        "upperLimit": {
                          "title": "NOTAM Geometry Upper Limit",
                          "type": "object",
                          "properties": {
                            "uom": {
                              "type": "string",
                              "title": "The Uom Schema ",
                              "example": "FEET"
                            },
                            "value": {
                              "type": "number",
                              "title": "The Value Schema ",
                              "example": 15000
                            },
                            "reference": {
                              "type": "string",
                              "title": "The Reference Schema ",
                              "example": "AMSL"
                            }
                          },
                          "additionalProperties": false
                        },
                        "coordinates": {
                          "title": "NOTAM Geometry Coordinates",
                          "type": "array",
                          "items": {
                            "title": "NOTAM Geometry Coordinates (lon and lat)",
                            "type": "array",
                            "items": {
                              "type": "number",
                              "title": "NOTAM Geometry Coordinate",
                              "example": [
                                122.38795471191406,
                                -38.26834487915039
                              ]
                            }
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "properties": {
                "title": "NOTAM Properties",
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "number",
                    "title": "The Lat Schema ",
                    "example": 33.96670150756836
                  },
                  "lon": {
                    "type": "number",
                    "title": "The Lon Schema ",
                    "example": -117.63330078125
                  },
                  "series": {
                    "type": "string",
                    "title": "The Series Schema",
                    "example": "A"
                  },
                  "text": {
                    "type": "string",
                    "title": "The Text Schema ",
                    "example": "OBST TOWER LGT (ASN 2011-AWP-7801-OE) 335955N1173935W (1.9NM NW CNO) 878FT (190FT AGL) OUT OF SERVICE"
                  },
                  "type": {
                    "type": "string",
                    "title": "The Type Schema ",
                    "example": "N"
                  },
                  "year": {
                    "type": "integer",
                    "title": "The Year Schema ",
                    "example": 2018
                  },
                  "scope": {
                    "type": "string",
                    "title": "The Scope Schema ",
                    "example": "E"
                  },
                  "issued": {
                    "type": "string",
                    "title": "The Issued Schema ",
                    "example": "2018-04-15T17:14:00Z"
                  },
                  "number": {
                    "type": "integer",
                    "title": "The Number Schema ",
                    "example": 34
                  },
                  "radius": {
                    "type": "integer",
                    "title": "The Radius Schema ",
                    "example": 34
                  },
                  "purpose": {
                    "type": "string",
                    "title": "The Purpose Schema ",
                    "example": "M"
                  },
                  "traffic": {
                    "type": "string",
                    "title": "The Traffic Schema ",
                    "example": "IV"
                  },
                  "location": {
                    "type": "string",
                    "title": "The ICAO location of the NOTAM",
                    "example": "KCNO"
                  },
                  "maximumFL": {
                    "type": "integer",
                    "title": "The Maximumfl Schema ",
                    "example": 999
                  },
                  "minimumFL": {
                    "type": "integer",
                    "title": "The Minimumfl Schema ",
                    "example": 0
                  },
                  "affectedFIR": {
                    "type": "string",
                    "title": "The Affectedfir Schema ",
                    "example": "EGXX"
                  },
                  "effectiveEnd": {
                    "type": "string",
                    "title": "The Effectiveend Schema ",
                    "example": "2018-04-30T17:14:00Z"
                  },
                  "effectiveEndInterpretation": {
                    "type": "string",
                    "title": "The Effectiveend Interpretation Schema ",
                    "example": "EST"
                  },
                  "countryCode": {
                    "type": "string",
                    "title": "ISO 3166-1 alpha-3 country code",
                    "example": "GBR"
                  },
                  "publisherNOF": {
                    "type": "string",
                    "title": "The Publishernof Schema ",
                    "example": "CNO"
                  },
                  "translations": {
                    "type": "array",
                    "items": {
                      "title": "NOTAM Translations",
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "title": "The Type Schema ",
                          "example": "OTHER_ICAO"
                        },
                        "language": {
