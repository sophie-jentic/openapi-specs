{
  "swagger": "2.0",
  "info": {
    "title": "NOTAM Data v2",
    "description": "To request a compressed response from the NOTAM APIs, add the header ```Accept-Encoding: gzip``` to your request.</br></br>The service confirms that responses are compressed by including the response header ```Content-Encoding: gzip```.</br></br>Please note that the NOTAM APIs cache responses for 60 seconds.",
    "termsOfService": "https://developer.laminardata.aero/admin/account/termsofservice",
    "contact": {
      "name": "Cirium Help Desk Team",
      "email": "helpdesk@cirium.com"
    },
    "license": {
      "name": "Laminar Data End User License Agreement",
      "url": "https://developer.laminardata.aero/admin/account/termsofservice"
    },
    "version": "1.1.0",
    "x-jentic-source-url": "https://developer.laminardata.aero/swagger/spec/notam_data_v2.json"
  },
  "host": "api.laminardata.aero",
  "schemes": [
    "https"
  ],
  "basePath": "/v2",
  "produces": [
    "application/json"
  ],
  "paths": {
    "/icao-prefixes/{icao.prefix}/firs/{fir.icao}/notams": {
      "get": {
        "tags": [
          "NOTAMs by Flight Information Region"
        ],
        "summary": "NOTAMs by Flight Information Region",
        "description": "<p>Retrieves a list of all NOTAMs for a given FIR in a GeoJSON response format.</p><p>For a list of possible ICAO prefixes and FIRs refer to the Reference Data APIs <a href='https://developer.laminardata.aero/documentation/referencedata'><u>here</u></a>.",
        "parameters": [
          {
            "name": "icao.prefix",
            "in": "path",
            "description": "First letter of the ICAO designator e.g. E (Case sensitive)",
            "required": true,
            "type": "string"
          },
          {
            "name": "fir.icao",
            "in": "path",
            "description": "ICAO code of the FIR e.g. EGTT (Case sensitive)",
            "required": true,
            "type": "string"
          },
          {
            "name": "qcode",
            "in": "query",
            "description": "The Q-Code or selection code such as QOBCE to obtain obstacle related NOTAMs.<p>Adding a Q-Code parameter will return only NOTAMS with the specified Q-Code.</p><b>Q-Code rules:</b><ul><li>MUST start with a 'Q'</li><li>MUST be five characters</li><li>MUST be entered if 'TEXT_CONTAINS' is empty'</li></ul>",
            "required": false,
            "type": "string"
          },
          {
            "name": "text_contains",
            "in": "query",
            "description": "Searches the 'text' field in the NOTAM response and returns only NOTAMs with text containing the specified values.<p>Multiple phrases can be searched for, by using a comma separated listed such as GPS,OBST. In this case, it returns only NOTAMs with text containing all the words.</p><b>Text Contains rules:</b><ul><li>MUST have less than 21 characters</li><li>MUST only contain alphanumeric characters or commas</li><li>MUST be entered if 'Q-Code' is empty'</li></ul>",
            "required": false,
            "type": "string"
          },
          {
            "name": "user_key",
            "in": "query",
            "description": "User Key Authentication Parameter",
            "required": true,
            "type": "string",
            "threescale_name": "user_keys",
            "x-data-threescale-name": "user_keys"
          }
        ],
        "responses": {
          "200": {
            "description": "NOTAMs by FIR Success Response",
            "schema": {
              "$ref": "#/definitions/successResponseNotam"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              },
              "cache-control": {
                "type": "string",
                "description": "Used to specify directives for caching mechanisms"
              }
            }
          },
          "400": {
            "description": "The request sent was not understood by the system",
            "schema": {
              "$ref": "#/definitions/badRequestFailureResponse"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              }
            }
          },
          "403": {
            "description": "The request sent could not be authenticated by the system",
            "schema": {
              "$ref": "#/definitions/authenticationFailureResponse"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              }
            }
          }
        }
      }
    },
    "/aerodromes/{aerodrome.icao}/notams": {
      "get": {
        "tags": [
          "NOTAMs by Aerodrome"
        ],
        "summary": "NOTAMs by Aerodrome",
        "description": "<p>Retrieves a list of all NOTAMs for a given aerodrome in a GeoJSON response format.</p>",
        "parameters": [
          {
            "name": "aerodrome.icao",
            "in": "path",
            "description": "The ICAO code for an aerodrome e.g. EGLL.<p></p><b>Aerodrome ICAO rules:</b><ul><li>MUST be letters (case sensitive)</li><li>MUST be only four characters</li></ul>",
            "required": true,
            "type": "string"
          },
          {
            "name": "qcode",
            "in": "query",
            "description": "The Q-Code or selection code such as QOBCE to obtain obstacle related NOTAMs.<p>Adding a Q-Code parameter will return only NOTAMS with the specified Q-Code.</p><b>Q-Code rules:</b><ul><li>MUST start with a 'Q'</li><li>MUST be five characters</li><li>MUST be entered if 'TEXT_CONTAINS' is empty'</li></ul>",
            "required": false,
            "type": "string"
          },
          {
            "name": "text_contains",
            "in": "query",
            "description": "<p>Searches the 'text' field in the NOTAM response and returns only NOTAMs with text containing the specified values.<p>Multiple phrases can be searched for, by using a comma separated listed such as GPS,OBST. In this case, it returns only NOTAMs with text containing all the words.</p><b>Text Contains rules:</b><ul><li>MUST have less than 21 characters</li><li>MUST only contain alphanumeric characters or commas</li><li>MUST be entered if 'Q-Code' is empty'</li></ul></p>",
            "required": false,
            "type": "string"
          },
          {
            "name": "user_key",
            "in": "query",
            "description": "User Key Authentication Parameter",
            "required": true,
            "type": "string",
            "threescale_name": "user_keys",
            "x-data-threescale-name": "user_keys"
          }
        ],
        "responses": {
          "200": {
            "description": "NOTAMs by Aerodrome Success Response",
            "schema": {
              "$ref": "#/definitions/successResponseNotam"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              },
              "cache-control": {
                "type": "string",
                "description": "Used to specify directives for caching mechanisms"
              }
            }
          },
          "400": {
            "description": "The request sent was not understood by the system",
            "schema": {
              "$ref": "#/definitions/badRequestFailureResponse"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              }
            }
          },
          "403": {
            "description": "The request sent could not be authenticated by the system",
            "schema": {
              "$ref": "#/definitions/authenticationFailureResponse"
            },
            "headers": {
              "content-type": {
                "type": "string",
                "description": "Indicates the response body format"
              }
            }
          }
        }
      }
    },
