      ],
      "post": {
        "summary": "Submit Telemetry Data",
        "description": "Submit site load telemetry readings for a client.\n\nAccepts either a **single** telemetry object or an **array** of telemetry objects.\n\n**Field requirements:**\n- `type` \u2014 Must be `\"site-load\"`\n- `units` \u2014 Must be one of: `\"W\"`, `\"kW\"`, or `\"MW\"`\n- `value` \u2014 Must be a positive number\n- `timestamp` \u2014 ISO 8601 format (UTC recommended)\n",
        "operationId": "submitTelemetry",
        "tags": [
          "Telemetry"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryRequest"
