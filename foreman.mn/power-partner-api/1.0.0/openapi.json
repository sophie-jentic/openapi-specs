                      "timestamp": "2024-01-20T14:00:00Z",
                      "type": "site-load",
                      "value": 50.0,
                      "units": "MW"
                    },
                    {
                      "timestamp": "2024-01-20T14:05:00Z",
                      "type": "site-load",
                      "value": 45.5,
                      "units": "MW"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
