              }
            }
          }
        }
      }
    },
    "schemas": {
      "WerkzaamheidHALResponseList": {
        "required": [
          "_links",
          "page"
        ],
        "properties": {
          "_embedded": {
            "required": [
              "werkzaamheden"
            ],
            "properties": {
              "werkzaamheden": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/WerkzaamheidResponse"
                }
              }
            }
          },
          "_links": {
            "$ref": "#/components/schemas/HalPaginationLinks"
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        }
      },
      "WerkzaamheidResponse": {
        "required": [
          "urn",
          "omschrijving",
          "functioneleStructuurRef"
        ],
        "properties": {
          "urn": {
            "$ref": "#/components/schemas/WerkzaamheidUrn"
          },
          "omschrijving": {
            "description": "Omschrijving van de werkzaamheid.",
            "type": "string"
          },
          "functioneleStructuurRef": {
            "description": "De functioneleStructuurRef van de werkzaamheid.",
            "type": "string"
          },
          "trefwoorden": {
            "description": "Trefwoorden van de werkzaamheid die voldoen aan de zoekterm.",
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/components/schemas/Trefwoord"
            }
          }
        }
      },
      "ActiviteitHALResponseList": {
        "required": [
          "_links",
          "aggregaties",
          "page"
        ],
        "properties": {
          "_embedded": {
            "required": [
              "activiteiten"
            ],
            "properties": {
              "activiteiten": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/ActiviteitResponse"
                }
              }
            }
          },
          "_links": {
            "$ref": "#/components/schemas/HalPaginationLinks"
          },
          "aggregaties": {
            "$ref": "#/components/schemas/Aggregaties"
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        }
      },
      "ActiviteitResponse": {
        "required": [
          "urn",
          "type",
          "omschrijving",
          "functioneleStructuurRef",
          "bestuursorgaan",
          "locaties"
        ],
        "properties": {
          "urn": {
            "$ref": "#/components/schemas/ActiviteitUrn"
          },
          "type": {
            "$ref": "#/components/schemas/ActiviteitTypering"
          },
          "omschrijving": {
            "description": "Omschrijving van de activiteit",
            "type": "string"
          },
          "functioneleStructuurRef": {
            "description": "De functioneleStructuurRef die verwijst naar de regels (STTR) m.b.t. indieningsvereisten",
            "type": "string"
          },
          "bestuursorgaan": {
            "description": "Bestuursorgaan dat eigenaar is van de activiteit",
            "allOf": [
              {
                "description": "Organisatie",
                "required": [
                  "oin",
                  "bestuurslaag"
                ],
                "properties": {
                  "oin": {
                    "description": "OIN van de organisatie",
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 20
                  },
                  "bestuurslaag": {
                    "$ref": "#/components/schemas/Bestuurslaag"
                  }
                }
              }
            ]
          },
          "toestemming": {
            "$ref": "#/components/schemas/Toestemming"
          },
          "locaties": {
            "description": "Locaties waarop de activiteit actief is",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "WerkzaamheidUrn": {
        "description": "Urn van de werkzaamheid",
        "type": "string",
        "pattern": "^\\w{1,100}$",
        "example": "BoomKappen"
      },
      "ActiviteitUrn": {
        "description": "Urn van de activiteit (In de urn mogen geen spaties voorkomen). Binnen de keten staat urn bekend als de imow-id.",
        "type": "string",
        "minLength": 1,
        "maxLength": 250
      },
      "ActiviteitTypering": {
        "description": "Typering van de activiteit",
        "type": "string",
        "enum": [
          "Water",
          "Milieubelastende",
          "Overige"
        ]
      },
      "Trefwoord": {
        "description": "Trefwoord van de werkzaamheid.",
        "type": "string"
      },
      "ZoekCriteriaWerkzaamheden": {
        "description": "De zoekcriteria om werkzaamheden te zoeken.",
        "properties": {
          "zoekterm": {
            "description": "De zoekterm op basis waarvan in de werkzaamheden gezocht wordt. Als het veld \"zoekterm\" niet wordt meegegeven worden alle werkzaamheden teruggegeven.",
            "type": "string"
          },
          "sortering": {
            "$ref": "#/components/schemas/Sortering"
          }
        }
      },
      "ZoekCriteriaActiviteiten": {
        "description": "De zoekcriteria om activiteiten te zoeken. Zoeken gebeurt op basis van een zoekterm, resultaten kunnen verder gefilterd worden op de velden in het zoekresultaat.",
        "properties": {
          "datum": {
            "description": "Filter op activiteiten die op deze datum actief zijn. Het formaat van de datum is dd-MM-yyyy.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Datum"
              }
            ]
          },
          "locaties": {
            "description": "Filter op de locatie van de activiteit.",
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "string"
            }
          },
          "bestuurslagen": {
            "description": "Filter op bestuurslaag van het bestuursorgaan van de activiteit.",
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Bestuurslaag"
            }
          },
          "toestemmingen": {
            "description": "Filter op indieningsvereisten toestemming",
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "items": {
              "$ref": "#/components/schemas/Toestemming"
            }
          },
          "functioneleStructuurReferenties": {
            "description": "De zoekterm op basis waarvan in de activiteiten gezocht wordt. Filter op functioneleStructuurReferentie",
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "string"
            }
          },
          "zoekterm": {
            "description": "De zoekterm op basis waarvan in de activiteiten gezocht wordt.",
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "sortering": {
            "$ref": "#/components/schemas/Sortering"
          }
        }
      },
      "Sortering": {
        "description": "De sortering waarin de resultaten worden geretourneerd. Bij \"alfabetisch\" worden de resultaten alfabetisch gesorteerd. \"besteMatch\" zorgt ervoor dat de resultaten die het meest matchen met de zoekterm bovenaan komen (bij deze sortering is het veld \"zoekterm\" daarom verplicht). \"meestGekozen\" wil zeggen dat de in het loket meest gekozen resultaten bovenaan staan. Als het veld \"sortering\" niet wordt meegegeven wordt de \"meestGekozen\" sortering gebruikt.",
        "type": "string",
        "enum": [
          "alfabetisch",
          "besteMatch",
          "meestGekozen"
        ],
        "default": "meestGekozen"
      },
      "SuggestiesCriteria": {
        "description": "De zoekterm.",
        "required": [
          "zoekterm"
        ],
        "properties": {
          "zoekterm": {
            "description": "De zoekterm op basis waarvan suggesties teruggegeven moeten worden.",
            "type": "string"
          }
        }
      },
      "Zoekterm": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
      },
      "Datum": {
        "description": "Datum in het formaat dd-MM-yyyy.",
        "type": "string",
        "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
        "example": "01-01-2023"
      },
      "Bestuurslaag": {
        "description": "Bestuurslaag van een Organisatie",
        "type": "string",
        "enum": [
          "rijk",
          "provincie",
          "waterschap",
          "gemeente"
        ]
      },
      "Toestemming": {
        "type": "string",
        "description": "Code van de toestemming",
        "enum": [
          "Vergunning",
          "Melding",
          "Informatie",
          "InformatieOngewoonVoorval",
          "AanvraagMaatwerkvoorschrift",
          "MeldingGelijkwaardigeMaatregel",
          "AanvraagToestemmingGelijkwaardigeMaatregel"
        ]
      },
      "BestuurslaagAggregatie": {
        "description": "Per bestuurslaag het aantal keer dat de bestuurslaag voorkomt in de gevonden activiteiten. Let op dat het bestuurslaag filter hierin NIET wordt meegenomen (andere filters wel). Dit is handig wanneer de aggregaties worden gepresenteerd in een user interface, dan kan de gebruiker namelijk het aantal resultaten uitbreiden door ook een andere bestuurslaag te selecteren.",
        "required": [
          "bestuurslaag",
          "aantal"
        ],
        "properties": {
          "bestuurslaag": {
            "$ref": "#/components/schemas/Bestuurslaag"
          },
          "aantal": {
            "description": "Het aantal resultaten voor de bestuurslaag, waarbij het bestuurslaag filter NIET wordt meegenomen",
            "type": "number"
          }
        }
      },
      "ToestemmingAggregatie": {
        "description": "Per toestemming het aantal keer dat de toestemming voorkomt in de gevonden activiteiten. Let op dat het toestemming filter hierin NIET wordt meegenomen (andere filters wel). Dit is handig wanneer de aggregaties worden gepresenteerd in een user interface, dan kan de gebruiker namelijk het aantal resultaten uitbreiden door ook een andere toestemming te selecteren.",
        "required": [
          "toestemming",
          "aantal"
        ],
        "properties": {
          "toestemming": {
            "$ref": "#/components/schemas/Toestemming"
          },
          "aantal": {
            "description": "Het aantal resultaten voor de toestemming, waarbij het bestuurslaag filter NIET wordt meegenomen",
            "type": "number"
          }
        }
      },
      "BestuursorganenPerBestuurslaagAggregatie": {
        "description": "De meest voorkomende bestuursorganen in de gevonden activiteiten met het aantal keer dat ze voorkomen. Deze zijn opgedeeld per bestuurslaag.",
        "required": [
          "bestuurslaag",
          "bestuursorganen"
        ],
        "properties": {
          "bestuurslaag": {
            "$ref": "#/components/schemas/Bestuurslaag"
          },
          "bestuursorganen": {
            "type": "array",
            "items": {
