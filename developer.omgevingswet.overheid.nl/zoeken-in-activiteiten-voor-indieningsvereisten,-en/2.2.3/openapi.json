        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "required": false
      },
      "pageSizeEnum": {
        "name": "pageSize",
        "description": "Het gewenste aantal items per pagina in een gepagineerde response. Indien deze parameter niet ingevuld is worden er standaard 20 resultaten geretourneerd.",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 20,
          "enum": [
            10,
            20,
            50,
            100,
            200
          ]
        },
        "required": false
      }
    },
