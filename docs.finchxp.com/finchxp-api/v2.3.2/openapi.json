    "/api/finchxp/basiq/transactions/user/{externalUserId}": {
      "post": {
        "summary": "Basiq Connections",
        "description": "This endpoint allows Clients to pass through data to the FinchXP platform in the same response format (JSON) received from the Basiq, reducing the effort and potential errors during integration.\n    The API processes up to 100 transactions per request in real-time speed (<2 sec), and the data intelligence varies based on the subscribed product type.",
        "operationId": "processTransactions",
        "parameters": [
          {
            "name": "BasiqTransactionsContainer",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/BasiqTransactionsContainer"
            }
          },
          {
            "type": "string",
            "name": "externalUserId",
            "required": true,
            "in": "path",
            "description": "The unique ID used to identify your customer and their data on FinchXP. This must be defined by you.",
            "example": "U0001"
          }
        ],
        "responses": {
          "200": {
            "description": "Data Intelligence and information provided in your response will vary\n      depending on your productType and specific plan.",
            "schema": {
              "$ref": "#/definitions/ProcessedTransactionsResponse"
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "tags": [
          "Connections API"
        ],
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ]
      }
    },
