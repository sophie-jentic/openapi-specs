          "type": "string",
          "description": "The original date of the transaction as provided by the bank or financial institution.",
          "example": "2020-10-01T00:00:00Z"
        },
        "amount": {
          "type": "number",
          "description": "The original amount of the transaction as provided by the bank or financial institution.",
          "example": "150.00"
        },
        "balance": {
