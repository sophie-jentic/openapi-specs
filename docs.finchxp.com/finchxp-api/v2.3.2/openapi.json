  "paths": {
    "/auth/token": {
      "post": {
        "summary": "Get access token",
        "description": "Every request you send to our API from your account requires your\n      API Key and a signed JSON Web Token (Access Token) to be granted access.\n      To create an Access Token, you need to send a request to the `/auth/token`\n      endpoint with your API Credentials i.e. your `X-API-Key` in the HTTP header,\n      with `clientId` and `clientSecret` as the parameters. If you provided the\n      correct parameters, you should get a successful response with an accessToken\n      that is valid for a limited time. The API credentials can be found in your\n      [developer console](https://console.finchxp.com).",
        "operationId": "getAuthToken",
        "parameters": [
          {
            "name": "AuthTokenAuthRequest",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/AuthTokenAuthRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get the Access token from the response and enter it into the HTTP `Authorization` header as a `bearer <token>.`",
            "schema": {
              "$ref": "#/definitions/JwtTokenResponse"
            }
          }
        },
        "tags": [
          "Authentication"
        ],
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "security": [
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
    "/api/finchxp/transactions/user/{externalUserId}": {
      "post": {
        "summary": "Process transactions by user",
        "description": "This endpoint is for testing and for customers in production requiring\n      advanced data intelligence in real-time e.g. on-demand lending, personal\n      finance alerts/notifications, and more.",
        "operationId": "processTransactions",
        "parameters": [
          {
            "name": "ProcessTransactionsContainer",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/ProcessTransactionsContainer"
            }
          },
          {
            "type": "string",
            "name": "externalUserId",
            "required": true,
            "in": "path",
            "description": "The unique ID used to identify your customer and their data on FinchXP. This must be defined by you.",
            "example": "U0001"
          }
        ],
        "responses": {
          "200": {
            "description": "Data Intelligence and information provided in your response will\n      vary depending on your productType and specific plan.",
            "schema": {
              "$ref": "#/definitions/ProcessedTransactionsResponse"
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "tags": [
          "Real Time Service"
        ],
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ]
      }
    },
