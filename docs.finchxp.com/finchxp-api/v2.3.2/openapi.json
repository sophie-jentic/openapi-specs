          "description": "The id of the account the transaction belongs to, defined by Basiq.",
          "example": "A001"
        },
        "institution": {
          "type": "string",
          "description": "The id of the institution resource the account originated from, defined by Basiq.",
          "example": "AU1000"
        },
        "connection": {
