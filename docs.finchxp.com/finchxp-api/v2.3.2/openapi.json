  "definitions": {
    "AuthTokenAuthRequest": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string"
        }
      },
      "required": [
        "clientId",
        "clientSecret"
      ]
    },
    "JwtTokenResponse": {
      "type": "object",
      "properties": {}
    },
    "AccountEntity": {
      "type": "object",
      "properties": {
        "accountType": {
          "type": "string",
          "description": "The type of financial account as defined by the bank or financial institution, e.g. checking, savings, loan etc.",
          "example": "Savings"
        },
        "providerId": {
          "type": "string",
          "description": "The bank or financial institution where this data is from i.e. where your customer holds an account. See GET `/api/providers` for a list of providers and their providerIDs.",
          "example": "CTBA"
        },
        "accountStatus": {
          "type": "string",
          "description": "The status of the account",
          "example": "CTBA"
        },
        "currentBalance": {
          "type": "number",
          "description": "The balance in an account, pre-holds or pending transactions. Max length is 14,2. If the value is empty, null will be returned."
        },
        "availableBalance": {
          "type": "number",
          "description": "The available balance in an account, pre-holds or pending transactions. Max length is 14,2. If the value is empty, null will be returned."
        },
        "externalAccountId": {
          "type": "string",
          "description": "The account number of your customer. This can be defined by you or you can pass through the account number provided by the bank or financial institution.",
          "example": "123823834"
        },
        "accountName": {
          "type": "string",
          "description": "The account name as it appears at the site.",
          "example": "Name"
        }
      },
      "required": [
        "accountType",
        "providerId",
        "currentBalance",
        "availableBalance",
        "externalAccountId"
      ]
    },
    "ProcessTransactionEntity": {
      "type": "object",
      "properties": {
        "externalAccountId": {
          "type": "string",
          "description": "The account number of your customer. This can be defined by you or you can pass through the account number provided by the bank or financial institution.",
          "example": "A001"
        },
        "externalTransactionId": {
          "type": "string",
          "description": "The unique transaction number of your customer. This can be defined by you or you can pass through the transaction number provided by the bank or financial institution.",
          "example": "T001"
        },
        "externalUserId": {
          "type": "string",
          "description": "The unique ID used to identify your customer and their data on FinchXP. This must be defined by you.",
          "example": "U001"
        },
        "description": {
          "type": "string",
          "description": "The original description of the transaction as provided by the bank or financial institution i.e. as it appears in the original bank statement or raw transaction description.",
          "example": "FRESH AND FAIR PTY L NEWPORT NS AUS Tap and Pay xx1234 Value Date_ 01/10/2020"
        },
        "postDate": {
          "type": "string",
          "description": "The posted date of the transaction as provided by the bank or financial institution. Dates and times must always be given in ISO 8601 format.",
          "format": "date-time",
          "example": "2020-10-03"
        },
        "date": {
          "type": "string",
          "description": "The original date of the transaction as provided by the bank or financial institution. Dates and times must always be given in ISO 8601 format.",
          "format": "date-time",
          "example": "2020-10-01"
        },
        "amount": {
          "type": "number",
          "description": "The original amount of the transaction as provided by the bank or financial institution.",
          "example": "150.00"
        },
        "currency": {
          "type": "string",
          "description": "The currency of the transaction as provided by the bank or financial institution, default AUD.",
          "example": "AUD"
        },
        "status": {
          "type": "string",
          "description": "The status of the transaction can be POSTED or PENDING.",
          "enum": [
            "POSTED",
            "PENDING"
          ],
          "example": "POSTED"
        },
        "type": {
          "type": "string",
          "description": "The type of transaction in or out of an account i.e. CREDIT is money in to an account (income) whereas DEBIT is money out of an account (expense).",
          "enum": [
            "CREDIT",
            "DEBIT"
          ],
          "example": "DEBIT"
        },
        "externalCategory": {
          "type": "string"
        },
        "externalCategoryCode": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "The source of the transaction, this is usually your data aggregator",
          "enum": [
            "YODLEE",
            "BASIQ",
            "AS2805",
            "CDR"
          ],
          "example": "BASIQ"
        }
      },
      "required": [
        "externalAccountId",
        "externalTransactionId",
        "externalUserId",
        "description",
        "postDate",
        "date",
        "amount",
        "currency",
        "status",
        "type",
        "externalCategory",
        "externalCategoryCode"
      ]
    },
    "ProcessTransactionsContainer": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "array",
          "description": "List of accounts",
          "items": {
            "$ref": "#/definitions/AccountEntity"
          }
        },
        "transactions": {
          "type": "array",
          "description": "List of transactions to process",
          "items": {
            "$ref": "#/definitions/ProcessTransactionEntity"
          }
        },
        "productType": {
          "type": "string",
          "enum": [
            "LENDING",
            "PERSONAL_FINANCE",
            "LOYALTY"
          ],
          "example": "LENDING"
        }
      },
      "required": [
        "accounts",
        "transactions",
        "productType"
      ]
    },
    "MerchantLocation": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "example": "19 Robertson Road"
        },
        "suburb": {
          "type": "string",
          "example": "Newport"
        },
        "state": {
          "type": "string",
          "example": "NSW"
        },
        "postcode": {
          "type": "string",
          "example": "2106"
        }
      },
      "required": [
        "address",
        "suburb",
        "state",
        "postcode"
      ]
    },
    "Category": {
      "type": "object",
      "properties": {
        "parentCategory": {
          "type": "string",
          "example": "Food & Drink"
