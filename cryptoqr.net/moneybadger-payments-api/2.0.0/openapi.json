  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "title": "ErrorResponse is an error response.",
      "required": [
        "code",
        "error"
      ],
      "properties": {
        "code": {
          "description": "The code representing the error.",
          "type": "string",
          "enum": [
            "ErrUnknown",
            "ErrNotFound",
            "ErrForbidden",
            "ErrAuthentication",
            "ErrProcessing",
            "ErrInternal",
            "ErrInsufficientFunds",
            "ErrInvalidInvoiceState",
            "ErrRefundDeclined",
            "ErrRefundBelowMinAmount",
            "ErrRefundInvalidRecipient"
          ],
          "example": "ErrUnknown"
        },
        "detail": {
          "description": "Optional extra information about this error.",
          "type": "string"
        },
        "error": {
          "description": "The error message.",
          "type": "string"
        }
      }
    },
    "Invoice": {
      "type": "object",
      "properties": {
        "amount_cents": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "expires_at": {
          "description": "when this invoice will expire (UTC Time)",
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string"
        },
        "merchant_code": {
          "type": "string"
        },
        "merchant_name": {
          "type": "string"
        },
        "order_description": {
          "type": "string"
        },
        "order_id": {
          "description": "Merchant's order ID",
          "type": "string"
        },
        "paid_at": {
          "description": "when this invoice was paid (UTC Time)",
          "type": "string",
          "format": "date-time"
        },
        "payment_link": {
          "type": "string"
        },
        "payment_request": {
          "$ref": "#/definitions/PaymentRequest"
        },
        "redirect_url": {
          "description": "URL that MoneyBadger will redirect to after payment",
          "type": "string"
        },
        "refunds": {
          "description": "Array of all associated refunds for this invoice",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Refund"
          }
        },
        "status": {
          "description": "Invoice Status",
          "type": "string",
          "enum": [
            "REQUESTED",
            "AUTHORIZED",
            "CONFIRMED",
            "TIMED_OUT",
            "CANCELLED",
            "ERROR"
          ]
        },
        "status_webhook_url": {
          "type": "string"
        },
        "sub_merchant": {
          "description": "Sub Merchant information",
          "$ref": "#/definitions/SubMerchant"
        }
      }
    },
    "InvoiceRequest": {
      "type": "object",
      "required": [
        "amount_cents"
      ],
      "properties": {
        "allowed_payment_methods": {
          "description": "Optional/Advanced usage: Allowed payment methods, in preferred order",
          "type": "array",
          "items": {
            "type": "string",
            "example": "lightning"
          }
        },
        "amount_cents": {
          "type": "integer",
          "format": "int64"
        },
        "amount_sats": {
          "description": "Amount in sats. This is needed for LNURL payments, when an exact sats amount is required.",
          "type": "integer",
          "format": "int64"
        },
        "auto_confirm": {
          "description": "Automatically confirm the invoice when paid",
          "type": "boolean",
          "example": false
        },
        "currency": {
          "description": "Invoice currency code. If none specified, merchant default is used, otherwise 'ZAR'",
          "type": "string",
          "example": "ZAR"
        },
        "device_id": {
          "type": "string"
        },
        "order_description": {
          "type": "string"
        },
        "order_id": {
          "type": "string"
        },
        "payment_currencies": {
          "description": "Optional/Advanced usage: Allowed payment currencies, in order of preference. If none specified, merchant default and/or value store default is used, otherwise 'BTC'. NB: Not all value stores support multiple currencies.",
          "type": "array",
          "items": {
            "type": "string",
            "example": "BTC"
          }
        },
        "redirect_url": {
          "description": "URL to redirect to after payment",
          "type": "string"
        },
        "refund_recipient": {
          "description": "Recipient to refund to (optional, dependent on payment method)",
          "$ref": "#/definitions/RefundRecipient"
        },
        "scan_id": {
          "type": "string"
        },
        "status_webhook_url": {
          "type": "string"
        },
        "sub_merchant": {
          "description": "Sub Merchant information",
          "$ref": "#/definitions/SubMerchant"
        },
        "timeout_in_seconds": {
          "type": "integer"
        },
        "transaction_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      }
    },
    "InvoiceStatusUpdate": {
      "type": "object",
      "properties": {
        "invoice": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/Invoice/properties/id"
            },
            "order_id": {
              "$ref": "#/definitions/Invoice/properties/order_id"
            }
          }
        }
      }
    },
    "InvoiceUpdatePaymentMethod": {
      "type": "object",
      "properties": {
        "payment_currencies": {
          "description": "Allowed payment currencies, in order of preference. If none specified, merchant default and/or value store default is used, otherwise 'BTC'. NB: Not all value stores support multiple currencies.",
          "type": "array",
          "items": {
            "type": "string",
            "example": "BTC"
          }
        },
        "payment_method": {
          "description": "Payment method to use for invoice",
          "type": "string",
          "example": "lightning"
        },
        "refund_recipient": {
          "description": "Recipient to refund to (optional, dependent on payment method)",
          "$ref": "#/definitions/RefundRecipient"
        },
        "transaction_id": {
          "description": "Transaction ID for payment method",
          "type": "string"
        }
      }
    },
    "Merchant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "PaymentRequest": {
      "description": "Payment request details. This is what needs to be provided to the user to make payment",
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "example": 100.00007
        },
        "currency": {
          "type": "string",
          "example": "BTC"
        },
        "data": {
          "description": "encoded data for use by app/value store. e.g. lightning invoice, deeplink, etc.",
          "type": "string"
        },
        "deeplink": {
          "description": "deeplink for app to open and complete payment",
          "type": "string"
        },
        "denomination": {
          "type": "string",
          "example": "sats"
        },
        "exchange_rate": {
          "description": "Conversion rate from fiat to crypto",
          "type": "number",
          "format": "double",
          "example": 0.05
        },
        "expires_at": {
          "description": "when this payment will expire (UTC Time). May differ from the Invoice (e.g. for lightning)",
          "type": "string",
          "format": "date-time"
        },
        "over_payment": {
          "description": "Overpayment amount in fiat currency of invoice",
          "type": "number",
          "example": 0.01
        },
        "payment_methods": {
          "description": "list of payment method types with payment instruction data the client can use to complete payment",
          "type": "object",
          "additionalProperties": {
            "type": "object"
          },
          "example": {
            "luno|XBT": "currency=xbt&amount=0.013"
          }
        },
        "qr_code_content": {
          "description": "QR code content (string, usually a URL or encoded data)",
