          "application/json"
        ],
        "tags": [
          "invoice"
        ],
        "summary": "Find invoice by ID or merchant order ID",
        "operationId": "getInvoice",
        "parameters": [
          {
            "type": "string",
            "description": "ID of invoice or merchant order ID or lightning invoice",
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "enum": [
              "ID",
              "ORDER_ID",
              "LIGHTNING_INVOICE"
            ],
            "type": "string",
            "description": "Retrieve invoice by (id or orderId)",
            "name": "by",
            "in": "query"
          },
          {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "description": "wait the specified number of seconds until invoice state changes ( max 10 seconds. The current invoice record will be returned once the 'wait' timeout has expired. ).",
            "name": "wait",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "$ref": "#/definitions/Invoice"
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "Invoice not found"
          }
        }
      }
    },
