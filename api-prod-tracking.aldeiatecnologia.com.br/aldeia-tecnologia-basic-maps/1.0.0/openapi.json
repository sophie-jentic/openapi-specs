    "/auth/login": {
      "parameters": [],
      "post": {
        "summary": "Obter um token de acesso",
        "tags": [
          "Autoriza\u00e7\u00f5es"
        ],
        "responses": {
          "200": {
            "description": "Default",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-examples": {
                    "Example 1": {
                      "data": {
                        "access_token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..Fn_tl5uNr6PDRuh7jZxyhHbCQ9sD07KyJZwPMlPTcC0",
                        "token_type": "bearer",
                        "user": "cb7c5819-e488-43ef-9946-7e8c726a74d0",
                        "blocked": false
                      }
                    }
                  },
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "access_token": {
                          "type": "string",
                          "description": "Token de acesso para ser utilizado nas outras chamadas",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9. eyJzdWIiOiJ1c2VyX2V4ZW1wbG8iLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MTgwMDAwMDAwMH0. Qx4kPZs8JpN2uL9A7VxR5C3WkM0Hf8TtE6DqYbS2cFQ"
                        },
                        "token_type": {
                          "type": "string",
                          "description": "Sempre: bearer",
                          "example": "bearer"
                        },
                        "user": {
                          "type": "string",
                          "description": "Seu ID de usu\u00e1rio",
                          "example": "xxxxx-xxx-xxxxx-xxxx-xxx"
                        },
                        "blocked": {
                          "type": "boolean",
                          "description": "True/False - Informa se est\u00e1 bloqueado ou n\u00e3o"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "/{id}",
        "description": "Obt\u00e9m os dados de um rastreador informando o seu ID",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "application/json"
            },
            "in": "header",
            "name": "Content-Type",
            "required": true
          }
        ],
        "requestBody": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "string",
                    "x-stoplight": {
                      "id": "k65rqi72ro3v5"
                    },
                    "description": "Seu usu\u00e1rio de acesso",
                    "example": "joao@aldeiatecnologia.com.br"
                  },
                  "password": {
                    "type": "string",
                    "x-stoplight": {
                      "id": "gog1ui8vzp8ei"
                    },
                    "example": "xx@xx.com.br"
                  }
                }
              }
            }
          }
        }
      }
    },
