    "/v1/assigned-planners/search": {
      "get": {
        "tags": [
          "wirecenter-assigned-planners"
        ],
        "summary": "Search wirecenter assigned planners",
        "description": "Search wirecenter assigned planners based on the filtering parameters (at least 1 required)",
        "operationId": "searchWirecenters",
        "parameters": [
          {
            "name": "maxCount",
            "in": "query",
            "description": "Max limit of search results to be returned",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 10
          },
          {
            "name": "wcClli",
            "in": "query",
            "description": "CLLI of the Wirecenter - use % to match like",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "P%25"
          },
          {
            "name": "wcName",
            "in": "query",
            "description": "Name of the Wirecenter - use % to match like",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "%25City"
          },
          {
            "name": "priCuid",
            "in": "query",
            "description": "CUID of the Primary Planner - use % to match like",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "AD15329"
          },
          {
            "name": "secCuid",
            "in": "query",
            "description": "CUID of the Secondary Planner - use % to match like",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "AD15329"
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    }
