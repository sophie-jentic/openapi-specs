          "managerName",
          "managerPipefyId",
          "primaryPlannerCuid",
          "primaryPlannerEmail",
          "primaryPlannerName",
          "primaryPlannerPipefyId",
          "secondaryPlannerEmail",
          "secondaryPlannerName",
          "secondaryPlannerPipefyId",
          "wcClli"
        ],
        "type": "object",
        "properties": {
          "createdBy": {
            "type": "string",
            "description": "Created-by in the format of username@system",
            "example": "admin-01@admin"
          },
          "createTimestamp": {
            "type": "string",
            "description": "Create timestamp",
            "format": "date-time"
          },
          "updatedBy": {
            "type": "string",
            "description": "Updated-by in the format of username@system",
