            "format": "int64",
            "example": 1234
          },
          "region": {
            "type": "string",
            "description": "Region of the Wirecenter location - possible values are N, S, Z",
            "example": "S"
          },
          "stateCode": {
            "type": "string",
            "description": "State code of the Wirecenter location - 2 character state code",
            "example": "CO"
          },
          "wcClli": {
            "type": "string",
            "description": "CLLI code identifying the the Wirecenter",
            "example": "MNSSCOXC"
          },
          "wcName": {
            "type": "string",
            "description": "Name of the Wirecenter",
            "example": "Manassa"
          },
          "wcAddress": {
            "type": "string",
            "description": "Address of the Wirecenter location",
            "example": "405 MAIN ST, MANASSA, CO 81151"
          },
          "wcCounty": {
            "type": "string",
            "description": "County name of the Wirecenter location",
            "example": "Conejos"
          },
          "mtnCo": {
            "type": "string",
            "description": "MTN Code of the Wirecenter",
            "example": "MNSSCO"
          },
          "niTeam": {
            "type": "string",
            "description": "NI Team associated with this Wirecenter",
            "example": "LWMT01"
          },
          "primaryPlannerCuid": {
            "type": "string",
            "description": "Primary planner CUID assigned to this Wirecenter",
            "example": "AB13716"
          },
          "primaryPlannerName": {
            "type": "string",
            "description": "Primary planner name",
            "example": "John Doe"
          },
          "primaryPlannerEmail": {
            "type": "string",
            "description": "Primary planner email address",
            "example": "john.doe@lumen.com"
          },
          "primaryPlannerPipefyId": {
            "type": "string",
            "description": "Primary planner Pipefy ID",
            "example": "AB13716"
          },
          "secondaryPlannerCuid": {
            "type": "string",
            "description": "Secondary planner CUID assigned to this Wirecenter",
            "example": "TBD"
          },
          "secondaryPlannerName": {
            "type": "string",
            "description": "Secondary planner name",
            "example": "John Doe"
          },
          "secondaryPlannerEmail": {
            "type": "string",
            "description": "Secondary planner email address",
            "example": "john.doe@lumen.com"
          },
          "secondaryPlannerPipefyId": {
            "type": "string",
            "description": "Secondary planner Pipefy ID",
            "example": "AB13716"
          },
          "managerCuid": {
            "type": "string",
            "description": "Manager CUID",
            "example": "AB13716"
          },
          "managerName": {
            "type": "string",
            "description": "Manager name",
            "example": "John Doe"
          },
          "managerEmail": {
            "type": "string",
            "description": "Manager email address",
            "example": "john.doe@lumen.com"
          },
          "managerPipefyId": {
            "type": "string",
            "description": "Manager Pipefy ID",
            "example": "AB13716"
          },
          "routeTo": {
            "type": "string",
            "description": "Route this assignment to PRIMARY or SECONDARY",
            "example": "PRIMARY"
          },
          "routeToStartDate": {
            "type": "string",
            "format": "date",
            "description": "Route start date",
            "example": "2024-04-05"
          },
          "routeToEndDate": {
            "type": "string",
            "format": "date",
            "description": "Route end date",
            "example": "2024-04-15"
          }
