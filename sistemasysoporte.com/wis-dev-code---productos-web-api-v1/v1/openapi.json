    "version": "v1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/wisdevcode/wis-dev-code-productos-web-api-v1/v1"
  },
  "paths": {
    "/api/v1/Existencias": {
      "get": {
        "tags": [
          "Existencias"
        ],
        "summary": "Obtiene existencias de Aspel SAE con paginaci\u00f3n.",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "numeroPagina",
            "description": "",
            "type": "integer",
            "format": "int32",
            "default": 1
          },
          {
            "in": "query",
            "name": "salto",
            "description": "",
            "type": "integer",
            "format": "int32",
            "default": 20
          }
        ],
        "responses": {
          "200": {
            "description": "Devuelve una lista paginada de existencias.",
            "schema": {
              "$ref": "#/definitions/ProductosPagedResult"
            }
          },
          "401": {
            "description": "No autorizado.",
            "schema": {
              "$ref": "#/definitions/UnauthorizedResponse"
            }
          },
          "404": {
            "description": "No se encontraron existencias.",
            "schema": {
              "$ref": "#/definitions/NotFoundResponse"
            }
          },
          "500": {
            "description": "Error interno del servidor.",
            "schema": {
              "$ref": "#/definitions/InternalServerErrorResponse"
            }
          }
        }
      }
    },
    "/api/v1/Token": {
      "post": {
        "tags": [
          "Token"
        ],
        "summary": "Genera un JWT v\u00e1lido para un cliente autenticado. El cliente debe proporcionar sus credenciales (nombre y contrase\u00f1a) en el cuerpo de la solicitud. Si las credenciales son v\u00e1lidas, se devuelve un token JWT que puede ser utilizado para acceder a recursos protegidos en la API. Si las credenciales son inv\u00e1lidas, se devuelve un mensaje de error indicando que la autenticaci\u00f3n ha fallado.",
        "consumes": [
          "application/json",
          "text/json",
          "application/*+json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "schema": {
              "$ref": "#/definitions/Cliente"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token JWT generado exitosamente",
            "schema": {
              "$ref": "#/definitions/TokenResponse"
            }
          },
          "401": {
            "description": "Credenciales inv\u00e1lidas",
            "schema": {
              "$ref": "#/definitions/UnauthorizedResponse"
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "schema": {
              "$ref": "#/definitions/InternalServerErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Cliente": {
      "type": "object",
      "properties": {
        "nombre": {
          "type": "string"
        },
        "contrase\u00f1a": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "InternalServerErrorResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "NotFoundResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Productos": {
      "type": "object",
      "properties": {
        "codigo": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "existencia": {
          "format": "double",
          "type": "number"
        },
        "precioPublico": {
          "format": "double",
          "type": "number"
        },
        "idAlmacen": {
          "format": "int32",
          "type": "integer"
        },
        "nombreAlmacen": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ProductosPagedResult": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Productos"
          }
        },
        "pageNumber": {
          "format": "int32",
          "type": "integer"
        },
        "pageSize": {
          "format": "int32",
          "type": "integer"
        },
        "totalItems": {
          "format": "int64",
          "type": "integer"
        },
        "totalPages": {
          "format": "int32",
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "TokenResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "UnauthorizedResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT Authorization header using the Bearer scheme (Example: 'Bearer 12345abcdef')"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ]
}