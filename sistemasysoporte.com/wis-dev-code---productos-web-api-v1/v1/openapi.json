{
  "swagger": "2.0",
  "info": {
    "title": "WIS Dev Code - Productos Web API V1",
    "description": "Productos Web API V1",
    "contact": {
      "name": "Walter Medina | David Sam",
      "url": "https://www.sistemasysoporte.com",
      "email": "wmedina@wisdevcode.com;dsam@sistemasysoporte.com"
