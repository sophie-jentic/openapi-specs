  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API token obtained from the nCino Mortgage Admin Portal under Company Settings > API Management"
      }
    },
    "schemas": {
      "LoanList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Loan"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "Loan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique loan identifier"
          },
          "loan_number": {
            "type": "string",
            "description": "Human-readable loan number"
          },
          "status": {
            "type": "string",
            "description": "Current loan status"
          },
          "loan_type": {
            "type": "string",
            "description": "Type of loan (e.g., purchase, refinance)"
          },
          "loan_amount": {
            "type": "number",
            "format": "double",
            "description": "Loan amount in dollars"
          },
          "interest_rate": {
            "type": "number",
            "format": "double",
            "description": "Interest rate percentage"
          },
          "property_address": {
            "$ref": "#/components/schemas/Address"
          },
          "borrower": {
            "$ref": "#/components/schemas/Borrower"
          },
          "loan_officer_id": {
            "type": "string",
            "description": "Assigned loan officer user ID"
          },
          "organization_id": {
            "type": "string",
            "description": "Associated organization/branch ID"
          },
          "closing_date": {
            "type": "string",
            "format": "date",
            "description": "Expected closing date"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp"
          }
        }
      },
      "LoanRequest": {
        "type": "object",
        "required": ["loan_type", "borrower"],
        "properties": {
          "loan_number": {
            "type": "string",
            "description": "Loan number"
          },
          "status": {
            "type": "string",
            "description": "Loan status"
          },
          "loan_type": {
            "type": "string",
            "description": "Type of loan"
          },
          "loan_amount": {
            "type": "number",
            "format": "double",
            "description": "Loan amount"
          },
          "interest_rate": {
            "type": "number",
            "format": "double"
