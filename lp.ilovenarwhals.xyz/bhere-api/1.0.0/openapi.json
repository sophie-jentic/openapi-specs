  "definitions": {
    "LoginRequest": {
      "type": "object",
      "required": [
        "login",
        "password"
      ],
      "properties": {
        "login": {
          "type": "string",
          "example": "jake.tattersall@ucf.edu"
        },
        "password": {
          "type": "string",
          "example": 12345678
        }
      }
    },
    "ValidResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": ""
        }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 12345
        },
        "firstName": {
          "type": "string",
          "example": "First"
        },
        "lastName": {
          "type": "string",
          "example": "Last"
        },
        "error": {
          "type": "string",
          "example": ""
        },
        "role": {
          "type": "string",
          "example": "student"
        },
        "token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        }
      }
    },
    "RegisterRequest": {
      "type": "object",
      "required": [
        "email",
        "password",
        "firstName",
        "lastName",
        "id",
        "role"
      ],
      "properties": {
        "email": {
          "type": "string",
          "example": "user2@example.com"
        },
        "password": {
          "type": "string",
          "example": "Password123"
        },
        "firstName": {
          "type": "string",
          "example": "First"
        },
        "lastName": {
          "type": "string",
          "example": "Last"
        },
        "id": {
          "type": "integer",
          "example": 12345
        },
        "role": {
          "type": "string",
          "example": "student"
        }
      }
    },
    "RegisterResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": ""
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "Invalid fields"
        }
      }
    },
    "SendEmailCodeRequest": {
      "type": "object",
      "required": [
        "email",
        "templateChoice"
      ],
      "properties": {
        "email": {
          "type": "string",
          "example": "postman@email.com"
        },
        "templateChoice": {
          "type": "string",
          "example": "registration"
        }
      }
    },
    "VerifyEmailCodeRequest": {
      "type": "object",
      "required": [
        "email",
        "verificationCode"
      ],
      "properties": {
        "email": {
          "type": "string",
          "example": "postman@email.com"
        },
        "verificationCode": {
          "type": "string",
          "example": "123456"
        }
      }
    },
    "ChangePasswordRequest": {
      "type": "object",
      "required": [
        "email",
        "newPassword"
      ],
      "properties": {
        "email": {
          "type": "string",
          "example": "postman@email.com"
        },
        "newPassword": {
          "type": "string",
          "example": "NewSecretPass123"
        }
      }
    },
    "FindExistingUserRequest": {
      "type": "object",
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "example": "postman@email.com"
        }
      }
    },
    "CreateClassRequest": {
      "type": "object",
      "required": [
        "name",
        "duration",
        "instructorId",
        "section",
        "daysOffered",
        "startTime",
        "endTime",
        "classCode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "Intro to Testing"
        },
        "duration": {
          "type": "integer",
          "example": 60
        },
        "instructorId": {
          "type": "integer",
          "example": 10001
        },
        "section": {
          "type": "string",
          "example": "A"
        },
        "daysOffered": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "Monday",
            "Wednesday"
          ]
        },
        "startTime": {
          "type": "string",
          "example": "09:00"
        },
        "endTime": {
          "type": "string",
          "example": "10:00"
        },
        "classCode": {
          "type": "string",
          "example": "TEST101"
        }
      }
    },
    "CreateClassResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": ""
        },
        "classId": {
          "type": "string",
          "example": "64a1f0b5e4b0a1b2c3d4e5f6"
        }
      }
    },
    "FetchClassesRequest": {
      "type": "object",
      "required": [
        "userId"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 10001
        }
      }
    },
    "ClassSummary": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "example": "64a1f0b5e4b0a1b2c3d4e5f6"
        },
        "name": {
          "type": "string",
          "example": "Intro to Testing"
        },
        "classCode": {
          "type": "string",
          "example": "TEST101"
        },
        "section": {
          "type": "string",
          "example": "A"
        },
        "instructorName": {
          "type": "string",
          "example": "John Doe"
        },
        "startTime": {
          "type": "string",
          "example": "09:00"
        },
        "endTime": {
          "type": "string",
          "example": "10:00"
        },
        "duration": {
          "type": "integer",
          "example": 60
        }
      }
    },
    "FetchClassesResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": ""
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ClassSummary"
          }
        }
      }
    },
    "JoinClassRequest": {
      "type": "object",
      "required": [
        "userId",
        "classCode",
        "section"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 10002
        },
        "classCode": {
          "type": "string",
          "example": "TEST101"
        },
        "section": {
          "type": "string",
          "example": "A"
        }
      }
    },
    "LeaveClassRequest": {
      "type": "object",
      "required": [
        "userId",
        "classId"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 10002
        },
        "classId": {
          "type": "string",
          "example": "64a1f0b5e4b0a1b2c3d4e5f6"
        }
      }
    },
    "DeleteClassRequest": {
      "type": "object",
      "required": [
        "userId",
        "classId"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 10001
        },
        "classId": {
          "type": "string",
          "example": "64a1f0b5e4b0a1b2c3d4e5f6"
        }
      }
    },
    "AttendanceActionRequest": {
      "type": "object",
      "required": [
        "userId",
        "objectId"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 10001
        },
        "objectId": {
          "type": "string",
          "example": "64a1f0b5e4b0a1b2c3d4e5f6"
        }
      }
    },
    "NewSecretRequest": {
      "type": "object",
