  "paths": {
    "/auth/send-otp": {
      "post": {
        "summary": "send otp",
        "description": "send otp",
        "operationId": "sendOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mobile": {
                    "type": "string",
                    "example": "917992285806"
                  },
                  "purpose": {
                    "type": "string",
                    "example": "vendor_login"
                  },
                  "role": {
                    "type": "string",
                    "example": "vendor"
                  }
                }
              },
              "examples": {
                "send otp": {
                  "value": {
                    "mobile": "917992285806",
                    "purpose": "vendor_login",
                    "role": "vendor"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/auth/verify-otp": {
      "post": {
        "summary": "verify otp",
        "description": "verify otp",
        "operationId": "verifyOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mobile": {
                    "type": "string",
                    "example": "917992285806"
                  },
                  "otp": {
                    "type": "string",
                    "example": "881751"
                  },
                  "purpose": {
                    "type": "string",
                    "example": "vendor_login"
                  }
                }
              },
              "examples": {
                "verify otp": {
                  "value": {
                    "mobile": "917992285806",
                    "otp": "881751",
                    "purpose": "vendor_login"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/auth/refresh-access-token": {
      "post": {
        "summary": "refresh token",
        "description": "refresh token",
        "operationId": "refreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "refresh token": {
                  "value": ""
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    }
  },
