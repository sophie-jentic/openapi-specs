    "title": "Juniper ATP Cloud API",
    "description": "Juniper Advanced Threat Prevention (ATP) Cloud API for malware analysis, threat intelligence, and security policy management. Provides endpoints for submitting files for malware scanning, looking up threat scores by hash, managing blocklists and allowlists (IP, URL, domain), retrieving infected host data, and accessing STIX threat intelligence data.",
    "version": "2.0.0",
    "x-jentic-source-url": "https://www.juniper.net/documentation/us/en/software/atp-cloud/atp-cloud-api-setup/topics/concept/atp-cloud-api-overview.html"
  },
  "servers": [
    {
      "url": "https://api.sky.junipersecurity.net/v2/skyatp",
      "description": "Juniper ATP Cloud API - US Region"
    },
    {
      "url": "https://api-eu.sky.junipersecurity.net/v2/skyatp",
      "description": "Juniper ATP Cloud API - EU Region"
    },
    {
      "url": "https://api-apac.sky.junipersecurity.net/v2/skyatp",
      "description": "Juniper ATP Cloud API - APAC Region"
    },
    {
      "url": "https://api-canada.sky.junipersecurity.net/v2/skyatp",
      "description": "Juniper ATP Cloud API - Canada Region"
    }
  ],
