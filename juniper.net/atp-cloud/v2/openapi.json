    "/ping": {
      "get": {
        "operationId": "pingApi",
        "summary": "Check API availability",
        "description": "Determine if the ATP Cloud API is available and responding. Does not require authentication.",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "API is available"
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
