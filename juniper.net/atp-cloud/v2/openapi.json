  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token generated via Juniper ATP Cloud Web UI (Administration > Application Tokens). Maximum 10 tokens per user, valid for one year."
      }
    },
    "schemas": {
      "ScanResult": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "minimum": -1,
            "maximum": 10,
            "description": "Malware score from -1 (unknown) to 10 (highly malicious)"
          },
          "scan_complete": {
            "type": "boolean",
            "description": "Whether the scan has completed"
          },
          "sha256": {
            "type": "string",
            "description": "SHA256 hash of the analyzed file"
          },
          "last_update": {
            "type": "integer",
            "description": "Timestamp of last scan update"
          },
          "threat_level": {
            "type": "string",
            "enum": ["high", "medium", "low", "clean"],
            "description": "Overall threat level classification"
          },
          "category": {
            "type": "string",
            "description": "Malware category classification"
          },
          "size": {
            "type": "integer",
            "description": "File size in bytes"
          },
          "malware_info": {
            "type": "object",
            "description": "Detailed malware classification information",
            "properties": {
              "ident": {
                "type": "string",
                "description": "Malware identification string"
              },
              "family": {
                "type": "string",
                "description": "Malware family name"
              },
              "mw_type": {
                "type": "string",
                "description": "Malware type (e.g., trojan, worm, ransomware)"
              },
              "platform": {
                "type": "string",
                "description": "Target platform"
              },
              "group": {
                "type": "string",
                "description": "Malware group"
              },
              "lang": {
                "type": "string",
                "description": "Programming language"
              },
              "cmplr": {
                "type": "string",
                "description": "Compiler information"
              }
            }
          },
          "scan_report": {
            "type": "object",
            "description": "Detailed scan report with behavioral analysis",
            "properties": {
              "behaviors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "behavior": {
                      "type": "string",
                      "description": "Description of observed malicious behavior"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "StixResult": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 3,
            "description": "STIX formatted threat intelligence data in XML"
          }
        }
      },
      "InfectedHostsResult": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "description": "Number of entries in the list"
              },
              "ip": {
                "type": "object",
                "additionalProperties": true,
                "description": "Map of IP addresses and their details"
              }
            }
          },
          "request_id": {
            "type": "string",
            "description": "Unique request identifier for tracking"
          }
        }
      },
      "InfectedHostsUpdateRequest": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of IP addresses to add or remove"
          }
        },
        "required": ["ip"]
      },
      "BlocklistResult": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "description": "Number of entries in the list"
              },
              "servers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Array of server entries (IPs, URLs, or domains)"
              }
            }
          },
          "request_id": {
            "type": "string",
            "description": "Unique request identifier"
          }
        }
      },
      "RequestIdResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Unique identifier to track the asynchronous operation"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "err_id": {
            "type": "string",
            "description": "Machine-readable error identifier"
          },
          "details": {
            "type": "string",
            "description": "Additional error details"
          }
        }
      }
    }
  }
}