            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/submit/sample": {
      "post": {
        "operationId": "submitSampleForAnalysis",
        "summary": "Submit a file for malware analysis",
        "description": "Submit a file sample for malware analysis. The file is scanned and analyzed for malicious behavior. Optionally provide metadata about the source of the file.",
        "tags": ["Sample Submission"],
        "parameters": [
          {
            "name": "full_report",
            "in": "query",
            "required": false,
            "description": "Request a full detailed report",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "X-Forwarded-For",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to submit for analysis"
                  },
                  "sample_url": {
                    "type": "string",
                    "description": "URL from which the sample was obtained"
                  },
                  "remote_ip": {
                    "type": "string",
                    "description": "Source IP address (IPv4 or IPv6) where the file originated"
                  },
                  "client_ip": {
                    "type": "string",
                    "description": "Client IP address (IPv4 or IPv6) that downloaded the file"
                  },
                  "client_hostname": {
                    "type": "string",
                    "description": "Fully qualified domain name of the client"
                  },
                  "username": {
                    "type": "string",
                    "description": "Username associated with the file download"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sample submitted and scan result returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Semantic validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
