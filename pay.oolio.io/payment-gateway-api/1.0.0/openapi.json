          },
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "description": "A JSON object containing adjustment body",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/adjustmentBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/transactionReply"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request problem reading or understanding the request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "The transaction cannot be adjusted",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internet sever error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{merchantId}/{id}/capture": {
      "post": {
        "summary": "Capture a transaction",
        "description": "Capture a transaction",
        "operationId": "capture-transaction-by-id",
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "merchantId",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "description": "A JSON object containing capture body",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "metadata": {
                    "$ref": "#/components/schemas/metadata"
                  },
                  "amount": {
                    "$ref": "#/components/schemas/amount",
                    "description": "Amount must be less than or equal to authorized amount."
                  }
                },
                "required": [
                  "amount"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/transactionReply"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request problem reading or understanding the request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "The transaction cannot be captured",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internet sever error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{merchantId}/{id}/cancel": {
      "post": {
        "summary": "Cancel a transaction",
        "description": "Cancel a transaction",
        "operationId": "cancel-transaction-by-id",
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "merchantId",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "description": "A JSON object containing cancel body",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "metadata": {
                    "$ref": "#/components/schemas/metadata"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/transactionReply"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request problem reading or understanding the request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "The transaction cannot be cancelled",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internet sever error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{merchantId}/{id}/refund": {
      "post": {
        "summary": "Refund a transaction",
        "description": "Refund a transaction",
        "operationId": "refund-transaction-by-id",
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "merchantId",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "description": "A JSON object containing refund body",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/refundBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/transactionReply"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request problem reading or understanding the request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "The transaction cannot be refunded",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internet sever error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/transactionType"
          },
          "status": {
            "$ref": "#/components/schemas/transactionStatus"
          },
          "merchantId": {
            "type": "string"
          },
          "merchantReference": {
            "type": "string"
          },
          "acquirerReference": {
            "type": "string"
          },
          "authorizedAt": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "$ref": "#/components/schemas/amount"
          },
          "baseAmount": {
            "$ref": "#/components/schemas/amount"
          },
          "salesChannel": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/transactionSource"
          },
          "extraCharges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/extraCharge"
            }
          },
          "metadata": {
            "$ref": "#/components/schemas/metadata"
          },
          "events": {
            "$ref": "#/components/schemas/events"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/transactionLink"
            }
          }
        }
      },
      "amount": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "value": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "transactionSource": {
        "type": "object",
        "properties": {
          "storeRef": {
            "type": "string"
          },
          "terminal": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "interaction": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "description": "0: Ecommerce\n1: POS\n2: Moto\n3: ContAuth\n"
          }
        }
      },
      "extraCharge": {
        "type": "object",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/amount"
          },
          "type": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "0: Surcharge\n1: Tip\n"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "transactionStatus": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "description": "0: Received\n1: Authorized\n2: Completed\n3: Settled\n4: Refunded\n5: Cancelled\n6: SentForSettle\n7: Refused\n"
      },
      "transactionType": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3
        ],
        "description": "0: Payment\n1: Refund\n2: Chargeback\n3: Cashout\n"
      },
      "events": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/transactionLifeCycle"
        }
      },
      "transactionLifeCycle": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/transactionStatus"
          },
          "timestamp": {
            "type": "integer"
          },
          "remarks": {
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/metadata"
          }
        }
      },
      "transactionLink": {
        "type": "object",
        "properties": {
          "transactionID": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/transactionLinkType"
          }
        }
      },
      "transactionLinkType": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3
        ],
        "description": "0: Parent\n1: Refund\n2: Order\n3: Chargeback\n"
      },
      "metadata": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "refundBody": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/amount"
          },
          "metadata": {
            "$ref": "#/components/schemas/metadata"
          }
        },
        "required": [
          "reason",
          "amount",
          "metadata"
        ]
      },
      "adjustmentBody": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/amount"
          },
          "metadata": {
            "$ref": "#/components/schemas/metadata"
          }
        },
        "required": [
          "reason",
          "amount",
          "metadata"
        ]
      },
      "transactionReply": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates if the transaction was successfully processed"
          },
          "data": {
            "type": "object",
            "$ref": "#/components/schemas/transaction",
            "description": "The transaction data containing details of the processed transaction"
          }
        },
        "required": [
          "success"
        ]
      }
    }
  }
}