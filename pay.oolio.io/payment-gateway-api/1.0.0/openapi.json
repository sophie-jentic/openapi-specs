{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Gateway API",
    "version": "1.0.0",
    "description": "The Payment Gateway API lets you create transactions and query or verify existing transactions.\n\n## Authentication\n\nTo connect to the payment gateway API, you must authenticate your requests with an API as bearer token.\nTo learn about API keys see [TODO](TODO).\n\n`curl -H \"Authorization: Bearer <token>\" -H \"Content-Type: application/json\" ...`\n",
    "contact": {
      "name": "Oolio Pay Developers",
      "url": "https://github.com/oolio-group"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/FLETCHERCFALLARIA/payment-gateway-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://pay.oolio.io/api/v0/gateway"
    },
    {
      "url": "https://pay.oolio.dev/api/v0/gateway"
    },
    {
      "url": "http://localhost:5200/gateway"
    }
  ],
  "tags": [
    {
      "name": "transactions"
    }
  ],
  "paths": {
    "/transactions/{merchantId}": {
      "get": {
        "summary": "Get a list of transactions",
        "description": "Get a list of transactions with various filters applied",
        "operationId": "get-transactions",
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "merchantId",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "timestamp in ms"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "integer",
              "format": "int64",
              "description": "timestamp in ms"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "tradingDateFrom",
            "schema": {
              "type": "string",
              "description": "tradingDateFrom accepts date in format of DD/MM/YYYY when this field is provided will overwrite the from and to params of txn query and the txns will be returned basis of from and to of trading date provided with the trading end-time added to the date range"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "tradingDateTo",
            "schema": {
              "type": "string",
              "description": "tradingDateTo accepts date in format of DD/MM/YYYY when this input is provided along with tradingDateFrom, it will overwrite the from and to params of transaction query. The transaction will be returned based on tradingDateFrom till the range of tradingDateTo with the trading end time added to the date ranges as well"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/transactionStatus"
              }
            },
            "required": false
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/transactionType"
              }
            },
            "required": false
          },
          {
            "in": "query",
            "name": "paymentMethods",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false
          },
          {
            "in": "query",
            "name": "minAmount",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "maxAmount",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "merchantReference",
            "schema": {
              "type": "string",
              "description": "Filter transactions by merchant reference (order ID)"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "storeRefs",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Filter transactions by store references"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "description": "Pagination cursor for retrieving the next page of results"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "searchTerm",
            "schema": {
              "type": "string",
              "description": "Search term to filter transactions (searches across multiple fields)"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "terminals",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Filter transactions by terminal IDs"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "salesChannels",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "enum": [
                  0,
                  1
                ],
                "description": "0: POS\n1: eCommerce\n"
              },
              "description": "Filter transactions by sales channels"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "List of transactions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/transaction"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "pageNumber": {
                          "type": "integer"
                        },
                        "cursor": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request problem reading or understanding the request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internet sever error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{merchantId}/{id}": {
      "get": {
        "summary": "Get a transaction by ID",
        "description": "Fetch details for a single transaction given its Id.",
        "operationId": "get-transaction-by-id",
        "tags": [
          "transactions"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "merchantId",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/transactionReply"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request problem reading or understanding the request",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internet sever error",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{merchantId}/{id}/adjust": {
      "post": {
        "summary": "Adjust a transaction",
