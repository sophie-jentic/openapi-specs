    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/na-132/LargeProjectAPI/1.0.0"
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": ""
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Logs in to the large project",
        "operationId": "doLogin",
        "description": "Logs in to the large project",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "loginItem",
            "description": "Login",
            "schema": {
              "$ref": "#/definitions/Login"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Registers a user to the large project",
        "operationId": "doRegister",
        "description": "Registers a user to the large project",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "registerItem",
            "description": "Register",
            "schema": {
              "$ref": "#/definitions/Register"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/api/runs": {
      "post": {
        "tags": [
          "Runs"
        ],
        "summary": "Adds a run",
        "operationId": "addRun",
        "description": "Adds a run to the large project database",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "runItem",
            "description": "Run",
            "schema": {
              "$ref": "#/definitions/Run"
            }
          }
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      },
      "get": {
        "tags": [
          "Runs"
        ],
        "summary": "Searches run/s with a particular query",
        "operationId": "searchRun",
        "description": "Searches run/s from the large project database",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "description": "Search",
            "type": "string"
          }
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": "#/definitions/Run"
            }
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/api/runs/{runId}": {
      "parameters": [
        {
          "name": "runId",
          "in": "path",
          "required": true,
          "description": "Insert Description.",
          "type": "string",
          "format": "objectid"
        }
      ],
      "put": {
        "tags": [
          "Runs"
        ],
        "summary": "Updates a run",
        "operationId": "updateRun",
        "description": "Updates a run to the large project database",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "runItem",
            "description": "Run",
            "schema": {
              "$ref": "#/definitions/RunUpdate"
            }
          }
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      },
      "delete": {
        "tags": [
          "Runs"
        ],
        "summary": "Deletes a run",
        "operationId": "deleteRun",
        "description": "Deletes a run to the large project database",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "Login": {
      "type": "object",
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string",
          "example": "1@gmail.com"
        },
        "password": {
          "type": "string",
          "example": "pass1"
        }
      }
    },
    "Register": {
      "type": "object",
      "required": [
        "displayName",
        "userName",
        "email",
        "password",
        "weight",
        "height",
        "age",
        "sex"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "example": "Mark"
        },
        "userName": {
          "type": "string",
          "example": "Mark"
        },
        "email": {
          "type": "string",
          "example": "mark@gmail.com"
        },
        "password": {
          "type": "string",
          "example": "Mark"
        },
        "weight": {
          "type": "integer",
          "format": "int32",
          "example": 160
        },
        "height": {
          "type": "integer",
          "format": "int32",
          "example": 70
        },
        "age": {
          "type": "integer",
          "format": "int32",
          "example": 21
        },
        "sex": {
          "type": "string",
          "example": "male"
        }
      }
    },
    "Run": {
      "type": "object",
      "required": [
        "distance",
        "time",
        "averagePace",
        "caloriesBurned",
        "startTime",
        "finishTime"
      ],
      "properties": {
        "distance": {
          "type": "number",
          "format": "double",
          "example": 5.2
        },
        "time": {
          "type": "integer",
          "format": "int32",
          "example": 35
        },
        "averagePace": {
          "type": "number",
          "format": "double",
          "example": 6.73
        },
        "caloriesBurned": {
          "type": "integer",
          "format": "int32",
          "example": 450
        },
        "startTime": {
          "type": "string",
          "format": "date-time",
          "example": "2025-10-25T08:00:00.000Z"
        },
        "finishTime": {
          "type": "string",
          "format": "date-time",
          "example": "2025-10-25T08:00:00.000Z"
        }
      }
    },
    "RunUpdate": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "number",
          "format": "double",
          "example": 5.2
        },
        "time": {
          "type": "integer",
          "format": "int32",
          "example": 35
        },
        "averagePace": {
          "type": "number",
          "format": "double",
          "example": 6.73
        },
        "caloriesBurned": {
          "type": "integer",
          "format": "int32",
          "example": 450
        },
        "startTime": {
          "type": "string",
          "format": "date-time",
          "example": "2025-10-25T08:00:00.000Z"
        },
        "finishTime": {
          "type": "string",
          "format": "date-time",
          "example": "2025-10-25T08:00:00.000Z"
        }
      }
    },
    "Search": {
      "type": "object",
      "required": [
        "userId",
        "search"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 1
        },
        "search": {
          "type": "string",
          "example": "a"
        }
      }
    },
    "Delete": {
      "type": "object",
      "required": [
        "userId",
        "runId"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 1
        },
        "runId": {
          "type": "integer",
          "example": 2
        }
      }
    }
  },
  "host": "smallproject.shop:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ]
}