{
  "swagger": "2.0",
  "info": {
    "description": "This is the API documentation for the COP 4331 Large Project",
    "version": "1.0.0",
    "title": "The Large Project",
    "contact": {
      "email": "da747546@ucf.edu"
    },
    "license": {
