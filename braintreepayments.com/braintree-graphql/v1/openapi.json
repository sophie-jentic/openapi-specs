                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/createClientToken": {
      "post": {
        "operationId": "createClientToken",
        "summary": "Generate Client Token",
        "description": "Generate a client token for initializing the Braintree client-side SDK. The token encodes the merchant configuration and optionally associates with a customer.",
        "tags": ["Client Tokens"],
        "requestBody": {
          "required": true,
          "content": {
