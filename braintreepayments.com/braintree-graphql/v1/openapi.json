                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic authentication using Braintree API public key as username and private key as password. Include Braintree-Version header for API versioning."
      }
    },
    "schemas": {
      "ChargePaymentMethodInput": {
        "type": "object",
        "required": ["paymentMethodId", "transaction"],
        "properties": {
          "paymentMethodId": {
            "type": "string",
            "description": "Vault payment method token or single-use nonce"
          },
          "transaction": {
            "$ref": "#/components/schemas/TransactionInput"
          }
        }
      },
      "AuthorizeCreditCardInput": {
        "type": "object",
        "required": ["paymentMethodId", "transaction"],
        "properties": {
          "paymentMethodId": {
            "type": "string",
            "description": "Credit card payment method ID"
          },
          "transaction": {
            "$ref": "#/components/schemas/TransactionInput"
          }
        }
      },
      "TransactionInput": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": {
            "type": "string",
            "description": "Transaction amount as a decimal string",
            "pattern": "^\\d+\\.\\d{2}$",
            "example": "10.00"
          },
          "orderId": {
            "type": "string",
            "description": "Merchant-defined order identifier",
            "maxLength": 255
          },
          "merchantAccountId": {
            "type": "string",
            "description": "Merchant account to use for the transaction"
          },
          "purchaseOrderNumber": {
            "type": "string",
            "description": "Purchase order number for Level 2/3 processing",
            "maxLength": 17
          },
          "customFields": {
            "type": "object",
            "description": "Custom key-value fields defined in the Braintree Control Panel",
            "additionalProperties": {
              "type": "string"
            }
          },
          "descriptor": {
            "type": "object",
            "description": "Dynamic descriptor fields",
            "properties": {
              "name": {
                "type": "string",
                "description": "Dynamic descriptor name (company*product format)",
                "maxLength": 22
              },
              "phone": {
                "type": "string",
                "description": "Dynamic descriptor phone",
                "maxLength": 14
              },
              "url": {
                "type": "string",
                "description": "Dynamic descriptor URL",
                "maxLength": 13
              }
            }
          },
          "shipping": {
            "$ref": "#/components/schemas/AddressInput"
          },
          "riskData": {
            "type": "object",
            "properties": {
              "customerBrowser": {
                "type": "string",
                "description": "Customer's browser User-Agent"
              },
              "customerIp": {
                "type": "string",
                "description": "Customer's IP address"
              },
              "deviceData": {
                "type": "string",
                "description": "Braintree device data for fraud detection"
              }
            }
          }
        }
      },
      "CaptureTransactionInput": {
        "type": "object",
        "required": ["transactionId"],
        "properties": {
          "transactionId": {
            "type": "string",
            "description": "ID of the authorized transaction to capture"
          },
          "amount": {
            "type": "string",
            "description": "Amount to capture (for partial capture). Omit for full capture.",
            "pattern": "^\\d+\\.\\d{2}$"
          }
        }
      },
      "RefundTransactionInput": {
        "type": "object",
        "required": ["transactionId"],
        "properties": {
          "transactionId": {
            "type": "string",
            "description": "ID of the settled transaction to refund"
          },
          "amount": {
            "type": "string",
            "description": "Amount to refund (for partial refund). Omit for full refund.",
            "pattern": "^\\d+\\.\\d{2}$"
          }
        }
      },
      "VoidTransactionInput": {
        "type": "object",
        "required": ["transactionId"],
        "properties": {
          "transactionId": {
            "type": "string",
            "description": "ID of the authorized transaction to void"
          }
        }
      },
      "CreateCustomerInput": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Custom customer ID (max 36 characters)",
                "maxLength": 36
              },
              "firstName": {
                "type": "string",
                "maxLength": 255
              },
              "lastName": {
                "type": "string",
                "maxLength": 255
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string"
              },
              "company": {
                "type": "string",
                "maxLength": 255
              },
              "website": {
                "type": "string",
                "format": "uri",
                "maxLength": 255
              },
              "fax": {
                "type": "string",
                "maxLength": 255
              },
              "customFields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
