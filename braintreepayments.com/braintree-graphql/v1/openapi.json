{
  "openapi": "3.0.3",
  "info": {
    "title": "Braintree Payments GraphQL API",
    "description": "Braintree Payments API (now part of PayPal) providing payment processing, customer management, tokenization, and vault services via a GraphQL endpoint. This spec documents the primary mutations and queries as REST-style operations for interoperability. Braintree supports credit cards, PayPal, Venmo, Apple Pay, Google Pay, and other payment methods with built-in fraud protection and 3D Secure support.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://developer.paypal.com/braintree/docs/",
    "contact": {
      "name": "Braintree Developer Support",
      "url": "https://developer.paypal.com/braintree/docs/"
    }
  },
  "servers": [
    {
      "url": "https://payments.braintree-api.com/graphql",
      "description": "Braintree Production GraphQL API"
    },
    {
      "url": "https://payments.sandbox.braintree-api.com/graphql",
      "description": "Braintree Sandbox GraphQL API"
    }
  ],
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "tags": [
    {
      "name": "Transactions",
      "description": "Payment transaction processing - charges, captures, refunds, and voids"
    },
    {
      "name": "Customers",
      "description": "Customer profile management"
    },
    {
      "name": "Payment Methods",
      "description": "Payment method tokenization and vault management"
    },
    {
      "name": "Client Tokens",
      "description": "Client-side SDK token generation"
    },
    {
      "name": "Disputes",
      "description": "Transaction dispute management"
    },
    {
      "name": "Configuration",
      "description": "Client and merchant configuration"
    }
  ],
  "paths": {
    "/chargePaymentMethod": {
      "post": {
        "operationId": "chargePaymentMethod",
        "summary": "Charge a Payment Method",
        "description": "Authorize and optionally capture a transaction using a vaulted payment method token or single-use payment method nonce. Supports credit cards, PayPal, Venmo, Apple Pay, Google Pay, and other payment methods.",
        "tags": ["Transactions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChargePaymentMethodInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPayload"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid input parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid API credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error - transaction declined or failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/authorizeCreditCard": {
      "post": {
        "operationId": "authorizeCreditCard",
        "summary": "Authorize a Credit Card Transaction",
        "description": "Authorize a credit card transaction without capturing funds. Use captureTransaction to collect the authorized amount later.",
        "tags": ["Transactions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizeCreditCardInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionPayload"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/captureTransaction": {
      "post": {
        "operationId": "captureTransaction",
        "summary": "Capture an Authorized Transaction",
        "description": "Capture a previously authorized transaction to collect funds. Supports full or partial capture amounts.",
