    "/clientConfiguration": {
      "post": {
        "operationId": "getClientConfiguration",
        "summary": "Get Client Configuration",
        "description": "Retrieve the client configuration for the authenticated merchant including enabled payment methods, environment settings, and feature flags.",
        "tags": ["Configuration"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Client configuration retrieved",
            "content": {
              "application/json": {
