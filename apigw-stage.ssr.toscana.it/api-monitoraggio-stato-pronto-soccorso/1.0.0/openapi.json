{
  "openapi": "3.0.3",
  "info": {
    "title": "API Monitoraggio Stato Pronto Soccorso",
    "description": "Servizio per la consultazione in tempo reale dell'affollamento del PS per i presidi di Pronto Soccorso della provincia di Arezzo, destinato alla Piattaforma Digitale Nazionale Dati (PDND).",
    "version": "1.0.0",
    "contact": {
      "name": "ESTAR Direttore UOC Processi e Flussi USL TSE",
      "email": "marco.lunghetti@estar.toscana.pazientiInAttesa"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/HXUHZB6CH_1/api-monitoraggio-stato-pronto-soccorso/1.0.0"
  },
  "servers": [
    {
      "url": "https://apigw-stage.ssr.toscana.it/cast/cast-api-gateway/rest/AUSLTSE-PDND/STATUS-PS/",
      "description": "Server di Produzione"
    }
  ],
  "paths": {
    "/stato-presidi-provinciaArezzo": {
      "get": {
        "summary": "Elenco stato di tutti i Pronto Soccorso",
        "description": "Restituisce l'affollamento attuale per tutti i presidi gestiti dall'ente.",
        "responses": {
          "200": {
            "description": "Operazione riuscita",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/listaStatoProntoSoccorso"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Codice struttura non valido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/dettaglioProblemi"
                }
              }
            }
          }
        }
      }
    },
    "/stato-presidi-provinciaArezzo/{codiceStruttura}": {
      "get": {
        "summary": "Dettaglio singolo Pronto Soccorso",
        "parameters": [
          {
            "name": "codiceStruttura",
            "in": "path",
            "required": true,
            "description": "Codice univoco della struttura ospedaliera (es. HSP01)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dati della struttura trovati",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/listaStatoProntoSoccorso"
                }
              }
            }
          },
          "404": {
            "description": "Codice struttura non valido",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/dettaglioProblemi"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "statoProntoSoccorso": {
        "type": "object",
        "properties": {
          "idStruttura": {
            "type": "string",
            "example": "HSP-123"
          },
          "nomeStruttura": {
            "type": "string",
            "example": "Ospedale Arezzo - PS"
          },
          "ultimoAggiornamento": {
            "type": "string",
            "format": "date-time",
            "example": "2024-05-20T14:30:00Z"
          },
          "statoPS": {
            "$ref": "#/components/schemas/psdata"
          }
        }
      },
      "psdata": {
        "type": "object",
        "properties": {
          "attesa1": {
            "type": "integer",
            "example": 1
          },
          "attesa2": {
            "type": "integer",
            "example": 3
          },
          "attesa3": {
            "type": "integer",
            "example": 5
          },
          "attesa4": {
            "type": "integer",
            "example": 12
          },
          "attesa5": {
            "type": "integer",
            "example": 4
          },
          "trattamento1": {
            "type": "integer",
            "example": 1
          },
          "trattamento2": {
            "type": "integer",
            "example": 3
          },
          "trattamento3": {
            "type": "integer",
            "example": 5
          },
          "trattamento4": {
            "type": "integer",
            "example": 12
          },
          "trattamento5": {
            "type": "integer",
            "example": 4
          },
          "trattati1": {
            "type": "integer",
            "example": 1
          },
          "trattati2": {
            "type": "integer",
            "example": 3
          },
          "trattati3": {
            "type": "integer",
            "example": 5
          },
          "trattati4": {
            "type": "integer",
            "example": 12
          },
          "trattati5": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "listaStatoProntoSoccorso": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/statoProntoSoccorso"
        }
      },
      "dettaglioProblemi": {
        "description": "Problemi su richiesta effettuata",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "URI che identifica il tipo di problema"
          },
          "title": {
            "type": "string",
            "description": "Breve riassunto del problema"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code"
          },
          "detail": {
            "type": "string",
            "description": "Descrizione dettagliata del problema"
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "description": "URI che identifica l'istanza specifica"
          }
        },
        "required": [
          "title",
          "status"
        ]
      }
    }
  }
}