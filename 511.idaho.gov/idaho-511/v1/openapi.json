  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "key",
        "description": "Developer API key obtained from the Idaho 511 developer portal"
      }
    },
    "schemas": {
      "RoadCondition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the road segment"
          },
          "roadName": {
            "type": "string",
            "description": "Name of the road or highway"
          },
          "condition": {
            "type": "string",
            "description": "Current road condition description"
          },
          "startLocation": {
            "type": "string",
            "description": "Start point of the road segment"
          },
          "endLocation": {
            "type": "string",
            "description": "End point of the road segment"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "Latitude coordinate"
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitude coordinate"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of last update"
          }
        }
      },
      "TruckRestriction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "roadName": {
