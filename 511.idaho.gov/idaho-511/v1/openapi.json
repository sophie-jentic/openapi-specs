          },
          "restrictionType": {
            "type": "string",
            "description": "Type of weight restriction"
          },
          "description": {
            "type": "string",
            "description": "Detailed restriction description"
          },
          "startLocation": {
            "type": "string"
          },
          "endLocation": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Camera": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique camera identifier"
          },
          "name": {
            "type": "string",
            "description": "Camera name or location label"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the current camera image"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "direction": {
            "type": "string",
            "description": "Direction the camera faces"
          },
          "roadName": {
            "type": "string"
          }
        }
      },
      "WeatherStation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Station name"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "temperature": {
            "type": "number",
            "format": "double",
            "description": "Current temperature reading"
          },
          "humidity": {
            "type": "number",
            "format": "double",
            "description": "Current humidity percentage"
          },
          "windSpeed": {
            "type": "number",
            "format": "double",
            "description": "Current wind speed"
          },
          "visibility": {
            "type": "string",
            "description": "Visibility conditions"
          }
        }
      },
      "MessageSign": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Sign location name"
          },
          "message": {
            "type": "string",
            "description": "Currently displayed message"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "roadName": {
            "type": "string"
          }
        }
      },
      "MountainPass": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Mountain pass name"
          },
          "elevation": {
            "type": "number",
            "format": "double",
            "description": "Pass elevation in feet"
          },
          "condition": {
            "type": "string",
            "description": "Current pass condition"
          },
          "roadName": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrafficEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Event type (incident, construction, closure, etc.)"
          },
          "description": {
            "type": "string",
            "description": "Event description"
          },
          "roadName": {
            "type": "string"
          },
          "startLocation": {
            "type": "string"
          },
          "endLocation": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "severity": {
            "type": "string",
            "description": "Event severity level"
          }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Alert title"
          },
          "description": {
            "type": "string",
            "description": "Alert description"
          },
          "severity": {
            "type": "string",
            "description": "Alert severity"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "area": {
