      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logs in to the system.",
        "operationId": "Auth_Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true,
          "x-bodyName": "credentials"
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/entity/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logs out from the system.",
        "operationId": "Auth_Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/entity": {
      "get": {
        "tags": [
          "Root"
        ],
        "summary": "Returns the version of the Acumatica ERP instance and the endpoints available in this instance.",
        "operationId": "Root_Get",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionAndEndpoints"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionAndEndpoints"
                }
              }
            }
          }
        }
      }
    }
  },
