            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "company": {
            "type": "string",
            "nullable": true
          },
          "tenant": {
            "type": "string",
            "nullable": true
          },
          "branch": {
            "type": "string",
            "nullable": true
          },
          "locale": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Endpoint": {
