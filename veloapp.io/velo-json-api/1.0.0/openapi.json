              {
                "street": "Store Ave",
                "number": "456",
                "city": "Shop City",
                "zip": "67890",
                "country": "Retailand",
                "phone": "0000000"
              }
            ]
          },
          "polygonId": {
            "type": "integer",
            "description": "Velo service Identifier",
            "examples": [
              15
            ]
          },
          "externalServiceId": {
            "type": "string",
            "description": "Velo sub-service Identifier (usually not required)",
            "examples": [
              "4312859"
            ]
          },
          "externalId": {
            "type": "string",
            "description": "Order ID reference in your system",
            "examples": [
              "Order113"
            ]
          },
          "weight": {
            "type": "number",
            "description": "The package's weight",
            "examples": [
              0
            ]
          },
          "dimensions": {
            "type": "object",
            "description": "The package's size measurements",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "depth": {
                "type": "number"
              }
            },
            "examples": [
              {
                "width": 0,
                "height": 0,
                "depth": 0
              }
            ]
          },
          "note": {
            "type": "string",
            "description": "Order notes (for DELIVERY notes - use line2 on the address)",
            "examples": [
              "Contact the customer before sending to the delivery company"
            ]
          },
          "packagesCount": {
            "type": "number",
            "description": "How many packages are sent in this delivery (defaults to 1)",
            "examples": [
              1
            ]
          },
          "courierBarcode": {
            "type": "string",
            "description": "The delivery's barcode (if it has one)",
            "examples": [
              "Vvelo341"
            ]
          },
          "courierRemoteId": {
            "type": "string",
            "description": "The courier company's remote ID for this delivery",
            "examples": [
              "AE333"
            ]
          },
          "products": {
            "type": "array",
            "description": "The products/items sent in the delivery",
            "items": {
              "type": "object",
              "required": [
                "name",
                "code",
                "price",
                "quantity"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The product's name/title",
                  "examples": [
                    "Polo shirt"
                  ]
                },
                "code": {
                  "type": "string",
                  "description": "The product's SKU",
                  "examples": [
                    "PLSH221"
                  ]
                },
                "variation": {
                  "type": "string",
                  "description": "The product variant's name/title",
                  "examples": [
                    "XL / Blue"
                  ]
                },
                "price": {
                  "type": "number",
                  "description": "The product's price (per unit)",
                  "examples": [
                    89.99
                  ]
                },
                "quantity": {
                  "type": "integer",
                  "description": "The quantity of the product in this order",
                  "examples": [
                    1
                  ]
                }
              }
            }
          }
        }
      },
      "AcceptRequestBody": {
        "type": "object",
        "required": [
          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "examples": [
              "Vorder23"
            ]
          }
