              "prices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "price": {
                      "type": "integer",
                      "examples": [
                        30
                      ]
                    },
                    "slug": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "examples": [
                        null
                      ]
                    },
                    "currency_id": {
                      "type": "integer",
                      "examples": [
                        2
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "description": "First name of the person"
          },
          "last_name": {
            "type": "string",
            "description": "Last name of the person"
          },
          "phone": {
            "type": "string",
            "description": "Phone number (numeric characters only)"
          },
          "street": {
            "type": "string",
            "description": "Street name"
          },
          "number": {
            "type": "string",
            "description": "House number"
          },
          "line2": {
            "type": "string",
            "description": "Apartment number, entrance, floor, etc."
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "state": {
            "type": "string",
            "description": "State"
          },
          "country": {
            "type": "string",
            "description": "Country"
          },
          "zipcode": {
            "type": "string",
            "description": "Zip code"
          },
          "latitude": {
            "type": "string",
            "description": "Latitude"
          },
          "longitude": {
            "type": "string",
            "description": "Longitude"
          }
        },
        "required": [
          "first_name",
          "last_name",
          "phone",
          "street",
          "number",
          "city",
          "country"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the product"
          },
          "code": {
            "type": "string",
            "description": "Product code"
          },
          "variation": {
            "type": "string",
            "description": "Variation of the product (e.g., size, color)"
          },
          "price": {
            "type": "number",
            "format": "float",
            "description": "Price of the product"
          },
          "quantity": {
            "type": "number",
            "format": "float",
            "description": "Quantity of the product"
          }
        },
        "required": [
          "name",
          "code",
          "price",
          "quantity"
        ]
      },
      "OrderStatus": {
        "type": "string",
        "description": "The order's status",
        "oneOf": [
          {
            "type": "string",
            "const": "placed",
            "description": "Draft order created"
          },
          {
            "type": "string",
            "const": "updated",
            "description": "Draft order updated"
          },
          {
            "type": "string",
            "const": "accept_failed",
            "description": "Can't transmit to courier"
          },
          {
            "type": "string",
            "const": "pending_accept",
            "description": "Transmitting to courier"
          },
          {
            "type": "string",
            "const": "accepted",
            "description": "Transmitted to courier"
          },
          {
            "type": "string",
            "const": "pending_pickup",
            "description": "Awaiting pickup"
          },
          {
            "type": "string",
            "const": "transit",
            "description": "In transit"
          },
          {
            "type": "string",
            "const": "transit_to_destination",
            "description": "In transit to the destination"
          },
          {
            "type": "string",
            "const": "transit_to_warehouse",
            "description": "In transit to fulfillment warehouse"
          },
          {
            "type": "string",
            "const": "transit_to_sender",
            "description": "In transit back to sender"
          },
          {
            "type": "string",
            "const": "in_warehouse",
            "description": "In fulfillment warehouse"
          },
          {
            "type": "string",
            "const": "pending_cancel",
            "description": "Cancelling"
          },
          {
            "type": "string",
            "const": "service_cancel",
            "description": "Cancelled by customer service"
          },
          {
            "type": "string",
            "const": "data_problem",
            "description": "Data problem"
          },
          {
            "type": "string",
            "const": "cancelled",
            "description": "Cancelled"
          },
          {
            "type": "string",
            "const": "delivered",
            "description": "Delivered"
          },
          {
            "type": "string",
            "const": "rejected",
            "description": "Rejected"
          },
          {
            "type": "string",
            "const": "refunded",
            "description": "Refunded"
          },
          {
            "type": "string",
            "const": "failed",
            "description": "Failed"
          }
        ]
      }
    }
  },
  "paths": {
    "/api/json/v1/check": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Get Shipping Options",
        "description": "Takes address and package size information, and returns all available delivery services for it, and their details.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequestBody"
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/ContentType"
          },
          {
            "$ref": "#/components/parameters/XVeloApiKey"
          },
          {
            "$ref": "#/components/parameters/XVeloHmac"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response (may be empty)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/CheckSuccessResponse"
                    },
                    {
                      "$ref": "#/components/schemas/CheckSuccessEmptyResponse"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableContentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/json/v1/order": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create Order",
        "description": "Takes address information, package size information, polygon id and external service id (these two are from the \"Get Shipping Options\" endpoint) and creates a draft order on Velo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderSuccessResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnprocessableContentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/json/v1/accept": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Confirm Delivery",
        "description": "Takes a draft order's ID and transmits it to a courier service provider. After confirming the delivery, your order will be billed and receive a shipping label.",
