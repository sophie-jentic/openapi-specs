  },
  "tags": [
    {
      "name": "Usuarios",
      "description": "Operaciones relacionadas con los usuarios"
    },
    {
      "name": "Seccion 2",
      "description": "Descripci\u00f3n 2"
    }
  ],
  "paths": {
    "/usuarios": {
      "get": {
        "summary": "Obtiene la lista de usuarios",
        "description": "Obtiene la lista de usuarios...",
        "operationId": "getUsuarios",
        "tags": [
          "Usuarios"
        ],
        "parameters": [
          {
            "ref": "#/components/parameters/filters"
          }
        ],
        "responses": {
          "200": {
            "description": "La lista de usuarios",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuarios"
                }
              }
            }
          }
        }
      }
    },
    "/usuarios/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Obtiene un usuario",
        "description": "Obtiene un usuario dado su identificador",
        "operationId": "getUserById",
        "tags": [
          "Usuarios"
        ],
        "responses": {
          "200": {
            "description": "El usuario buscado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Elimina un usuario",
        "description": "Elimina un usuario dado su identificador",
        "operationId": "DeleteUserById",
        "tags": [
          "Usuarios"
        ],
        "responses": {
          "204": {
            "description": "Usuario eliminado correctamente"
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Usuario": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nombre": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "rol": {
            "type": "string",
            "enum": [
              "FREE",
              "PREMIUM",
              "ADMIN"
            ]
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Usuarios": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Usuario"
        }
      }
    },
    "parametros": {
      "Filter": {
        "name": "filter",
        "in": "query",
        "description": "Filtrar poe el nombre"
      }
    }
  }
}