{
  "openapi": "3.0.3",
  "info": {
    "title": "Data Extraction Processor API",
    "description": "Serverless API for extracting structured insurance data from OCR text using LLM processing.\nSupports multiple input formats and document types for comprehensive data extraction.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Generali Malaysia AI/ML Team",
      "email": "ai-ml@generali.com.my"
    },
    "license": {
      "name": "Proprietary"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/gimb/data-extraction-processor-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://ua1plekwr7.execute-api.ap-southeast-1.amazonaws.com",
      "description": "AWS API Gateway (ap-southeast-1)"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Check if the extraction processor service is healthy and operational",
        "operationId": "healthCheck",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Service is unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/extract": {
      "post": {
        "summary": "Extract Insurance Data",
        "description": "Extract structured insurance data from OCR text using LLM processing.\nSupports multiple input formats and document types.\n",
        "operationId": "extractInsuranceData",
        "tags": [
          "Extraction"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/DirectTextExtractionRequest"
                  },
                  {
                    "$ref": "#/components/schemas/JSONResultsExtractionRequest"
                  }
                ]
              },
              "examples": {
                "direct_text": {
                  "summary": "Direct OCR text extraction",
                  "value": {
                    "ocr_text": "INSURANCE POLICY\nPolicy Number: POL123456789\nInsured Name: ABC Manufacturing Sdn Bhd",
                    "document_type": "policy_closing",
                    "filename": "demo_extraction_policy_closing_1234567890.json"
                  }
                },
                "json_results": {
                  "summary": "JSON OCR results extraction",
                  "value": {
                    "ocr_strings": {
                      "PolicyClosing.pdf": "OCR text content here...",
                      "PolicySchedule.pdf": "More OCR text content..."
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extraction completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/DirectTextExtractionResponse"
                    },
                    {
                      "$ref": "#/components/schemas/JSONResultsExtractionResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid input format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "OCR text file not found in S3",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error during extraction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DirectTextExtractionRequest": {
        "type": "object",
        "required": [
          "ocr_text"
        ],
        "properties": {
          "ocr_text": {
            "type": "string",
            "description": "Raw OCR text content to extract data from",
            "example": "INSURANCE POLICY\nPolicy Number: POL987654321\nInsured Name: XYZ Enterprise Sdn Bhd"
          },
          "document_type": {
            "type": "string",
            "description": "Type of insurance document",
            "enum": [
              "fire",
              "marine_closing",
              "marine_schedule",
              "policy_closing"
            ],
            "default": "policy_closing",
            "example": "policy_closing"
          },
          "filename": {
            "type": "string",
            "description": "Optional custom filename for the extraction result",
            "example": "demo_extraction_policy_closing_9876543210.json"
          }
        },
        "additionalProperties": false
      },
      "JSONResultsExtractionRequest": {
        "type": "object",
        "required": [
          "ocr_strings"
        ],
        "properties": {
          "ocr_strings": {
            "type": "object",
            "description": "Dictionary mapping filenames to their OCR text content",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "PolicyClosing.pdf": "OCR text content for closing document...",
              "PolicySchedule.pdf": "OCR text content for schedule document..."
            }
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Lambda function is healthy"
          },
          "status": {
            "type": "string",
            "example": "ok"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-27T10:30:00Z"
          },
          "function": {
            "type": "string",
            "example": "extraction-processor"
          },
          "version": {
            "type": "string",
            "example": "1.0"
          }
        },
        "required": [
          "message",
          "status",
          "timestamp"
        ]
      },
      "DirectTextExtractionResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Direct data extraction completed"
          },
          "extraction_filename": {
            "type": "string",
            "example": "demo_extraction_policy_closing_9876543210.json"
          },
          "document_type": {
            "type": "string",
            "example": "policy_closing"
          },
          "ocr_text_length": {
            "type": "integer",
            "example": 1024
          },
          "extracted_data": {
            "$ref": "#/components/schemas/InsuranceDocumentDetails"
          },
          "demo_mode": {
            "type": "boolean",
            "example": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "message",
          "extraction_filename",
          "document_type",
          "ocr_text_length",
          "extracted_data",
          "demo_mode"
        ]
      },
      "JSONResultsExtractionResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "JSON OCR data extraction completed"
          },
          "folder_path": {
            "type": "string",
            "example": "/data/processed"
          },
          "source_filename": {
            "type": "string",
            "example": "PolicyClosing.pdf"
          },
          "extraction_filename": {
            "type": "string",
            "example": "extraction_PolicyClosing_policy_closing.json"
          },
          "document_type": {
            "type": "string",
            "example": "policy_closing"
          },
          "ocr_text_length": {
            "type": "integer",
            "example": 2048
          },
          "extracted_data": {
            "$ref": "#/components/schemas/InsuranceDocumentDetails"
          },
          "json_input_mode": {
            "type": "boolean",
            "example": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "message",
          "folder_path",
          "source_filename",
          "extraction_filename",
          "document_type",
          "ocr_text_length",
          "extracted_data",
          "json_input_mode"
        ]
      },
      "S3AccessTestResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "S3 access test completed"
          },
          "test_status": {
            "type": "string",
            "enum": [
              "success",
              "partial_success",
              "failed"
            ],
            "example": "success"
          },
          "s3_bucket": {
            "type": "string",
            "example": "sample-ai-nonprod-mlops-data-extraction"
          },
          "s3_read_test": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ],
            "example": "passed"
          },
          "s3_write_test": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ],
            "example": "passed"
          },
          "test_file_key": {
            "type": "string",
            "example": "test/test_s3_access.txt"
          },
          "output_file_key": {
            "type": "string",
            "example": "processed/extraction/test_s3_access_test.json"
          },
          "test_content_length": {
            "type": "integer",
            "example": 256
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "message",
          "test_status",
          "s3_bucket",
          "s3_read_test",
          "s3_write_test"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "OCR text not found: processed/ocr/missing_file.txt"
          }
        },
        "required": [
          "error"
        ]
      },
      "InsuranceDocumentDetails": {
        "type": "object",
        "description": "Complete extracted insurance document data structure",
        "properties": {
          "main_details": {
            "$ref": "#/components/schemas/MainDetails"
          },
          "client_creation_personal": {
            "$ref": "#/components/schemas/ClientCreationPersonal"
          },
          "client_creation_corporate": {
            "$ref": "#/components/schemas/ClientCreationCorporate"
          },
          "policy_header": {
            "$ref": "#/components/schemas/PolicyHeader"
          },
          "coinsurance_panel_maintenance": {
            "$ref": "#/components/schemas/CoinsurancePanelMaintenance"
          },
          "risks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Risk"
            },
            "description": "List of risks covered by the policy"
          },
          "issuing_insurer": {
            "type": "string",
            "description": "Name of the insurance company issuing the policy",
            "example": "SAMPLE INSURANCE BHD"
          },
          "location": {
            "type": "string",
            "description": "Location or situation of the insured property",
            "example": "LOT 123 JALAN SAMPLE, KAMPUNG EXAMPLE"
          },
          "clauses_and_endorsements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of clauses and endorsements",
            "example": [
              "AIRCRAFT DAMAGE",
              "BURSTING OR OVERFLOWING OF WATER TANKS"
            ]
          },
          "issue_date": {
            "type": "string",
            "description": "Date the document was issued",
            "example": "2025-04-15"
          },
          "_chunks_created": {
            "type": "integer",
            "description": "Number of text chunks processed (internal metadata)",
            "example": 3
          },
          "_pages_per_chunk": {
            "type": "integer",
            "description": "Number of pages per chunk (internal metadata)",
            "example": 4
          }
        }
      },
      "MainDetails": {
        "type": "object",
        "properties": {
          "leader_policy_no": {
            "type": "string",
            "description": "Policy number of the leader insurer",
            "example": "W/25/FF11/898989/KUL-17"
          },
          "intro_by": {
            "type": "string",
            "description": "Name of the introducing broker/agent",
            "example": "AHMAD SAMPLE"
          },
          "net_premium_in_cab": {
            "type": "number",
            "format": "float",
            "description": "Net premium in CAB currency",
            "example": 22222.22
          },
          "contract_type": {
            "type": "string",
            "description": "Type of insurance contract",
            "example": "FIRE SECURE"
          },
          "co_leader": {
            "type": "string",
            "description": "Name of the co-leader insurer",
            "example": "EXAMPLE MALAYSIA INSURANCE BHD"
          },
          "GMI_co_share_percent": {
            "type": "number",
            "format": "float",
            "description": "GMI co-share percentage (decimal)",
            "example": 0.35
          },
          "gross_premium_in_CAB_Policy_M": {
            "type": "number",
            "format": "float",
            "description": "Gross premium in CAB policy currency",
            "example": 45217.65
          }
        }
      },
      "ClientCreationPersonal": {
        "type": "object",
        "description": "Personal client information (if applicable)",
        "properties": {
          "client_name": {
            "type": "string",
            "example": "SITI SAMPLE BINTI MOHD ALI"
          },
          "married": {
            "type": "string",
            "enum": [
              "SINGLE",
              "MARRIED",
              "DIVORCED",
              "WIDOWED"
            ]
          },
          "telephones": {
            "type": "string",
            "example": "03-78451236"
          },
          "NRIC_no": {
            "type": "string",
            "description": "National Registration Identity Card number",
            "example": "987654-32-1098"
          },
          "sex": {
            "type": "string",
            "enum": [
              "M",
              "F"
            ],
            "example": "F"
          },
          "address_1": {
            "type": "string",
            "example": "LOT 123 JALAN SAMPLE"
          },
          "address_2": {
            "type": "string",
            "example": "KAMPUNG EXAMPLE"
          },
          "address_3": {
            "type": "string",
            "example": "SEKSYEN U9"
          },
          "state": {
            "type": "string",
            "example": "SELANGOR"
          },
          "post_code": {
            "type": "string",
            "example": "41234"
          },
          "category": {
            "type": "string",
            "example": "INDIVIDUAL"
          }
        }
      },
      "ClientCreationCorporate": {
        "type": "object",
        "description": "Corporate client information",
        "properties": {
          "client_name": {
            "type": "string",
            "example": "SAMPLE ENTERPRISES (M) SDN BHD"
          },
          "corporation": {
            "type": "string",
            "example": "SAMPLE ENTERPRISES (M) SDN BHD"
          },
          "license": {
            "type": "string",
            "description": "Business license number"
          },
          "category": {
            "type": "string",
            "example": "CORPORATE"
          },
          "post_code": {
            "type": "string",
            "example": "47800"
          },
          "address_1": {
            "type": "string",
            "example": "LOT 456 JALAN DEMO"
          },
          "address_2": {
            "type": "string",
            "example": "KAMPUNG TEST"
          },
          "address_3": {
            "type": "string",
            "example": "SEKSYEN U7"
          }
        }
      },
      "PolicyHeader": {
        "type": "object",
        "description": "Basic policy header information",
        "properties": {
          "insured_name": {
            "type": "string",
            "description": "Name of the insured party",
            "example": "SAMPLE INDUSTRIES (M) SDN BHD"
          },
          "inception": {
            "type": "string",
            "format": "date",
            "description": "Policy inception date",
            "example": "2025-04-01"
          },
          "expiry": {
            "type": "string",
            "format": "date",
            "description": "Policy expiry date",
            "example": "2026-03-31"
          },
          "agent": {
            "type": "string",
            "description": "Agent code",
            "example": "AGT002"
          },
          "agent_name": {
            "type": "string",
            "description": "Full agent name",
            "example": "DEMO INSURANCE AGENCY"
          }
        }
      },
      "CoinsurancePanelMaintenance": {
        "type": "object",
        "description": "Co-insurance panel and share information",
        "properties": {
          "share_percent": {
            "type": "number",
            "format": "float",
            "description": "Co-insurance share percentage (decimal)",
            "example": 0.55
          },
          "intro_by": {
            "type": "string",
            "description": "Introducing party"
          },
          "leader": {
            "$ref": "#/components/schemas/LeaderDetails"
          },
          "panel_members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PanelMember"
            },
            "description": "List of co-insurers in the panel"
          }
        }
      },
      "LeaderDetails": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "description": "Leader insurer company name",
            "example": "SAMPLE INSURANCE BHD"
          },
          "account_number": {
            "type": "string",
            "description": "Leader account number",
            "example": "W98765/KUL-2"
          },
          "coinsurer_reference_no": {
            "type": "string",
            "description": "Leader's reference number",
            "example": "W25FF123344KUL-0825"
          },
          "share_percent": {
            "type": "number",
            "format": "float",
            "description": "Leader share percentage (decimal)",
            "example": 0.6
          },
          "comm_percent": {
            "type": "number",
            "format": "float",
            "description": "Leader commission percentage (decimal)",
            "example": 0.15
          }
        }
      },
      "PanelMember": {
        "type": "object",
        "description": "Individual co-insurer in the panel",
        "properties": {
          "company": {
            "type": "string",
            "example": "GENERALI MALAYSIA INSURANCE BERHAD"
          },
          "share_percent": {
            "type": "number",
            "format": "float",
            "example": 0.1
          },
          "comm_percent": {
            "type": "number",
            "format": "float",
            "example": 0.025
          }
        }
      },
      "Risk": {
        "type": "object",
        "description": "Individual risk item covered by the policy",
        "properties": {
          "risk": {
            "$ref": "#/components/schemas/RiskDetails"
          }
        },
        "additionalProperties": true
      },
      "RiskDetails": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "description": "Risk classification (PIAM code)",
            "example": "C1B"
          },
          "sum_insured": {
            "type": "number",
            "format": "float",
            "description": "Sum insured for this risk",
            "example": 7000000
          },
          "description": {
            "type": "string",
            "description": "Description of the risk",
            "example": "ON BUILDING (EXCLUDING FOUNDATION)"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API Gateway API Key for authentication"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Health check and service status endpoints"
    },
    {
      "name": "Extraction",
      "description": "Core data extraction operations"
    }
  ],
  "externalDocs": {
    "description": "Find out more about the Generali Malaysia AI/ML Platform",
    "url": "https://github.com/Generali-Malaysia/my-gi-ai-mlops-data-extraction"
  }
}
