  "servers": [
    {
      "url": "https://fxfca-dev.p2.paas.citizensbank.com/fx-payment",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "FX Payment Service",
      "description": "Endpoints to initiate the authorized Commercial User to do FXTFSI Payment"
    }
  ],
  "paths": {
    "/v1/fca/fx-payments": {
      "post": {
        "tags": [
          "FX Payment Service"
        ],
        "summary": "FX Payment",
        "description": "FX Payment API Service to do FXTFSI Transaction",
        "operationId": "initiateFXPayment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FXPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully initiated FX Payment Transaction.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FXPaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FXPaymentResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FXPaymentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FXPaymentResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FXPaymentResponse"
                }
              }
            }
          }
        }
      }
    }
  },
