{
  "openapi": "3.0.1",
  "info": {
    "title": "ao-fca-fx-payment-service",
    "description": "Documentation APIs v1.0",
    "contact": {
      "name": "FX-FCA API Team",
      "email": "dl-dso-fxfca-team"
    },
