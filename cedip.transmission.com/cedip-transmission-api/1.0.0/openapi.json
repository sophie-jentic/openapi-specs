            "description": "Transmission declined"
          },
          "404": {
            "description": "Transmission not found"
          }
        }
      }
    },
    "/cedip/transmission/{transmissionId}/status": {
      "get": {
        "summary": "Get transmission status",
        "tags": [
          "CEDIP Transmission"
        ],
        "parameters": [
          {
            "name": "transmissionId",
            "in": "path",
            "required": true,
