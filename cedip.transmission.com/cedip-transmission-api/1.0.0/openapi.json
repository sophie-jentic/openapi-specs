          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/cedip/transmission/{transmissionId}/accept": {
      "post": {
        "summary": "Accept transmission request",
        "tags": [
          "Beneficiary Management"
        ],
        "parameters": [
          {
            "name": "transmissionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transmission accepted"
          },
          "404": {
            "description": "Transmission not found"
          }
        }
      }
    },
    "/cedip/transmission/{transmissionId}/decline": {
      "post": {
        "summary": "Decline transmission request",
        "tags": [
          "Beneficiary Management"
        ],
        "parameters": [
          {
            "name": "transmissionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
