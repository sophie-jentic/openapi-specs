      "post": {
        "summary": "Request transmission of CEDIP to a new beneficiary",
        "tags": [
          "CEDIP Transmission"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransmissionRequest"
              }
            }
          }
        },
        "responses": {
