  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "DomainId": {
        "name": "domainId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "SubDomainId": {
        "name": "subdomainId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CompetencyId": {
        "name": "competencyId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "QuestionId": {
        "name": "questionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Domain": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "dom_123456"
          },
          "name": {
            "type": "string",
            "example": "Coding"
          },
          "description": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "CODE"
          },
          "isActive": {
            "type": "boolean",
            "default": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DomainInput": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "code": {
            "type": "string",
            "maxLength": 20
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "DomainListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Domain"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "SubDomain": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "domainId": {
            "type": "string"
          },
          "domainName": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "orderIndex": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SubDomainInput": {
        "type": "object",
        "required": [
          "name",
          "code",
          "domainId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "code": {
            "type": "string",
            "maxLength": 20
          },
          "domainId": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean",
            "default": true
          },
          "orderIndex": {
            "type": "integer",
            "default": 0
          }
        }
      },
      "Competency": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "subdomainId": {
            "type": "string"
          },
          "subdomainName": {
            "type": "string"
          },
          "domainId": {
            "type": "string"
          },
          "domainName": {
            "type": "string"
          },
          "competencyItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetencyItem"
            }
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CompetencyInput": {
        "type": "object",
        "required": [
          "name",
          "code",
          "subdomainId",
          "competencyItems"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "maxLength": 20
          },
          "subdomainId": {
            "type": "string"
          },
          "competencyItems": {
            "type": "array",
            "description": "C1-C5 items with descriptions and scores. Total score should be 100",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/CompetencyItemInput"
            }
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "CompetencyItem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "CompetencyItemInput": {
        "type": "object",
        "required": [
          "code",
          "description",
          "score"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5"
            ],
            "example": "C1"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "example": "Understand basic concepts"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 20
          }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique question identifier",
            "example": "q_789012"
          },
          "questionText": {
            "type": "string",
            "description": "The question text",
            "example": "What is the output of print(2 ** 3)?"
          },
          "questionType": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "domainId": {
            "type": "string",
            "description": "Domain ID",
            "example": "dom_123456"
          },
          "domainName": {
            "type": "string",
            "description": "Domain name (read-only)",
            "example": "Coding"
          },
          "competencyCode": {
            "type": "string",
            "description": "Competency code (C1-C5)",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5"
            ],
            "example": "C1"
          },
          "options": {
            "type": "array",
            "description": "Answer options (for Single Choice and Multiple Choice only)",
            "items": {
              "$ref": "#/components/schemas/QuestionOption"
            }
          },
          "correctAnswers": {
            "type": "array",
            "description": "Correct answers array (for Fill in the blanks only)",
            "items": {
              "type": "string"
            },
            "example": [
              "def",
              "return"
            ]
          },
          "marks": {
            "type": "number",
            "description": "Marks allocated to this question",
            "example": 2
          },
          "explanation": {
            "type": "string",
            "description": "Explanation for the answer",
            "example": "The ** operator is used for exponentiation"
          },
          "isActive": {
            "type": "boolean",
            "default": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "QuestionInput": {
        "type": "object",
        "required": [
          "questionText",
          "questionType",
          "domainId",
          "competencyCode",
          "marks"
        ],
        "properties": {
          "questionText": {
            "type": "string",
            "description": "The question text. For Fill_in_the_blanks questions, use {{1}}, {{2}}, {{3}} etc. to indicate blanks. Example: 'In Python, {{1}} is used for loops and {{2}} for conditions.'",
            "maxLength": 2000,
            "example": "What is the output of print(2 ** 3)?"
          },
          "questionType": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "domainId": {
            "type": "string",
            "description": "Domain ID",
            "example": "dom_123456"
          },
          "competencyCode": {
            "type": "string",
            "description": "Competency code (C1-C5)",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5"
            ],
            "example": "C1"
          },
          "options": {
            "type": "array",
            "description": "Answer options (required for Single Choice and Multiple Choice, empty for Fill in the blanks)",
            "items": {
              "$ref": "#/components/schemas/QuestionOptionInput"
            }
          },
          "correctAnswers": {
            "type": "array",
            "description": "Correct answers array (required for Fill_in_the_blanks only). Array order must match blank numbers: {{1}} corresponds to correctAnswers[0], {{2}} to correctAnswers[1], etc. Length must equal number of blanks in questionText.",
            "items": {
              "type": "string"
            },
            "example": [
              "def",
              "return"
            ]
          },
          "marks": {
            "type": "number",
            "description": "Marks allocated to this question",
            "minimum": 0,
            "example": 2
          },
          "explanation": {
            "type": "string",
            "description": "Explanation for the answer",
            "maxLength": 1000
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "QuestionOption": {
        "type": "object",
        "description": "Answer option for Single Choice or Multiple Choice questions",
        "properties": {
          "id": {
            "type": "string",
            "description": "Option ID",
            "example": "opt_111"
          },
          "optionText": {
            "type": "string",
            "description": "Option text",
            "example": "8"
          },
          "isCorrect": {
            "type": "boolean",
            "description": "Whether this option is correct",
            "example": true
          }
        }
      },
      "QuestionOptionInput": {
        "type": "object",
        "required": [
          "optionText",
          "isCorrect"
        ],
        "description": "Input for creating/updating answer options",
        "properties": {
          "optionText": {
            "type": "string",
            "description": "Option text",
            "maxLength": 500,
            "example": "8"
          },
          "isCorrect": {
            "type": "boolean",
            "description": "Whether this option is correct. For Single Choice: only one should be true. For Multiple Choice: one or more can be true.",
            "example": true
          }
        }
      },
      "QuestionType": {
        "type": "string",
        "description": "Type of question",
        "enum": [
          "Single_Choice",
          "Multiple_Choice",
          "Fill_in_the_blanks"
        ],
        "example": "Single_Choice"
      },
      "QuestionListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "currentPage": {
            "type": "integer",
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "example": 5
          },
          "totalItems": {
            "type": "integer",
            "example": 95
          },
          "itemsPerPage": {
            "type": "integer",
            "example": 20
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "Invalid input parameters"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}