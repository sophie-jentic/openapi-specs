    "/questions/bulk": {
      "post": {
        "tags": [
          "Questions"
        ],
        "summary": "Bulk create questions",
        "description": "Create multiple questions at once",
        "operationId": "bulkCreateQuestions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "questions": {
                    "type": "array",
