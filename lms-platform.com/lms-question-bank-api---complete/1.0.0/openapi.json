    "/questions": {
      "get": {
        "tags": [
          "Questions"
        ],
        "summary": "Get all questions",
        "description": "Retrieves a paginated list of questions with optional filtering",
        "operationId": "getQuestions",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "domainId",
            "in": "query",
            "description": "Filter by domain",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subdomainId",
            "in": "query",
            "description": "Filter by sub-domain",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "competencyCode",
            "in": "query",
            "description": "Filter by competency code (C1-C5)",
            "schema": {
              "type": "string",
              "enum": [
                "C1",
                "C2",
                "C3",
                "C4",
                "C5"
              ]
            }
          },
          {
            "name": "questionType",
            "in": "query",
            "description": "Filter by question type",
            "schema": {
              "$ref": "#/components/schemas/QuestionType"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search in question text",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionListResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Questions"
        ],
        "summary": "Create question",
        "description": "Creates a new question in the question bank",
        "operationId": "createQuestion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionInput"
              },
              "examples": {
                "singleChoice": {
                  "summary": "Single Choice Question",
                  "value": {
                    "questionText": "What is the output of print(2 ** 3)?",
                    "questionType": "Single_Choice",
                    "domainId": "dom_123456",
                    "competencyCode": "C1",
                    "options": [
                      {
                        "optionText": "6",
                        "isCorrect": false
                      },
                      {
                        "optionText": "8",
                        "isCorrect": true
                      },
                      {
                        "optionText": "9",
                        "isCorrect": false
                      },
                      {
                        "optionText": "5",
                        "isCorrect": false
                      }
                    ],
                    "marks": 2,
                    "explanation": "The ** operator is used for exponentiation. 2**3 = 2*2*2 = 8"
                  }
                },
                "multipleChoice": {
                  "summary": "Multiple Choice Question",
                  "value": {
                    "questionText": "Which of the following are valid Python data types?",
                    "questionType": "Multiple_Choice",
                    "domainId": "dom_123456",
                    "competencyCode": "C1",
                    "options": [
                      {
                        "optionText": "int",
                        "isCorrect": true
                      },
                      {
                        "optionText": "string",
                        "isCorrect": true
                      },
                      {
                        "optionText": "boolean",
                        "isCorrect": true
                      },
                      {
                        "optionText": "character",
                        "isCorrect": false
                      }
                    ],
                    "marks": 3,
                    "explanation": "Python has int, str, bool as built-in types. Character is not a separate type in Python."
                  }
                },
                "fillInBlanks": {
                  "summary": "Fill in the Blanks Question",
                  "value": {
                    "questionText": "In Python, the keyword {{1}} is used to define a function, and {{2}} is used to return a value.",
                    "questionType": "Fill_in_the_blanks",
                    "domainId": "dom_123456",
                    "competencyCode": "C2",
                    "options": [],
                    "correctAnswers": [
                      "def",
                      "return"
                    ],
                    "marks": 2,
                    "explanation": "The 'def' keyword defines a function and 'return' sends back a value from the function."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Question"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
