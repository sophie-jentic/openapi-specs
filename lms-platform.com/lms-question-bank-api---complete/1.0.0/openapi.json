          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompetencyInput"
              },
              "example": {
                "name": "Python Programming",
                "code": "PY_PROG",
                "subdomainId": "sub_123456",
                "competencyItems": [
                  {
                    "code": "C1",
                    "description": "Understand Python syntax and basics",
                    "score": 20
                  },
                  {
                    "code": "C2",
                    "description": "Apply functions and modules",
                    "score": 20
                  },
                  {
                    "code": "C3",
                    "description": "Implement data structures",
                    "score": 20
                  },
                  {
                    "code": "C4",
                    "description": "Handle errors and exceptions",
                    "score": 20
                  },
                  {
                    "code": "C5",
                    "description": "Create complete applications",
                    "score": 20
                  }
                ],
                "isActive": true
              }
            }
          }
        },
        "responses": {
