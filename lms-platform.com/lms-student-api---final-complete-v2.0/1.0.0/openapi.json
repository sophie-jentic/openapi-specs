  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ContinueLearning": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "string"
          },
          "courseTitle": {
            "type": "string"
          },
          "courseProgress": {
            "type": "number"
          },
          "currentModule": {
            "type": "object",
            "properties": {
              "moduleId": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "completedResources": {
                "type": "integer"
              },
              "totalResources": {
                "type": "integer"
              }
            }
          },
          "nextTopic": {
            "type": "string"
          },
          "lastAccessedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpcomingAssessment": {
        "type": "object",
        "properties": {
          "assessmentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "courseTitle": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "totalMarks": {
            "type": "number"
          }
        }
      },
      "PerformanceMetric": {
        "type": "object",
        "properties": {
          "metricId": {
            "type": "string"
          },
          "metricName": {
            "type": "string"
          },
          "percentage": {
            "type": "number"
          },
          "color": {
            "type": "string"
          },
          "trend": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "stable"
            ],
            "description": "Performance trend"
          }
        }
      },
      "ProgressTrackingChart": {
        "type": "object",
        "description": "Simple progress tracking data for chart visualization",
        "properties": {
          "courseId": {
            "type": "string"
          },
          "courseTitle": {
            "type": "string"
          },
          "currentProgress": {
            "type": "number",
            "description": "Current progress percentage (shown above chart)"
          },
          "modulesCompleted": {
            "type": "integer",
            "description": "Number of modules completed (shown above chart)"
          },
          "chartData": {
            "type": "object",
            "description": "Week-wise progress data for the chart",
            "properties": {
              "interval": {
                "type": "string",
                "description": "Time interval used"
              },
              "dataPoints": {
                "type": "array",
                "description": "Progress at different weeks",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "string",
                      "description": "Week label for X-axis (e.g., 'Week 2', 'Week 4', 'Week 6')"
                    },
                    "y": {
                      "type": "number",
                      "description": "Progress percentage for Y-axis (0-100)"
                    },
                    "weekNumber": {
                      "type": "integer",
                      "description": "Numeric week number"
                    },
                    "date": {
                      "type": "string",
                      "format": "date",
                      "description": "Actual date of this progress point"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "StudentPerformance": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string"
          },
          "courseType": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "courseTitle": {
            "type": "string"
          },
          "overallPerformance": {
            "type": "number"
          },
