            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "courseType",
            "in": "query",
            "description": "Filter by course type (from first dropdown)",
            "schema": {
              "type": "string"
            },
            "example": "splr"
          },
          {
            "name": "courseId",
            "in": "query",
            "description": "Filter by specific course (from second dropdown)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
