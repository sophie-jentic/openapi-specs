    "/search": {
      "get": {
        "operationId": "search",
        "summary": "Search tracks",
        "tags": [
          "search"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "index",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 25
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "RANKING",
                "TRACK_ASC",
                "TRACK_DESC",
                "ARTIST_ASC",
                "ARTIST_DESC",
                "ALBUM_ASC",
                "ALBUM_DESC",
                "RATING_ASC",
                "RATING_DESC",
                "DURATION_ASC",
                "DURATION_DESC"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackList"
                }
              }
            }
          }
        }
      }
    },
