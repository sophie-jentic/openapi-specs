            "authorizationUrl": "https://connect.deezer.com/oauth/auth.php",
            "scopes": {
              "basic_access": "Access basic user information",
              "email": "Access user email",
              "offline_access": "Access user data offline",
              "manage_library": "Manage user library",
              "manage_community": "Manage user community",
              "delete_library": "Delete user library items",
              "listening_history": "Access listening history"
            }
