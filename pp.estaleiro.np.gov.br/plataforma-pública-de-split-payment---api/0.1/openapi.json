  "components": {
    "schemas": {
      "Arranjo": {
        "type": "string",
        "description": "Identifica o arranjo.",
        "enum": [
          "BOLETO",
          "PIX",
          "TED",
          "TEF"
        ]
      },
      "InformeIniciadaRequest": {
        "type": "object",
        "required": [
          "codMsg",
          "arrj",
          "dtHrMsg",
          "transacoes"
        ],
        "properties": {
          "codMsg": {
            "type": "string",
            "description": "Codigo da mensagem (ex SPL0101 para boleto; SPL0201 para pix dinamico)."
          },
          "arrj": {
            "$ref": "#/components/schemas/Arranjo"
          },
          "dtHrMsg": {
            "type": "string",
            "format": "date-time"
          },
          "transacoes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/TransacaoIniciadaItem"
            }
          }
        },
        "additionalProperties": false
      },
      "TransacaoIniciadaItem": {
        "type": "object",
        "required": [
          "index",
          "valor",
          "cbs",
          "ibs",
          "regFisc",
          "cnpjPspInd",
          "cnpjPspDir",
          "cnpjFornec",
          "cnpjCpfPagOrig",
          "dtHrGer",
          "dtVenc",
          "dtHrLimPgto"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "idDda": {
            "type": "string",
            "description": "ID DDA (boleto).",
            "maxLength": 25
          },
          "numCtrlOrigTrans": {
            "type": "string",
            "maxLength": 20,
            "description": "N\u00famero de controle do originador (boleto)."
          },
          "numCodBarras": {
            "type": "string",
            "maxLength": 44,
            "description": "N\u00famero do c\u00f3digo de barras (boleto)."
          },
          "txId": {
            "type": "string",
            "maxLength": 35,
            "description": "Identificador \u00fanico da transa\u00e7\u00e3o Pix (Pix Din\u00e2mico)."
          },
          "valor": {
            "type": "number",
            "format": "double"
          },
          "cbs": {
            "type": "number",
            "format": "double"
          },
          "ibs": {
            "type": "number",
            "format": "double"
          },
          "regFisc": {
            "type": "string",
            "maxLength": 50
          },
          "cnpjPspInd": {
            "type": "string",
            "maxLength": 8,
            "description": "Raiz CNPJ (8) PSP fornecedor indireto."
          },
          "cnpjPspDir": {
            "type": "string",
            "maxLength": 8,
            "description": "Raiz CNPJ (8) PSP fornecedor direto."
          },
          "cnpjFornec": {
            "type": "string",
            "maxLength": 14
          },
          "cnpjCpfPagOrig": {
            "type": "string",
            "maxLength": 14
          },
          "dtHrGer": {
            "type": "string",
            "format": "date-time"
          },
          "dtVenc": {
            "type": "string",
            "format": "date"
          },
          "dtHrLimPgto": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "InformeAtualizadaBoletoRequest": {
        "type": "object",
        "required": [
          "codMsg",
          "arrj",
          "idPgtoArrj",
          "numCtrlOrigTrans",
          "numCodBarr",
          "valor",
          "cbs",
          "ibs",
          "regFisc",
          "cnpjFornec",
          "cnpjCpfPagOrig",
          "dtHrAtu",
          "dtVenc",
          "dtHrMsg",
          "dtHrLimPgto"
        ],
        "properties": {
          "codMsg": {
            "type": "string",
            "description": "Ex.: SPL0102 (manual)"
          },
          "arrj": {
            "$ref": "#/components/schemas/Arranjo"
          },
          "idPgtoArrj": {
            "type": "string",
            "maxLength": 25
          },
          "numCtrlOrigTrans": {
            "type": "string",
            "maxLength": 20
          },
          "numCodBarr": {
            "type": "string",
            "maxLength": 44
          },
          "valor": {
            "type": "number",
            "format": "double"
          },
          "cbs": {
            "type": "number",
            "format": "double"
          },
          "ibs": {
            "type": "number",
            "format": "double"
          },
          "regFisc": {
            "type": "string",
            "maxLength": 50
          },
          "cnpjPspInd": {
            "type": "string",
            "maxLength": 8
          },
          "cnpjPspDir": {
            "type": "string",
            "maxLength": 8
          },
          "cnpjFornec": {
            "type": "string",
            "maxLength": 14
          },
          "cnpjCpfPagOrig": {
            "type": "string",
            "maxLength": 14
          },
          "dtHrAtu": {
            "type": "string",
            "format": "date-time"
          },
          "dtVenc": {
            "type": "string",
            "format": "date"
          },
          "dtHrMsg": {
            "type": "string",
            "format": "date-time"
          },
          "dtHrLimPgto": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "InformeAtualizadaPixCobvRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/InformeAtualizadaBoletoRequest"
          },
          {
            "type": "object",
            "description": "Mesmo contrato-base, com uso de txId quando aplic\u00e1vel ao Pix Din\u00e2mico."
          }
        ]
      },
      "InformeBaixaBoletoRequest": {
        "type": "object",
        "required": [
          "codMsg",
          "arrj",
          "numCtrlOrigTrans",
          "idArrj",
          "idNumPagtos",
          "valor",
          "regFisc",
          "cnpjPspPag",
          "cnpjCpfPagOrig",
          "cnpjCpfPagEfet",
          "dtHrPgto",
          "dtHrMsg",
          "tpBaixa"
        ],
        "properties": {
          "codMsg": {
            "type": "string",
            "description": "Ex.: SPL0103 (boleto)"
          },
          "arrj": {
            "$ref": "#/components/schemas/Arranjo"
          },
          "numCtrlOrigTrans": {
            "type": "string",
            "maxLength": 20
          },
          "idArrj": {
            "type": "string",
            "maxLength": 19
          },
          "idNumPagtos": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "valor": {
            "type": "number",
            "format": "double"
          },
          "regFisc": {
            "type": "string",
