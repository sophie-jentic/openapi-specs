                "exemplo": {
                  "summary": "Exemplo do manual",
                  "value": {
                    "codMsg": "SPL0101",
                    "arrj": "BOLETO",
                    "dtHrMsg": "2025-11-21T13:55:00",
                    "transacoes": [
                      {
                        "index": 1,
                        "idDda": "1234567890123456789012345",
                        "numCtrlOrigTrans": "CTRL1234567890123456",
                        "numCodBarras": "1234567890123456789023456789012345678901234",
                        "valor": 1500.75,
                        "cbs": 1500.75,
                        "ibs": 1500.75,
                        "regFisc": "RF12345678901234567890123456789012345678901234",
                        "cnpjPspInd": "12345678",
                        "cnpjPspDir": "87654321",
                        "cnpjFornec": "12345678000199",
                        "cnpjCpfPagOrig": "98765432000188",
                        "dtHrGer": "2025-11-21T13:55:00",
                        "dtVenc": "2025-11-30",
                        "dtHrLimPgto": "2025-11-30T23:59:59"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Informe recebido (cria ResourceId)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InformeRecebidoResponse"
