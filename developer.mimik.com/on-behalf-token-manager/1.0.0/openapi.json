  "components": {
    "schemas": {
      "Error": {
        "required": [
          "message",
          "statusCode",
          "title"
        ],
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "info": {
            "type": "object",
            "properties": {}
          }
        }
      },
      "member": {
        "required": [
          "memberId",
          "delegateId",
          "token"
        ],
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "description": "ID of the user who will be the member",
            "example": "2898019418983239680"
          },
          "delegateId": {
            "type": "string",
            "description": "ID of the user who is the delegate and owns the list",
            "example": "8568584395969996023"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Create date"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Update date"
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Revoked date"
          },
          "token": {
            "type": "object",
            "properties": {
              "token_type": {
                "type": "string",
                "description": "type of the token that is being passed"
              },
              "access_token": {
                "type": "string",
                "description": "token for regular access"
              },
              "refresh_token": {
                "type": "string",
                "description": "token for refreshing the access token"
              }
            },
            "description": "Access token for the delegate",
            "example": {
              "token_type": "Bearer",
              "access_token": "JWT token",
              "refresh_token": "refresh token"
            }
          }
        }
      },
      "updateMember": {
        "required": [
          "revoke"
        ],
        "type": "object",
        "description": "whether to revoke (true) or restore (false) member access.",
        "properties": {
          "revoke": {
            "type": "boolean",
            "description": "Revocation flag for the member"
          }
        }
      },
      "newMemberRequest": {
        "required": [
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "ID of the user to whom the request will be sent",
            "example": "2898019418983239680"
          },
          "status": {
            "type": "string",
            "enum": [
              "REQUESTED"
            ],
            "default": "REQUESTED"
          }
        },
        "description": "New member request"
      },
      "memberRequest": {
        "required": [
          "userId",
          "delegateId",
          "status"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "ID of the user who will be the member",
            "example": "2898019418983239680"
          },
          "delegateId": {
            "type": "string",
            "description": "ID of the delegate who generated the request",
            "example": "8568584395969996023"
          },
          "createdAt": {
