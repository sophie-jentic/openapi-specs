          {
            "name": "limit",
            "in": "query",
            "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435 (\u043c\u0430\u043a\u0441\u0438\u043c\u0443\u043c 50)",
            "required": false,
