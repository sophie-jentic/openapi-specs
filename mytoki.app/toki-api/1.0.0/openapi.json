{
  "swagger": "2.0",
  "info": {
    "description": "API Documentation for Toki - A productivity management application for tasks, reminders, and more!\nToki API allows users to: - Create, update, and modify tasks - Create, update, and modify reminders - Create, update, and modify calendar events - View NASA APOD and parking garage availability - Reset forgotten passwords",
    "version": "1.0.0",
    "title": "Toki API",
    "contact": {
      "email": "dionlin12350@gmail.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/universityofcentralf-06a/toki-api/1.0.0"
  },
  "host": "mytoki.app",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "tags": [
    {
      "name": "Users",
      "description": "User registration, authentication, and management"
    },
    {
      "name": "Reminders",
      "description": "Create, view, update, complete, and delete reminders"
    },
    {
      "name": "Tasks",
      "description": "Create, view, update, and delete tasks"
    },
    {
      "name": "CalendarEvents",
      "description": "Create, view, update, and delete calendar events"
    },
    {
      "name": "Integrations",
      "description": "External service integrations (e.g., NASA APOD, parking garages)"
    }
  ],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT token in Authorization header. Format: Bearer <token>\nExample: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI2OTAyY2RlNDk3NDhiZDQzMWRkYjViMzciLCJmaXJzdE5hbWUiOiJhbGVzc2FuZHJvMCIsImxhc3ROYW1lIjoic2FuZHJpMTExIiwiaWF0IjoxNzYzNTM0OTk0fQ.3OjeZvlKGl8itQrIE8So32_xvZLby4wdZbd5Y8BYOCQ"
    }
  },
  "paths": {
    "/addUser": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Register a new user",
        "description": "Creates a new user account and returns a verification token",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "User registration details",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AddUserRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User successfully created",
            "schema": {
              "$ref": "#/definitions/AddUserResponse"
            },
            "examples": {
              "application/json": {
                "id": "507f1f77bcf86cd799439011",
                "name": "Dion",
                "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                "verificationToken": 123456,
                "error": "success, send to login page"
              }
            }
          },
          "400": {
            "description": "Email already registered",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            },
            "examples": {
              "application/json": {
                "error": "Email already registered"
              }
            }
          },
          "500": {
            "description": "Server error",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "firstName": {
                  "type": "string"
                },
                "lastName": {
                  "type": "string"
                },
                "accessToken": {
                  "type": "string"
                },
                "error": {
                  "type": "string"
                }
              }
            },
            "examples": {
              "application/json": {
                "id": -1,
                "firstName": "",
                "lastName": "",
                "accessToken": "",
                "error": "Internal server error occurred"
              }
            }
          }
        }
      }
    },
    "/loginUser": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Login a user",
        "description": "Authenticates a user. Returns errors if email is not found or password is incorrect.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "User login credentials",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful, verification email sent",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            },
            "examples": {
              "application/json": {
                "id": "507f1f77bcf86cd799439011",
                "firstName": "Dion",
                "lastName": "Lin",
                "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                "verificationToken": 123456,
                "error": "none, send to verify page"
              }
            }
          },
          "401": {
            "description": "Incorrect password",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            },
            "examples": {
              "application/json": {
                "error": "Incorrect password"
              }
            }
          },
          "404": {
            "description": "Email not found",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            },
            "examples": {
              "application/json": {
                "error": "Email not found"
              }
            }
          },
          "500": {
            "description": "Server error",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            },
            "examples": {
              "application/json": {
                "error": "Server error: <details>"
              }
            }
          }
        }
      }
    },
    "/verifyUser": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Verify user email",
        "description": "Verifies a user's email using the verification token sent via email",
        "consumes": [
