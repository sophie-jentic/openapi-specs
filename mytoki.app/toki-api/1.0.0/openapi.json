    "/viewAPOD": {
      "post": {
        "tags": [
          "Integrations"
        ],
        "summary": "View NASA APOD",
        "description": "Retrieves NASA Astronomy Picture of the Day for a specific date. Requires an Authorization header with a valid JWT token.",
