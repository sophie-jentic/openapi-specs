  "definitions": {
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "JWT token expired"
        }
      }
    },
    "AddUserRequest": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "email",
        "password"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "Dion"
        },
        "email": {
          "type": "string",
          "format": "email",
          "example": "dionlin12350@gmail.com"
        },
        "password": {
          "type": "string",
          "format": "password",
          "example": "COP4331"
        }
      }
    },
    "AddUserResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "507f1f77bcf86cd799439011"
        },
        "firstName": {
          "type": "string",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "accessToken": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "error": {
          "type": "string",
          "example": "success, send to login page"
        }
      }
    },
    "LoginRequest": {
      "type": "object",
      "required": [
        "email",
        "password"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "example": "dionlin12350@gmail.com"
        },
        "password": {
          "type": "string",
          "format": "password",
          "example": "COP4331"
        }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "507f1f77bcf86cd799439011"
        },
        "firstName": {
          "type": "string",
          "example": "Dion"
        },
        "lastName": {
          "type": "string",
          "example": "Lin"
        },
        "accessToken": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        },
        "verificationToken": {
          "type": "integer",
          "example": 123456
        },
        "error": {
          "type": "string",
          "example": "none, send to verify page"
        }
      }
    },
    "VerifyUserRequest": {
      "type": "object",
      "required": [
        "email",
        "verificationToken"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "example": "dionlin12350@gmail.com"
        },
        "verificationToken": {
          "type": "integer",
