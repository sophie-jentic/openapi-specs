        ],
        "responses": {
          "200": {
            "description": "Verification successful",
            "schema": {
              "$ref": "#/definitions/VerifyUserResponse"
            },
            "examples": {
              "application/json": {
                "id": "507f1f77bcf86cd799439011",
                "error": "success, send to Dashboard page"
              }
            }
          }
        }
      }
    },
