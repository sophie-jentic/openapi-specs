      "patch": {
        "tags": [
          "CompanyCardsSessions"
        ],
        "description": "Sends/returns APDU-command/response to/from company-card",
        "operationId": "RestCompanycardsSessionsByTokenPatch",
        "consumes": [
          "application/json-patch+json",
          "application/json",
          "text/json",
          "application/*+json"
        ],
        "produces": [
          "text/plain",
          "application/json",
          "text/json"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Returned by POST on 201",
            "required": true,
            "type": "string"
          },
          {
            "name": "DAKO-Session-Token",
            "in": "header",
            "description": "Obsolete",
            "required": false,
            "type": "string"
          },
          {
            "name": "command",
            "in": "body",
            "description": "Base64-bytes. Example: \"AKQCDAIAAg==\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "<li>Base64-bytes. Example: \"kAA=\"</li>",
            "schema": {
              "type": "string"
            }
          },
          "400": {
            "description": "<li>Command invalid</li>"
          },
          "401": {
            "description": "<li>Authentication data missing or invalid</li>"
          },
          "404": {
            "description": "<li>Session with token not found</li>"
          },
          "502": {
            "description": "<li>Communication-error with company-card</li>"
          },
          "504": {
            "description": "<li>Communication-timeout with company-card</li>"
          }
        },
        "security": [
          {
            "Basic": []
          },
          {
            "JWT": []
          }
        ],
