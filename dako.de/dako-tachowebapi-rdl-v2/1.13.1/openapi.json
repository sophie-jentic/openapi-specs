    "/companycards/sessions": {
      "post": {
        "tags": [
          "CompanyCardsSessions"
        ],
        "description": "Creates session with company-card from account/company",
        "operationId": "RestCompanycardsSessionsPost",
        "consumes": [
          "application/json-patch+json",
          "application/json",
          "text/json",
          "application/*+json"
        ],
        "produces": [
          "text/plain",
          "application/json",
          "text/json"
        ],
        "parameters": [
          {
            "name": "companyCards",
            "in": "body",
            "description": "If not set any company-card will be used",
            "required": false,
            "schema": {
              "uniqueItems": false,
              "type": "array",
              "items": {
                "$ref": "#/definitions/CompanyCard"
              }
            }
          },
          {
            "name": "company",
            "in": "query",
            "description": "Filter by DAKO-company-ID",
            "required": false,
            "type": "string"
          },
          {
            "name": "account",
            "in": "query",
            "description": "Filter by child-account",
            "required": false,
            "type": "string"
          },
          {
            "name": "timeout",
            "in": "query",
            "description": "Minutes after session will be deleted automatically",
            "required": false,
            "type": "integer",
            "format": "int32",
            "default": 3
          }
        ],
        "responses": {
          "201": {
            "description": "<li>Headers Location and DAKO-Session-Token</li>",
            "schema": {
              "$ref": "#/definitions/CompanyCardSession"
            }
          },
          "202": {
            "description": "<li>Company-card/s busy. Try again later</li>"
          },
          "204": {
            "description": "<li>No company-card/s for account/company</li>"
          },
          "207": {
            "description": "<li>Communication-timeout/error with company-card/s</li>"
          },
          "400": {
            "description": "<li>Company-card/s or company invalid</li>"
          },
          "401": {
            "description": "<li>Authentication data missing or invalid</li>"
          }
        },
        "security": [
          {
            "Basic": []
          },
          {
            "JWT": []
          }
        ],
        "x-isRestricted": false
      }
    },
    "/companycards/sessions/{token}": {
      "get": {
        "tags": [
          "CompanyCardsSessions"
        ],
        "description": "Returns ATR from company-card",
        "operationId": "RestCompanycardsSessionsByTokenGet",
