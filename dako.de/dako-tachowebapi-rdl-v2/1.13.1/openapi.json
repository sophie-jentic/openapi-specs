        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Returned by POST on 201",
            "required": true,
            "type": "string"
          },
          {
            "name": "DAKO-Session-Token",
            "in": "header",
            "description": "Obsolete",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "<li>Session with company-card deleted</li>"
          },
          "202": {
            "description": "<li>Communication-timeout/error with company-card</li>"
          },
          "401": {
            "description": "<li>Authentication data missing or invalid</li>"
          },
          "404": {
            "description": "<li>Session with token not found</li>"
          }
        },
        "security": [
          {
            "Basic": []
