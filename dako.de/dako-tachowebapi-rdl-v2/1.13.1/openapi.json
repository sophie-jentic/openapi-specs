  "definitions": {
    "CompanyCard": {
      "description": "Company-card for RDL-authentication",
      "type": "object",
      "properties": {
        "extendedSerialNumber": {
          "description": "ID of IC of company-card",
          "type": "string",
          "example": "00-37-BA-7D-05-15-04-40"
        },
        "cardNumber": {
          "description": "Card-number imprinted on company-card",
          "type": "string",
          "example": "DU00000000146F00"
        },
        "country": {
          "description": "alpha-2-country-code of company-card",
          "type": "string",
          "example": "DE"
        },
        "companyName": {
          "description": "Company-name imprinted on company-card",
          "type": "string",
          "readOnly": true,
          "example": "DAKO"
        },
        "expirationDate": {
          "format": "date-time",
          "description": "Expiration-date imprinted on company-card",
          "type": "string",
          "readOnly": true,
          "example": "2020-05-20T00:00:00Z"
        },
        "online": {
          "description": "Indicates whether company-card is inserted in card-racks",
          "type": "boolean",
          "readOnly": true,
          "example": "true"
        },
        "inSession": {
          "description": "Indicates whether company-card is currently in session",
          "type": "boolean",
          "readOnly": true,
          "example": "true"
        }
      }
    },
    "CompanyCardSession": {
      "type": "object",
      "properties": {
        "companyCard": {
          "$ref": "#/definitions/CompanyCard",
          "readOnly": true
        },
        "token": {
          "description": "Onetime token to be used with this company-card-session",
          "type": "string",
          "readOnly": true,
          "example": "9c08d42f6e7e403ca9bae40716f7f2b6"
        },
        "expirationTime": {
          "format": "date-time",
          "description": "Time at which session will be deleted automatically",
          "type": "string",
          "readOnly": true,
          "example": "2019-07-20T10:32:09Z"
        },
        "atr": {
          "description": "ATR of company-card as Base64-bytes",
          "type": "string",
          "readOnly": true,
          "example": "O5uXwAox/kWAZwVntgQBAACBBf4="
        }
      }
    },
    "StatisticsEntry": {
      "type": "object",
      "properties": {
        "requestTimeUtc": {
          "format": "date-time",
          "type": "string"
        },
        "executionTime": {
          "type": "string"
        },
        "accessor": {
          "type": "string"
        },
        "resultCode": {
          "format": "int32",
          "type": "integer"
        }
      }
    },
    "JwtToken": {
      "type": "object",
      "properties": {
        "refresh": {
          "type": "string"
        },
        "token": {
          "type": "string"
        }
      }
    }
  },
  "securityDefinitions": {
    "Basic": {
      "type": "basic"
    },
    "JWT": {
      "name": "Authorization",
      "in": "header",
      "type": "apiKey",
      "description": "JWT-token authorization header using the Bearer scheme. Example: \"Authorization: Bearer {token}\""
    }
  },
