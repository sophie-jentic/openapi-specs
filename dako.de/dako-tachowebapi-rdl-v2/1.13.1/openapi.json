          "text/plain",
          "application/json",
          "text/json"
        ],
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "description": "Filter by DAKO-company-ID",
            "required": false,
            "type": "string"
          },
          {
            "name": "online",
            "in": "query",
            "description": "Filter by whether company-card is inserted in card-racks",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "account",
            "in": "query",
            "description": "Filter by child-account",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "<li>Success</li>",
            "schema": {
              "uniqueItems": false,
              "type": "array",
              "items": {
                "$ref": "#/definitions/CompanyCard"
              }
            }
          },
          "204": {
            "description": "<li>No company-card/s for account/company</li>"
          },
          "400": {
            "description": "<li>Company invalid</li>"
          },
          "401": {
            "description": "<li>Authentication data missing or invalid</li>"
          }
        },
        "security": [
          {
            "Basic": []
          },
          {
            "JWT": []
          }
        ],
        "x-isRestricted": false
