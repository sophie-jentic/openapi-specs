    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/closebrothersretailb/Dealer-API/1.0.8-SNAPSHOT"
  },
  "host": "localhost:8722",
  "basePath": "/",
  "tags": [
    {
      "name": "DealerService",
      "description": "Dealer Service"
    }
  ],
  "paths": {
    "/dealer/v1/dealer-intelligence/{dealerId}": {
      "get": {
        "tags": [
          "DealerService"
        ],
        "summary": "Returns dealer-intelligence data by dealer ID.",
        "operationId": "getDealerInteligenceUsingGET",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "dealerId",
            "in": "path",
            "description": "dealerId",
            "required": true,
            "type": "string",
            "maxLength": 30,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Returns dealer intelligence data matching the specified dealer ID.",
            "schema": {
              "$ref": "#/definitions/DealerIntelligenceData"
            }
          },
          "404": {
            "description": "If no dealer intelligence data for the specified id exists"
          },
          "500": {
            "description": "If an unexpected error occurred."
          }
        }
      }
    },
    "/dealer/v1/dealer-metadata/{shortname}": {
      "get": {
        "tags": [
          "DealerService"
        ],
        "summary": "Returns dealer meta data by shortname. ",
        "operationId": "getDealerMetadata",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "shortname",
            "in": "path",
            "description": "shortname",
            "required": true,
            "type": "string",
            "maxLength": 15,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Returns dealer meta data matching the specified shortname.",
            "schema": {
              "$ref": "#/definitions/DealerMetadata"
            }
          },
          "404": {
            "description": "If shortName is not found."
          },
          "500": {
            "description": "If an unexpected error occurred."
          }
        }
      }
    },
    "/dealer/v1/dealers": {
      "get": {
        "tags": [
          "DealerService"
        ],
        "summary": "Returns a list of dealer summaries matching the specified criteria (accountManagerId or branchId). All dealers if criteria not specified. The list is empty if no match on criteria.",
        "operationId": "getDealerSummaryUsingGET",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "accountManagerId",
            "in": "query",
            "description": "Restricts the query by account manager id.",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 1
          },
          {
            "name": "branchId",
            "in": "query",
            "description": "Restricts the query by branch id.",
            "required": false,
            "type": "string",
            "maxLength": 30,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a list of dealer summaries matching the specified criteria.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/DealerSummary"
              }
            }
          },
          "422": {
            "description": "If both accountManagerId and branchId are specified."
          },
          "500": {
            "description": "If an unexpected error occurred."
          }
        }
      }
    },
    "/dealer/v1/dealers-details": {
      "get": {
        "tags": [
          "DealerService"
        ],
        "summary": "Returns dealer with branch and account manager details in single api call",
        "operationId": "getDealerDetailByDealerShortName",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "shortName",
            "in": "query",
            "description": "shortName",
            "required": true,
            "type": "string",
            "maxLength": 30,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the dealer detail with the given dealer shortname.",
            "schema": {
              "$ref": "#/definitions/Dealer"
            }
          },
          "404": {
            "description": "If no dealer with the given dealer shortname exists."
          },
          "500": {
            "description": "If an unexpected error occurred."
          }
        }
      }
    },
    "/dealer/v1/dealers/telephone/{telephoneNumber}": {
      "get": {
        "tags": [
          "DealerService"
        ],
        "summary": "Returns the details of the dealer with the given telephone number",
        "description": "If exactly one dealer has the given telephone number as a contact, it will be returned, else if exactly one dealer has the given telephone number as a primary contact, it will be returned, else if all dealers with this telephone number share the same parent group dealer, the parent group dealer will be returned.",
        "operationId": "findDealerByTelephoneNumberUsingGET",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "telephoneNumber",
            "in": "path",
            "description": "The phone number to search for. May be in UK or international format; may contain spaces.",
            "required": true,
            "type": "string",
            "maxLength": 30,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Returns single matching dealer for the specified telephone number.",
            "schema": {
              "$ref": "#/definitions/Dealer"
            }
          },
          "404": {
            "description": "If no dealer data found for the specified telephone number exists"
          },
          "500": {
            "description": "If an unexpected error occurred."
          }
        }
      }
    },
    "/dealer/v1/dealers/{dealerId}": {
      "get": {
        "tags": [
          "DealerService"
        ],
        "summary": "Returns dealer detail by dealer id.",
        "operationId": "getDealerById",
        "produces": [
          "*/*"
        ],
        "parameters": [
          {
            "name": "dealerId",
            "in": "path",
            "description": "dealerId",
            "required": true,
            "type": "string",
            "maxLength": 30,
            "minLength": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the dealer with the given id.",
            "schema": {
              "$ref": "#/definitions/Dealer"
            }
          },
          "404": {
            "description": "If no dealer with the given id exists."
          },
          "500": {
            "description": "If an unexpected error occurred."
          }
        }
      }
    },
