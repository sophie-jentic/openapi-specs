{
  "swagger": "2.0",
  "info": {
    "description": "API for retrieving Dealer details",
    "version": "1.0.8-SNAPSHOT",
    "title": "Dealer Service REST API",
    "termsOfService": "http://www.closemotorfinance.co.uk",
    "contact": {
      "name": "Close Brothers",
      "url": "http://www.closebrothers.com",
      "email": "support@closemotorfinance.co.uk"
    },
    "license": {
      "name": "MIT",
