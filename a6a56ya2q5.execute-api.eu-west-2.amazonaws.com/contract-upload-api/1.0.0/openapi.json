            "format": "double",
            "nullable": true
          },
          "standingCharge": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "availabilityCharge": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "estimatedAnnualConsumption": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "tariffCode": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          }
        }
      },
      "GasMeterPoint": {
        "type": "object",
        "required": [
          "mprn"
        ],
        "properties": {
          "mprn": {
            "type": "integer",
            "maxLength": 10
          },
          "annualQuantity": {
            "type": "integer",
            "nullable": true
          },
          "unitRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "standingCharge": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "tariffCode": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          }
        }
      }
    }
  }
}
