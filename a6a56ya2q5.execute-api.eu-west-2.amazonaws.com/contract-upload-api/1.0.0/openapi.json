{
  "openapi": "3.0.3",
  "info": {
    "title": "Contract Upload API",
    "version": "1.0.0",
    "description": "Upload contracts in JSON format and receive an ID plus any validation warnings.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/SeaglassCloud/contract-upload-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://a6a56ya2q5.execute-api.eu-west-2.amazonaws.com/test"
    }
  ],
  "paths": {
    "/integration/contractupload": {
      "post": {
        "summary": "Upload a contract payload",
        "operationId": "uploadContract",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractUploadRequest"
              },
              "examples": {
                "sample": {
                  "value": {
                    "tpiid": 4,
                    "productdefinition": "valdasmartchoicedd",
                    "businessStructure": "Limited Company",
                    "businessName": "Seaglass Cloud Technology",
                    "subBuildingName": "",
                    "buildingName": "Prama House",
                    "buildingNumber": "267",
                    "street": "Banbury Rd",
                    "locality": "",
                    "town": "Oxford",
                    "county": "",
                    "postCode": "OX2 7HT",
                    "limitedCompanyName": "Seaglass Cloud Technology Limited",
                    "limitedCompanyNumber": "11040036",
                    "charityRegistrationNumber": "",
                    "phoneNumber": "01865 339652",
                    "mobileNumber": "07736665826",
                    "email": "daniel.maitland@seaglasscloud.com",
                    "title": "Mr",
                    "firstName": "Daniel",
                    "surname": "Maitland",
                    "buildingNameHome": null,
                    "buildingNumberHome": null,
                    "streetHome": null,
                    "townHome": null,
                    "postCodeHome": null,
                    "addressHistory": "",
                    "dateofBirth": "1973-02-10",
                    "otherPartners": "",
                    "changeofTenancy": false,
                    "contractStartDate": "2025-11-01",
                    "contractMonths": 12,
                    "signedDate": "2025-10-07T10:00:00",
                    "soleDirectDebitAuthority": true,
                    "accountName": "Seaglass Cloud Technology Ltd",
                    "sortCode": "000000",
                    "accountNumber": "12345678",
                    "sites": [
                      {
                        "siteName": "Seaglass Cloud Technology",
                        "subBuildingName": "",
                        "buildingName": "Prama House",
                        "buildingNumber": "267",
                        "street": "Banbury Rd",
                        "locality": "",
                        "town": "Oxford",
                        "county": "",
                        "postCode": "OX2 7HT",
                        "elecMeterPoints": [
                          {
                            "mpanCore": 2000008535276,
                            "unitRate": 23.456,
                            "dayRate": null,
                            "nightRate": null,
                            "weekdayRate": null,
                            "eveningWeekendRate": null,
                            "eveningWeekendNightRate": null,
                            "offPeakRate": null,
                            "standingCharge": 56.78,
                            "availabilityCharge": null,
                            "estimatedAnnualConsumption": 25000,
                            "tariffCode": null
                          }
                        ],
                        "gasMeterPoints": [
                          {
                            "mprn": 1234567890,
                            "annualQuantity": 12000,
                            "unitRate": 12.345,
                            "standingCharge": 23.45,
                            "tariffCode": null
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created/accepted with warnings if any",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "id": 688,
                      "warnings": []
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "UploadResponse": {
        "type": "object",
        "required": [
          "id",
          "warnings"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Server-assigned identifier"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "ContractUploadRequest": {
        "type": "object",
        "required": [
          "tpiid",
          "productdefinition",
          "businessStructure",
          "businessName",
          "street",
          "town",
          "postCode",
          "mobileNumber",
          "email",
          "changeofTenancy",
          "contractMonths",
          "signedDate"
        ],
        "properties": {
          "tpiid": {
            "type": "integer",
            "description": "Third-party introducer ID"
          },
          "productdefinition": {
            "type": "string"
          },
          "businessStructure": {
            "type": "string",
            "description": "e.g., \"Sole Trader\", \"Limited Company\", \"Partnership\", \"Limited Liability Partnership\""
          },
          "businessName": {
            "type": "string",
            "maxLength": 200
          },
          "subBuildingName": {
            "type": "string",
            "nullable": true,
            "maxLength": 30
          },
          "buildingName": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          },
          "buildingNumber": {
            "type": "string",
            "nullable": true,
            "maxLength": 4
          },
          "street": {
            "type": "string",
            "maxLength": 80
          },
          "locality": {
            "type": "string",
            "nullable": true,
            "maxLength": 35
          },
          "town": {
            "type": "string",
            "maxLength": 30
          },
          "county": {
            "type": "string",
            "nullable": true,
            "maxLength": 30
          },
          "postCode": {
            "type": "string",
            "maxLength": 8
          },
          "limitedCompanyName": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "limitedCompanyNumber": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          },
          "charityRegistrationNumber": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          },
          "mobileNumber": {
            "type": "string",
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          },
          "surname": {
            "type": "string",
            "maxLength": 100
          },
          "buildingNameHome": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          },
          "buildingNumberHome": {
            "type": "string",
            "nullable": true,
            "maxLength": 4
          },
          "streetHome": {
            "type": "string",
            "nullable": true,
            "maxLength": 80
          },
          "townHome": {
            "type": "string",
            "nullable": true,
            "maxLength": 30
          },
          "postCodeHome": {
            "type": "string",
            "nullable": true,
            "maxLength": 8
          },
          "addressHistory": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "dateofBirth": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "otherPartners": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "changeofTenancy": {
            "type": "boolean"
          },
          "contractStartDate": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "contractMonths": {
            "type": "integer",
            "maximum": 99
          },
          "signedDate": {
            "type": "string",
            "format": "date-time"
          },
          "soleDirectDebitAuthority": {
            "type": "boolean",
            "nullable": true
          },
          "accountName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "description": "Required if soleDirectDebitAuthority is true"
          },
          "sortCode": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{6}$",
            "description": "Required if soleDirectDebitAuthority is true (6 digits, no dashes)"
          },
          "accountNumber": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{8}$",
            "description": "Required if soleDirectDebitAuthority is true (8 digits)"
          },
          "sites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Site"
            },
            "minItems": 1
          }
        }
      },
      "Site": {
        "type": "object",
        "required": [
          "siteName",
          "street",
          "town",
          "postCode"
        ],
        "properties": {
          "siteName": {
            "type": "string",
            "maxLength": 200
          },
          "subBuildingName": {
            "type": "string",
            "nullable": true,
            "maxLength": 30
          },
          "buildingName": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          },
          "buildingNumber": {
            "type": "string",
            "nullable": true,
            "maxLength": 4
          },
          "street": {
            "type": "string",
            "maxLength": 80
          },
          "locality": {
            "type": "string",
            "nullable": true,
            "maxLength": 35
          },
          "town": {
            "type": "string",
            "maxLength": 30
          },
          "county": {
            "type": "string",
            "nullable": true,
            "maxLength": 30
          },
          "postCode": {
            "type": "string",
            "maxLength": 8
          },
          "elecMeterPoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ElecMeterPoint"
            }
          },
          "gasMeterPoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GasMeterPoint"
            }
          }
        }
      },
      "ElecMeterPoint": {
        "type": "object",
        "required": [
          "mpanCore"
        ],
        "properties": {
          "mpanCore": {
            "type": "integer",
            "maxLength": 13,
            "description": "13-digit MPAN core"
          },
          "unitRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "dayRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "nightRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "weekdayRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "eveningWeekendRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "eveningWeekendNightRate": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "offPeakRate": {
