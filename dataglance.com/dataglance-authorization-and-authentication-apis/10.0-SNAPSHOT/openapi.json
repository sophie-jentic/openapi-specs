{
  "openapi": "3.1.0",
  "info": {
    "title": "Dataglance Authorization and Authentication APIs",
    "description": "This page lists all the rest apis for User Authorization and Authentication for your enviroment.",
    "contact": {
      "name": "Dataglance",
      "url": "https://www.dataglance.com/",
      "email": "adminsupport@dataglance.com"
    },
    "version": "10.0-SNAPSHOT",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/aminiz/dataglance-authorization-and-authentication-apis/10.0-SNAPSHOT"
  },
  "servers": [
    {
      "url": "http://34.214.115.206:8080/dg-oauth2-server",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "tags": [
          "oauth-2-authorization-controller"
        ],
        "operationId": "authenticateUser",
        "parameters": [
          {
            "name": "trace.id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginQuery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/user": {
      "get": {
        "tags": [
          "dg-principal-user-controller"
        ],
        "operationId": "getUser",
        "parameters": [
          {
            "name": "trace.id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/check_token": {
      "get": {
        "tags": [
          "oauth-2-authorization-controller"
        ],
        "operationId": "checktoken",
        "parameters": [
          {
            "name": "trace.id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginQuery": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "name": "bearerAuth",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}