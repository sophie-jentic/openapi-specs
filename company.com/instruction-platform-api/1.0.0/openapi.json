          "process\\_code": {
            "type": "string"
          },
          "version\\_number": {
            "type": "integer"
          },
          "file\\_url": {
            "type": "string"
          },
          "file\\_size": {
            "type": "integer"
          },
          "file\\_hash": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "archived"
            ]
          },
          "created\\_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated\\_at": {
            "type": "string",
            "format": "date-time"
          },
          "change\\_comment": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page\\_size": {
            "type": "integer"
          },
          "total\\_pages": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "\u041d\u0435 \u0430\u0432\u0442\u043e\u0440\u0438\u0437\u043e\u0432\u0430\u043d"
      },
      "BadRequest": {
        "description": "\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0437\u0430\u043f\u0440\u043e\u0441\u0430"
      },
      "NotFound": {
        "description": "\u0420\u0435\u0441\u0443\u0440\u0441 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d"
      }
    }
  }
}