    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "No autenticado o token inv\u00e1lido (401).",
        "content": {
          "application/json": {
            "examples": {
              "Error401": {
                "value": {
                  "message": "Unauthenticated."
                }
              }
            }
          }
        }
      },
      "ForbiddenError": {
        "description": "El usuario autenticado no tiene permisos para esta acci\u00f3n (403).",
        "content": {
          "application/json": {
            "examples": {
              "Error403": {
                "value": {
                  "message": "This action is unauthorized."
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso no encontrado (404).",
        "content": {
          "application/json": {
            "examples": {
              "Error404": {
                "value": {
                  "message": "The requested resource was not found."
                }
              }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Error de validaci\u00f3n de los datos (422).",
        "content": {
          "application/json": {
            "examples": {
              "Error422": {
                "value": {
                  "message": "The given data was invalid.",
                  "errors": {
                    "name": [
                      "The name field is required."
                    ],
                    "email": [
                      "The email has already been taken."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
