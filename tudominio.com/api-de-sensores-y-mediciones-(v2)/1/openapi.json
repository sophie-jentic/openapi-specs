{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Sensores y Mediciones (V2)",
    "version": "1",
    "description": "API para el registro y consulta de datos de sensores provenientes de PLCs, con l\u00edmites integrados en la entidad Sensor.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/PABLOINGEGNIERI1/TechPro/1"
  },
  "servers": [
    {
      "url": "https://api.tudominio.com/v1"
    }
  ],
  "tags": [
    {
      "name": "Autenticaci\u00f3n",
      "description": "Endpoints de gesti\u00f3n de acceso (Login, Logout)."
    },
    {
      "name": "Usuarios",
      "description": "Gesti\u00f3n de usuarios del sistema (ABMC)."
    },
    {
      "name": "Zonas",
      "description": "Gesti\u00f3n de \u00e1reas f\u00edsicas de los sensores (ABMC)."
    },
    {
      "name": "Sensores",
      "description": "Gesti\u00f3n de los dispositivos de medici\u00f3n, incluyendo sus l\u00edmites (ABMC)."
    },
    {
      "name": "Mediciones",
      "description": "Registro y consulta de los datos brutos de los sensores."
    },
    {
      "name": "Alarmas",
      "description": "Registro y consulta de las incidencias por valores fuera de l\u00edmite."
    }
  ],
  "security": [
    {
      "BearerToken": []
    }
  ],
  "paths": {
    "/api/auth/token": {
      "post": {
        "tags": [
          "Autenticaci\u00f3n"
        ],
        "summary": "Login de Usuario y Obtenci\u00f3n de Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              },
              "examples": {
                "LoginCorrecto": {
                  "value": {
                    "email": "user@plc.com",
                    "password": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token de acceso generado exitosamente.",
            "content": {
              "application/json": {
                "examples": {
                  "TokenGenerado": {
                    "value": {
                      "token": "1|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                      "token_type": "Bearer"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "security": [
          {
            "BearerToken": []
          }
        ],
        "tags": [
          "Autenticaci\u00f3n"
        ],
        "summary": "Revoca el token de acceso actual (Logout)",
        "responses": {
          "204": {
            "description": "Token revocado exitosamente (Sin contenido)."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/api/auth/password": {
      "patch": {
        "security": [
          {
            "BearerToken": []
          }
        ],
        "tags": [
          "Autenticaci\u00f3n"
        ],
        "summary": "Cambia la contrase\u00f1a del usuario autenticado",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "current_password": {
                    "type": "string"
                  },
                  "new_password": {
                    "type": "string"
                  },
                  "new_password_confirmation": {
                    "type": "string"
                  }
                },
                "required": [
                  "current_password",
                  "new_password",
                  "new_password_confirmation"
                ]
              },
              "examples": {
                "CambioDeClave": {
                  "value": {
                    "current_password": "password123",
                    "new_password": "NewSecurePassword456",
                    "new_password_confirmation": "NewSecurePassword456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contrase\u00f1a actualizada exitosamente.",
            "content": {
              "application/json": {
                "examples": {
                  "Exito": {
                    "value": {
                      "message": "Password updated successfully."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
