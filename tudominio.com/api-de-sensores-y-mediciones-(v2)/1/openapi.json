  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Zone": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "zone_id": {
            "type": "integer",
            "description": "ID de la zona a la que pertenece el sensor."
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Tipo de medici\u00f3n que registra el sensor (e.g.",
            "Temperatura": null,
            "Ruido).": null
          },
          "max_value": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "L\u00edmite m\u00e1ximo para esta medici\u00f3n."
          },
          "min_value": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "L\u00edmite m\u00ednimo para esta medici\u00f3n."
          }
        }
      },
      "Measurement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "sensor_id": {
            "type": "integer"
          },
          "value": {
            "type": "number",
            "format": "float"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Alarm": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "measurement_id": {
            "type": "integer",
            "description": "ID de la medici\u00f3n que dispar\u00f3 la alarma."
          },
          "sensor_id": {
            "type": "integer"
          },
          "limit_value": {
            "type": "number",
            "format": "float",
            "description": "El valor del l\u00edmite que fue excedido."
          },
          "limit_exceeded_type": {
            "type": "string",
            "enum": [
              "MAX",
              "MIN"
            ],
            "description": "Indica si se excedi\u00f3 el l\u00edmite **M\u00c1XIMO** o **M\u00cdNIMO**."
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "acknowledged"
            ]
          },
          "triggered_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
