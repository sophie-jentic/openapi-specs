    "/v1/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get current authenticated user",
        "description": "Returns the full profile of the currently authenticated user, including subscription, roles, permissions, and settings.",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "app_id",
            "in": "query",
            "description": "Application bundle/package ID (used to update token's application association)",
            "schema": {
              "type": "string",
              "example": "com.bayyinah.ayah_by_ayah"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "description": "Platform identifier: ios or android",
            "schema": {
              "type": "string",
              "enum": [
                "ios",
                "android"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                },
                "example": {
                  "success": true,
