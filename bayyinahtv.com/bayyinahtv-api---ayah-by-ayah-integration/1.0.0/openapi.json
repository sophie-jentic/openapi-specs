{
  "openapi": "3.0.3",
  "info": {
    "title": "BayyinahTV API - Ayah by Ayah Integration",
    "description": "API documentation for integrating Ayah by Ayah with BayyinahTV authentication system.\n\n## Authentication\nAll authenticated endpoints require a JWT token in the `Authorization` header:\n```\nAuthorization: Bearer <token>\n```\n\n## Application Identifiers\n| App | Platform | Bundle/Package ID |\n|-----|----------|-------------------|\n| Bayyinah TV | iOS | com.bayyinahapp.btv |\n| Bayyinah TV | Android | com.zombiesoup.bayyinah |\n\nExample for Ayah by Ayah: `com.bayyinah.ayah_by_ayah`\n\n## Device Limits\nUsers have a maximum number of devices they can be logged in on simultaneously.\nThe limit varies per user (e.g. based on subscription plan). When a login or register\nrequest causes the user to exceed their device limit, the response will include a\n`device_cleanup` object at the top level with `requires_cleanup: true`. The client\nshould then prompt the user to remove devices before proceeding.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Bayyinah Team"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/altinmaloku/bayyinahtv-api-ayah-by-ayah-integration/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.bayyinahtv.com",
      "description": "Production"
    },
    {
      "url": "https://dev.api.bayyinahtv.com",
      "description": "Development"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "User authentication endpoints (register, login, logout, profile)"
    }
  ],
  "paths": {
    "/v1/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "description": "Creates a new user account and returns a JWT token for immediate authentication.\n\nThe `app_id` and `platform` fields are used to associate the created token with a\nspecific application. This is used for device tracking and cleanup.\n",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "first_name": "John",
                "last_name": "Doe",
                "phone_country_code": "+1",
                "phone_number": "1234567890",
                "email": "user@example.com",
                "password": "password123",
                "app_id": "com.bayyinah.ayah_by_ayah",
                "platform": "ios",
                "device_name": "iPhone 14",
                "device_identifier": "a1b2c3d4-e5f6-7890"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSuccessResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...",
                    "user": {
                      "id": 12345,
                      "first_name": "John",
                      "last_name": "Doe",
                      "full_name": "John Doe",
                      "email": "user@example.com",
                      "phone_country_code": "+1",
                      "phone_number": "1234567890",
                      "phone": "+1 1234567890",
                      "pending_email": null,
                      "social_providers": [],
                      "active": true,
                      "has_affiliate": false,
                      "trial_ends_at": null,
                      "allow_older_versions": false,
                      "block_commenting_until": null,
                      "can_comment": true,
                      "verified": false,
                      "email_verified_at": null,
                      "completed": false,
                      "birthday": null,
                      "address": null,
                      "state": null,
                      "country": null,
                      "timezone": null,
                      "post_code": null,
                      "lat": null,
                      "lng": null,
                      "avatar": null,
                      "last_login_at": null,
                      "last_login_ip": null,
                      "roles": [],
                      "permissions": [],
                      "subscribed": false,
                      "device_limit": 5,
                      "subscription": null,
                      "shared_subscription": null,
                      "settings": {
                        "autoplay": true,
                        "notifications": true
                      },
                      "active_promo_code": null,
                      "prompt_dismissed_at": null
                    }
                  },
                  "message": "",
                  "device_cleanup": {
                    "requires_cleanup": false,
                    "limit": 5,
                    "active_count": 1,
                    "current_device_id": 101,
                    "devices": [
                      {
                        "id": 101,
                        "name": "iPhone 14",
                        "device_name": "iPhone 14",
                        "device_identifier": "a1b2c3d4-e5f6-7890",
                        "user_agent": "AyahByAyah/1.0 iOS/17.0",
                        "login_ip": "203.0.113.1",
                        "is_current": true,
                        "is_expired": false,
                        "requires_cleanup": false,
                        "last_used_at": "2024-01-15T10:30:00+00:00",
                        "created_at": "2024-01-15T10:30:00+00:00",
                        "expires_at": "2024-02-14T10:30:00+00:00",
                        "application": {
                          "id": 3,
                          "name": "Ayah by Ayah",
                          "platform": "ios"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "success": false,
                  "data": {},
                  "message": "The given data was invalid.",
                  "code": 422,
                  "errors": {
                    "email": [
                      "The email has already been taken."
                    ],
                    "phone_country_code": [
                      "The phone country code field is required."
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login an existing user",
        "description": "Authenticates a user with email and password, returns a JWT token.\n\nThe `app_id` and `platform` fields are used to associate the created token with a\nspecific application. This is used for device tracking and cleanup.\n\n**Device Limits:** Users have a configurable limit on simultaneous logged-in devices.\nWhen this limit is exceeded, the `device_cleanup` object in the response will have\n`requires_cleanup: true` along with the list of active devices. The client should\nprompt the user to revoke sessions from other devices.\n",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "user@example.com",
                "password": "password123",
                "app_id": "com.bayyinah.ayah_by_ayah",
                "platform": "ios",
                "device_name": "iPhone 14",
