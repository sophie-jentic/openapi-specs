{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "mEHR Service",
    "description": "mEHR is a micro intelligence module (mim) that runs on mimOE to surface\nlocally stored clinical data from upstream EHR systems/connectors.\nThis service:\n  - fetches and persists consolidated EHR payloads using edis,\n  - persists document metadata and download URLs, and\n  - exposes a simple protected interface for clients on the edge.\n",
    "contact": {
      "name": "mimik",
      "url": "https://mimik.com/",
      "email": "support@mimik.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/mimik-edge/mehr/1.0.0"
  },
  "basePath": "/mehr/v1",
  "responses": {
    "400": {
      "description": "Bad input parameter",
      "schema": {
        "$ref": "#/definitions/BadRequest"
      }
    },
    "403": {
      "description": "Forbidden request",
      "schema": {
        "$ref": "#/definitions/Forbidden"
      }
    },
    "404": {
      "description": "Resource Not found",
      "schema": {
        "$ref": "#/definitions/NotFound"
      }
    },
    "405": {
      "description": "Method not allowed",
      "schema": {
        "$ref": "#/definitions/MethodNotAllowed"
      }
    },
    "409": {
      "description": "Resource already exists",
      "schema": {
        "$ref": "#/definitions/Conflict"
      }
    },
    "500": {
      "description": "System error",
      "schema": {
        "$ref": "#/definitions/ServerError"
      }
    }
  },
  "tags": [
    {
      "name": "EHR",
      "description": "Stores consolidated EHR payloads retrieved from upstream connectors."
    },
    {
      "name": "Documents",
      "description": "Stores clinical documents and download URLs."
    },
    {
      "name": "Sync",
      "description": "Sync status and provenance with upstream EHR sources."
    }
  ],
  "securityDefinitions": {
    "UserSecurity": {
      "type": "oauth2",
      "flow": "implicit",
      "authorizationUrl": "https://mimik.com/authorize",
      "scopes": {
        "document:list": "list patient documents",
        "document:url": "get signed document URLs",
        "fhir:consolidated": "start consolidated queries",
        "fhir:status": "read consolidated query status"
      }
    },
    "APIKeySecurity": {
      "type": "apiKey",
      "in": "header",
      "name": "x-api-key"
    }
  },
  "paths": {
    "/patients/{patientId}/ehr": {
      "parameters": [
        {
          "name": "patientId",
          "in": "path",
          "description": "Id of the user",
          "required": true,
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "EHR"
        ],
        "summary": "Get stored EHR bundle",
        "description": "Returns the latest consolidated EHR payload for the patient that is stored locally after retrieval from upstream EHR sources.\n",
        "security": [
          {
            "APIKeySecurity": []
          },
          {
            "UserSecurity": [
              "fhir:consolidated"
            ]
          }
        ],
        "x-swagger-router-controller": "ehrController",
        "operationId": "getEhrData",
        "parameters": [
          {
            "name": "conversionType",
            "in": "query",
            "description": "Preferred conversion of the stored payload.",
            "required": false,
            "type": "string",
            "enum": [
              "json",
              "pdf",
              "html"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Stored EHR payload",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "$ref": "#/definitions/EhrBundle"
                }
              }
            },
            "examples": {
              "application/json": {
                "data": {
                  "patientId": "13150247-8788-4e0e-9a81-9bb09b11c376",
                  "status": "completed",
                  "conversionType": "json",
                  "requestId": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9",
                  "payload": {
                    "resourceType": "Bundle",
                    "type": "searchset",
                    "entry": [
                      {
                        "resource": {
                          "resourceType": "Patient",
                          "id": "019b0a0e-4467-7a1f-90f8-c23b7722c201",
                          "gender": "female",
                          "birthDate": "1996-02-10"
                        }
                      }
                    ]
                  },
                  "storedAt": "2026-01-15T20:09:21Z",
                  "sourceRequest": {
                    "patientId": "13150247-8788-4e0e-9a81-9bb09b11c376",
                    "requestId": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9",
                    "fetchedAt": "2026-01-15T20:09:21Z"
                  }
                }
              }
            }
          },
          "202": {
            "description": "Consolidated query started; payload not yet ready",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "$ref": "#/definitions/EhrBundle"
                }
              }
            },
            "examples": {
              "application/json": {
                "data": {
                  "patientId": "13150247-8788-4e0e-9a81-9bb09b11c376",
                  "status": "processing",
                  "conversionType": "json",
                  "requestId": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9",
                  "storedAt": "2026-01-15T20:09:21Z",
                  "sourceRequest": {
                    "patientId": "13150247-8788-4e0e-9a81-9bb09b11c376",
                    "requestId": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9",
                    "fetchedAt": "2026-01-15T20:09:21Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "403": {
            "$ref": "#/responses/403"
          },
          "404": {
            "$ref": "#/responses/404"
          },
          "500": {
            "$ref": "#/responses/500"
          }
        }
      },
      "delete": {
        "tags": [
          "EHR"
        ],
        "summary": "Clear cached EHR data",
        "description": "Removes locally cached EHR bundle for the patient. The next GET request will fetch fresh data from upstream EHR sources.\n",
        "security": [
          {
            "APIKeySecurity": []
          },
          {
            "UserSecurity": [
              "fhir:consolidated"
            ]
          }
        ],
        "x-swagger-router-controller": "ehrController",
        "operationId": "deleteEhrData",
        "responses": {
          "204": {
            "description": "Cache cleared successfully"
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "403": {
            "$ref": "#/responses/403"
          },
          "500": {
            "$ref": "#/responses/500"
          }
        }
      }
    },
    "/patients/{patientId}/documents": {
      "parameters": [
        {
          "name": "patientId",
          "in": "path",
          "description": "Id of the user",
          "required": true,
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "List stored patient documents",
        "description": "Lists documents stored locally after retrieval from upstream EHR sources.\n",
        "security": [
          {
            "APIKeySecurity": []
          },
          {
            "UserSecurity": [
              "document:list"
            ]
          }
        ],
        "x-swagger-router-controller": "documentController",
        "operationId": "listDocuments",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by logical document type.",
            "required": false,
            "type": "string",
            "enum": [
              "ccd",
              "cda",
              "pdf",
              "html",
              "txt",
              "other"
            ]
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of documents to return (default 50, max 100).",
            "required": false,
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of documents to skip for pagination.",
            "required": false,
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Document list",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/PatientDocument"
                  }
                },
                "pagination": {
                  "$ref": "#/definitions/PaginationMeta"
                }
              }
            },
            "examples": {
              "application/json": {
                "data": [
                  {
                    "fileName": "ccd_2025-10-12_001.xml",
                    "type": "ccd",
                    "sizeBytes": 204800,
                    "createdAt": "2025-10-12T09:10:00Z",
                    "updatedAt": "2025-10-12T09:10:00Z",
                    "source": "HIE-North",
                    "storedAt": "2025-11-08T22:45:10Z",
                    "expiresAt": "2025-11-09T22:45:10Z",
                    "availableUrls": [
                      "original",
                      "html"
                    ],
                    "sourceRequest": {
                      "patientId": "2695334462234642354",
                      "requestId": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9",
                      "fetchedAt": "2025-11-08T22:40:00Z"
                    }
                  }
                ],
                "pagination": {
                  "limit": 50,
                  "offset": 0,
                  "total": 1,
                  "hasMore": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "403": {
            "$ref": "#/responses/403"
          },
          "404": {
            "$ref": "#/responses/404"
          },
          "500": {
            "$ref": "#/responses/500"
          }
        }
      },
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Clear cached documents list",
        "description": "Removes locally cached document list and metadata for the patient. The next GET request will fetch fresh data from upstream EHR sources.\n",
        "security": [
          {
            "APIKeySecurity": []
          },
          {
            "UserSecurity": [
              "document:list"
            ]
          }
        ],
        "x-swagger-router-controller": "documentController",
        "operationId": "deleteDocuments",
        "responses": {
          "204": {
            "description": "Cache cleared successfully"
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "403": {
            "$ref": "#/responses/403"
          },
          "500": {
            "$ref": "#/responses/500"
          }
        }
      }
    },
    "/patients/{patientId}/documents/{fileName}/url": {
      "parameters": [
        {
          "name": "patientId",
          "in": "path",
          "description": "Id of the user",
          "required": true,
          "type": "string"
        },
        {
          "name": "fileName",
          "in": "path",
          "description": "Name of the stored document",
          "required": true,
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get document access URL",
        "description": "Returns a stored or freshly refreshed download URL for the requested document. The service may reuse a locally stored URL or refresh it from the configured upstream EHR connector.\n",
        "security": [
          {
            "APIKeySecurity": []
          },
          {
            "UserSecurity": [
              "document:url"
            ]
          }
        ],
        "x-swagger-router-controller": "documentController",
        "operationId": "getDocumentUrl",
        "parameters": [
          {
            "name": "conversionType",
            "in": "query",
            "description": "Optional conversion; when provided, the service will return a URL for the converted asset if available (e.g. html or pdf).",
            "required": false,
            "type": "string",
            "enum": [
              "html",
              "pdf"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Download URL",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "$ref": "#/definitions/DocumentAccessUrl"
                }
              }
            },
            "examples": {
              "application/json": {
                "data": {
                  "url": "https://storage.example.com/download/abc?exp=1700000000",
                  "conversionType": "pdf",
                  "storedAt": "2025-11-08T22:47:00Z",
                  "expiresAt": "2025-11-08T23:17:00Z",
                  "sourceRequest": {
                    "patientId": "2695334462234642354",
                    "requestId": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9",
                    "fetchedAt": "2025-11-08T22:40:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "403": {
            "$ref": "#/responses/403"
          },
          "404": {
            "$ref": "#/responses/404"
          },
          "500": {
            "$ref": "#/responses/500"
          }
        }
      }
    },
    "/patients/{patientId}/sync-status": {
      "parameters": [
        {
          "name": "patientId",
          "in": "path",
          "description": "Id of the user",
          "required": true,
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "Sync"
        ],
        "summary": "Get latest sync status",
        "description": "Returns the latest progress details from upstream EHR document and consolidated data queries for this patient.\n",
        "security": [
          {
            "APIKeySecurity": []
          },
          {
            "UserSecurity": [
              "fhir:status"
            ]
          }
        ],
        "x-swagger-router-controller": "syncController",
        "operationId": "getSyncStatus",
        "responses": {
          "200": {
            "description": "Sync status",
            "schema": {
              "type": "object",
              "properties": {
                "data": {
                  "$ref": "#/definitions/SyncStatus"
                }
              }
            },
            "examples": {
              "application/json": {
                "data": {
                  "patientId": "2695334462234642354",
                  "documentQuery": {
                    "requestId": "9f35a9c2-1c9f-4f2f-9e60-9d34c2f8a1b3",
                    "download": {
                      "status": "processing",
                      "total": 12,
                      "successful": 10,
                      "errors": 2
                    },
                    "createdAt": "2025-11-08T22:32:00Z",
                    "updatedAt": "2025-11-08T22:33:00Z"
                  },
                  "consolidatedQuery": {
                    "requestId": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9",
                    "status": "completed",
                    "conversionType": "json",
                    "startedAt": "2025-11-08T22:40:00Z",
                    "createdAt": "2025-11-08T22:40:00Z",
                    "updatedAt": "2025-11-08T22:41:30Z",
                    "resources": [
                      "Observation",
                      "MedicationRequest"
                    ],
                    "dateFrom": "2025-10-01",
                    "dateTo": "2025-10-31"
                  },
                  "lastSyncedAt": "2025-11-08T22:47:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/responses/400"
          },
          "403": {
            "$ref": "#/responses/403"
          },
          "404": {
            "$ref": "#/responses/404"
          },
          "500": {
            "$ref": "#/responses/500"
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "description": "Must be the same as the HTTP status code."
        },
        "message": {
          "type": "string",
          "description": "A human readable code"
        }
      }
    },
    "BadRequest": {
      "type": "object",
      "description": "Bad input parameter",
      "allOf": [
        {
          "$ref": "#/definitions/Error"
        }
      ],
      "example": {
        "code": 400,
        "message": "Bad input parameter"
      }
    },
    "Forbidden": {
      "type": "object",
      "description": "Forbidden request",
      "allOf": [
        {
          "$ref": "#/definitions/Error"
        }
      ],
      "example": {
        "code": 403,
        "message": "forbidden"
      }
    },
    "NotFound": {
      "type": "object",
      "description": "Resource Not found",
      "allOf": [
        {
          "$ref": "#/definitions/Error"
        }
      ],
      "example": {
        "code": 404,
        "message": "resource not found"
      }
    },
    "MethodNotAllowed": {
      "type": "object",
      "description": "Method not allowed",
      "allOf": [
        {
          "$ref": "#/definitions/Error"
        }
      ],
      "example": {
        "code": 405,
        "message": "path /xyz/1234 defined in Swagger specification, but the method POST is not defined"
      }
    },
    "Conflict": {
      "type": "object",
      "description": "Resource already exists",
      "allOf": [
        {
          "$ref": "#/definitions/Error"
        }
      ],
      "example": {
        "code": 409,
        "message": "resource already exists"
      }
    },
    "ServerError": {
      "type": "object",
      "description": "System error",
      "allOf": [
        {
          "$ref": "#/definitions/Error"
        }
      ],
      "example": {
        "code": 500,
        "message": "Internal error while processing request"
      }
    },
    "PaginationMeta": {
      "type": "object",
      "description": "Pagination metadata for list responses.",
      "properties": {
        "limit": {
          "type": "integer",
          "description": "Maximum number of items per page.",
          "example": 50
        },
        "offset": {
          "type": "integer",
          "description": "Number of items skipped.",
          "example": 0
        },
        "total": {
          "type": "integer",
          "description": "Total number of items available.",
          "example": 150
        },
        "hasMore": {
          "type": "boolean",
          "description": "Whether more items are available beyond this page.",
          "example": true
        }
      }
    },
    "SourceContext": {
      "type": "object",
      "description": "Provenance information for locally stored resources from upstream EHR sources.",
      "properties": {
        "patientId": {
          "type": "string",
          "description": "Upstream patient identifier used in the source system.",
          "example": "2695334462234642354"
        },
        "requestId": {
          "type": "string",
          "description": "Request identifier for the upstream call.",
          "format": "uuid",
          "example": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9"
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time",
          "example": "2025-11-08T22:40:00Z"
        }
      }
    },
    "PatientDocument": {
      "type": "object",
      "description": "Locally stored representation of a document retrieved from an upstream EHR source.",
      "required": [
        "fileName",
        "type",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "example": "ccd_2025-10-12_001.xml"
        },
        "type": {
          "type": "string",
          "description": "Logical document type",
          "enum": [
            "ccd",
            "cda",
            "pdf",
            "html",
            "txt",
            "other"
          ],
          "example": "ccd"
        },
        "sizeBytes": {
          "type": "integer",
          "example": 204800
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2025-10-12T09:10:00Z"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "example": "2025-10-12T09:10:00Z"
        },
        "source": {
          "type": "string",
          "example": "HIE-North"
        },
        "storedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the document metadata persisted locally.",
          "example": "2025-11-08T22:45:10Z"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expiry time of the stored download URL, if available.",
          "example": "2025-11-09T22:45:10Z"
        },
        "availableUrls": {
          "type": "array",
          "description": "Conversion types for which an access URL is available locally.",
          "items": {
            "type": "string",
            "enum": [
              "original",
              "html",
              "pdf"
            ]
          }
        },
        "sourceRequest": {
          "$ref": "#/definitions/SourceContext"
        }
      }
    },
    "DocumentAccessUrl": {
      "type": "object",
      "description": "Access details for a stored or refreshed document URL.",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "example": "https://storage.example.com/download/abc?exp=1700000000"
        },
        "conversionType": {
          "type": "string",
          "enum": [
            "original",
            "html",
            "pdf"
          ],
          "example": "original"
        },
        "storedAt": {
          "type": "string",
          "format": "date-time",
          "example": "2025-11-08T22:47:00Z"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "example": "2025-11-08T23:17:00Z"
        },
        "sourceRequest": {
          "$ref": "#/definitions/SourceContext"
        }
      }
    },
    "EhrBundle": {
      "type": "object",
      "description": "Locally stored consolidated EHR bundle retrieved from an upstream EHR source.",
      "required": [
        "patientId",
        "status",
        "conversionType",
        "storedAt"
      ],
      "properties": {
        "patientId": {
          "type": "string",
          "description": "Id of the user",
          "example": "2695334462234642354"
        },
        "status": {
          "type": "string",
          "enum": [
            "processing",
            "completed",
            "failed"
          ],
          "example": "completed"
        },
        "conversionType": {
          "type": "string",
          "enum": [
            "json",
            "pdf",
            "html"
          ],
          "example": "json"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "description": "Underlying upstream request id for the consolidated query.",
          "example": "0f2ac2d6-6caf-44fd-95f3-040e9aed80c9"
        },
        "payload": {
          "type": "object",
          "description": "Consolidated clinical payload (FHIR JSON when `conversionType` is `json`); omitted for non-JSON conversions.\n",
          "additionalProperties": true
        },
        "contentUrl": {
          "type": "string",
          "format": "uri",
          "description": "Local URL for stored binary content (pdf/html).",
          "example": "http://localhost:8083/mehr/v1/files/0f2ac2d6.pdf"
        },
        "storedAt": {
          "type": "string",
          "format": "date-time",
          "example": "2025-11-08T22:45:10Z"
        },
        "sourceRequest": {
          "$ref": "#/definitions/SourceContext"
        }
      }
    },
    "DocumentQueryProgress": {
      "type": "object",
      "required": [
        "requestId",
        "createdAt",
        "updatedAt"
