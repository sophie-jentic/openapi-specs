{
  "openapi": "3.0.3",
  "info": {
    "title": "PrestaShop Web Service API",
    "description": "PrestaShop Web Service API provides CRUD access to a PrestaShop store's database. Supports XML (default) and JSON output formats. Resources follow REST conventions at /api/{resource_name} for collections and /api/{resource_name}/{id} for individual items. Supports filtering, sorting, pagination, and field selection via query parameters.",
    "version": "1.0.0",
    "contact": {
      "name": "PrestaShop",
      "url": "https://devdocs.prestashop-project.org/8/webservice/"
    },
    "x-jentic-source-url": "https://devdocs.prestashop-project.org/8/webservice/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "{shopUrl}/api",
      "description": "PrestaShop store Web Service endpoint",
      "variables": {
        "shopUrl": {
          "default": "https://your-shop.example.com",
          "description": "Base URL of your PrestaShop installation"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "listResources",
        "summary": "List available resources",
        "description": "Returns a list of all available web service resources with their permission indicators (get, put, post, patch, delete, head) and schema links.",
        "tags": ["Discovery"],
        "parameters": [
          {
            "name": "output_format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["JSON"],
              "default": "JSON"
            },
            "description": "Output format. Default is XML."
          }
        ],
        "responses": {
          "200": {
            "description": "List of available resources",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid API key"
          }
        }
      }
    },
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List products",
        "description": "Retrieves a list of products from the store.",
        "tags": ["Products"],
        "parameters": [
          {
            "$ref": "#/components/parameters/display"
          },
          {
            "$ref": "#/components/parameters/filter"
          },
          {
            "$ref": "#/components/parameters/sort"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/language"
          },
          {
            "$ref": "#/components/parameters/outputFormat"
          }
        ],
        "responses": {
          "200": {
            "description": "Product list",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createProduct",
        "summary": "Create a product",
        "description": "Creates a new product. Request body must be in XML format.",
        "tags": ["Products"],
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": {
                "type": "object",
                "description": "Product XML structure. Use schema=blank to get the required structure."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Product created"
          },
          "400": {
            "description": "Bad Request - validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Get a product",
        "description": "Retrieves a specific product by ID.",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Product ID"
          },
