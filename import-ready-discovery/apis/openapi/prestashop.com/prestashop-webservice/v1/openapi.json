        "scheme": "basic",
        "description": "HTTP Basic Authentication. Use your API key as the username and leave the password empty. The recommended approach is to send an Authorization header with Base64-encoded credentials."
      }
    },
    "parameters": {
      "display": {
        "name": "display",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Fields to display. Use 'full' for all fields, or bracket notation like '[id,name,price]' for specific fields."
      },
      "filter": {
        "name": "filter",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Filter criteria. Format: filter[field]=[value]. Supports operators: [value1|value2] (OR), [value1,value2] (range), [value]% (LIKE)."
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Sort field and direction. Format: [field_ASC] or [field_DESC]."
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Limit results. Format: 'count' or 'offset,count' (e.g. '0,100')."
      },
      "language": {
        "name": "language",
        "in": "query",
        "schema": {
          "type": "integer"
        },
        "description": "Language ID for multi-language fields."
      },
      "outputFormat": {
        "name": "output_format",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": ["JSON"]
        },
        "description": "Set to 'JSON' for JSON output. Default is XML."
      }
    }
