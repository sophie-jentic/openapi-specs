        "summary": "Get a paginated list of cat facts",
        "parameters": [
          {
            "name": "max_length",
            "in": "query",
            "required": false,
            "description": "Maximum length of the returned facts",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of facts per page (default varies)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for pagination",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
