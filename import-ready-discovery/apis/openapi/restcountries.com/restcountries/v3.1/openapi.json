{
  "openapi": "3.0.3",
  "info": {
    "title": "REST Countries API",
    "description": "Get information about countries via a RESTful API. No authentication required. Returns data including name, capital, region, languages, currencies, population, and more.",
    "version": "3.1.0",
    "x-jentic-source-url": "https://restcountries.com/",
