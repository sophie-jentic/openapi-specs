  "paths": {
    "/all": {
      "get": {
        "operationId": "getAllCountries",
        "summary": "Get all countries",
        "description": "Retrieve information about all countries. The fields parameter is required (max 10 fields).",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "required": true,
            "description": "Comma-separated list of fields to return (max 10).",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of country objects.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Country" }
                }
              }
            }
          },
          "400": { "description": "Bad request - fields parameter missing or exceeds limit." }
        }
      }
    },
    "/name/{name}": {
      "get": {
        "operationId": "getCountryByName",
        "summary": "Search country by name",
        "description": "Search for countries by common or official name.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "fullText",
            "in": "query",
            "required": false,
            "description": "Set to true to search by exact full name.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of matching countries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Country" }
                }
              }
            }
          },
          "404": { "description": "Country not found." }
        }
      }
    },
