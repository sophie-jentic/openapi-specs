{
  "openapi": "3.0.3",
  "info": {
    "title": "FB API – Organization & Identity Service",
    "version": "1.0.0",
    "description": "CREATE-only APIs for Organization and Identity.\nBoth create and modify endpoints are CREATE-only and stateless.\nSecured using OAuth2 JWT with scope-based authorization.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ASITPA_1/fb-api-organization-identity-service/1.0.0"
  },
  "servers": [
    {
      "url": "https://ssceo2839i.execute-api.eu-west-2.amazonaws.com",
      "description": "AWS API Gateway (EU-West-2)"
    }
  ],
  "security": [
    {
      "OAuth2": [
        "m2m-api-resources/write"
      ]
    }
  ],
  "paths": {
    "/api/v1/organizations/create": {
      "post": {
        "tags": [
          "Organization"
        ],
        "summary": "Create Organization(s)",
        "description": "CREATE-only operation for organizations",
        "security": [
          {
            "OAuth2": [
              "m2m-api-resources/write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModifyOrganizationWrapper"
              },
              "examples": {
                "createOrganizations": {
                  "summary": "Create organizations",
                  "value": {
                    "ModifyOrganizationRequest": [
                      {
                        "TARGET_SYSTEM_USERNAME": "MUITST21",
                        "DATETIME_STAMP": "2026-02-02",
                        "ORIGINATOR": "CWK",
                        "TYPE_OF_ORG": "3P",
                        "EFF_STATUS": "A",
                        "DESCR50": "Infosys",
                        "PREFERRED_SUPPLIER": "Y",
                        "BT_THIRD_PARTY_IND": "8D3",
                        "COUNTRY": "GBR",
                        "CITY": "Aldersgate",
                        "ORGANIZATION_NAME": "8D3",
                        "SupplierCODE": "1NYS",
                        "GROUP_LIST": [
                          {
                            "BT_CONTRACT_NUM": "TEST00012",
                            "DEFAULT_FLG": "N",
                            "START_DATE": "2025-11-01",
                            "END_DATE": "2033-11-30",
                            "GROUP_NAME": "CONTRACT-8D3-TEST00012",
                            "BT_THIRD_PARTY_IND": "8D3",
                            "UGP_UDF_GROUP_TYPE": "CONTRACT"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Organizations created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/modify": {
      "post": {
        "tags": [
          "Organization"
        ],
        "summary": "Modify Organization(s)",
        "description": "Retained for backward compatibility (CREATE-only)",
        "security": [
          {
            "OAuth2": [
              "m2m-api-resources/write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModifyOrganizationWrapper"
              },
              "examples": {
                "modifyOrganizations": {
                  "summary": "Modify organizations (treated as create)",
                  "value": {
                    "ModifyOrganizationRequest": [
                      {
                        "TARGET_SYSTEM_USERNAME": "MUITST21",
                        "DESCR50": "Mangalyaan",
                        "BT_THIRD_PARTY_IND": 294,
                        "COUNTRY": "GBR",
                        "CITY": "Bristol",
                        "ORGANIZATION_NAME": 294
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Organizations processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/create": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Create User Identity",
        "description": "CREATE-only operation for user identities",
        "security": [
          {
            "OAuth2": [
              "m2m-api-resources/write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModifyIdentityWrapper"
              },
              "examples": {
                "createIdentity": {
                  "summary": "Create user identity",
                  "value": {
                    "ModifyIdentityRequest": [
                      {
                        "TARGET_SYSTEM_USERNAME": "hrsfmui1",
                        "User_ID": "500014722",
                        "BT_HI_WS_TYPE": "IdentityUpdate",
                        "BT_HI_WS_SUB_TYPE": "Update-Current",
                        "DATETIME_STAMP": "2025-05-25 16:01:07",
                        "LOCATION": "NRT-N1",
                        "FIRST_NAME": "PChange14620",
                        "LAST_NAME": "NCh14620",
                        "JOBCODE": "TMNE3",
                        "DEPTID": "BOI114",
                        "EMPL_STATUS": "A",
                        "BT_WORK_MODE_CD": "FE",
                        "BT_THIRD_PARTY_IND": "A00",
                        "NEE_PROVIDER_ID": "1360"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identities processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/modify": {
      "post": {
        "tags": [
          "Identity"
        ],
        "summary": "Modify User Identity",
        "description": "Retained for backward compatibility (CREATE-only)",
        "security": [
          {
            "OAuth2": [
              "m2m-api-resources/write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModifyIdentityWrapper"
              },
              "examples": {
                "modifyIdentity": {
                  "summary": "Modify identity (treated as create)",
                  "value": {
                    "ModifyIdentityRequest": [
                      {
                        "User_ID": "500014722",
                        "FIRST_NAME": "PChange14620",
                        "LAST_NAME": "NCh14620",
                        "EMPL_STATUS": "A"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identities processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth2 JWT using client-credentials flow",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.com/oauth/token",
            "scopes": {
              "m2m-api-resources/write": "Write access to FB APIs"
            }
          }
        }
      }
    },
    "schemas": {
      "ModifyOrganizationWrapper": {
        "type": "object",
        "properties": {
          "ModifyOrganizationRequest": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModifyOrganizationRequest"
            }
          }
        }
      },
      "ModifyOrganizationRequest": {
        "type": "object",
        "additionalProperties": true
      },
      "GroupContract": {
        "type": "object",
        "additionalProperties": true
      },
      "ModifyIdentityWrapper": {
        "type": "object",
        "properties": {
          "ModifyIdentityRequest": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModifyIdentityRequest"
            }
          }
        }
      },
      "ModifyIdentityRequest": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
