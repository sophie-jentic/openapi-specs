{
  "swagger": "2.0",
  "info": {
    "description": "This API specification is used to standardize the interface for browsing files and folders.",
    "version": "1.0.0",
    "title": "An API for browsing files and folders",
    "contact": {
      "name": "Cubic Digital Intelligence",
      "url": "https://www.cubic.com/cubic-digital-intelligence",
      "email": "cdisupport@cubic.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/DANGLEVU/an-api-for-browsing-files-and-folders/1.0.0"
  },
  "basePath": "/filebrowse/",
  "tags": [
    {
      "name": "Browse",
      "description": "Operations related to browsing files and folders"
    }
  ],
  "schemes": [
    "http",
    "https"
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Browse"
        ],
        "summary": "Retrieves the list of entries in a folder",
        "description": "If the 'folder' parameter is empty, then the list of configured root folders will be returned.  The 'includefiles' and 'includefolders' paramaters are ignored if 'folder' is empty.",
        "operationId": "getFolderEntries",
        "produces": [
          "application/json",
          "text/xml"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/format"
          },
          {
            "$ref": "#/parameters/start"
          },
          {
            "$ref": "#/parameters/length"
          },
          {
            "$ref": "#/parameters/folder"
          },
          {
            "$ref": "#/parameters/includefiles"
          },
          {
            "$ref": "#/parameters/includefolders"
          },
          {
            "$ref": "#/parameters/subfolders"
          },
          {
            "$ref": "#/parameters/match"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of entries in the folder",
            "schema": {
              "$ref": "#/definitions/entryCollection"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "entryCollection": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "description": "Total number of entries in the result set (may exceed 'length')."
        },
        "start": {
          "type": "integer",
          "description": "Zero based index into the result set of the first entry returned."
        },
        "length": {
          "type": "integer",
          "description": "The number of entries returned."
        },
        "entries": {
          "type": "array",
          "description": "An array containing the file results.",
          "items": {
            "$ref": "#/definitions/entry"
          }
        }
      },
      "example": {
        "entries": [
          {
            "path": "path1",
            "folder": false,
            "size": 5,
            "lastmodified": "lastmodified",
            "name": "name1"
          },
          {
            "path": "path2",
            "folder": true,
            "size": 0,
            "lastmodified": "lastmodified",
            "name": "name2"
          }
        ],
        "count": 4,
        "start": 6,
        "length": 2
      }
    },
    "entry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The filename without the path."
        },
        "path": {
          "type": "string",
          "description": "The complete file/path."
        },
        "permissions": {
          "type": "string",
          "description": "The configured permissions for this entry."
        },
        "lastmodified": {
          "type": "string",
          "description": "The last modified timestamp for the file.  In the form: MM-DD-YYYY HH:MM:SS."
        },
        "size": {
          "type": "integer",
          "description": "The size of the file in bytes."
        },
        "folder": {
          "type": "boolean",
          "description": "True if this entry represents a folder name and not a file."
        }
      },
      "example": {
        "name": "E",
        "path": "E:/",
        "permissions": "rwd",
        "lastmodified": "",
        "size": 0,
        "folder": true
      }
    }
  },
  "parameters": {
    "id": {
      "name": "id",
      "in": "path",
      "description": "The id of a catalog",
      "required": true,
      "type": "string"
    },
    "start": {
      "name": "start",
      "in": "query",
      "description": "The zero-based start index of the response data",
      "required": false,
      "type": "integer",
      "default": 0
    },
    "length": {
      "name": "length",
      "in": "query",
      "description": "Defines the maximum number or results retruned by the API",
      "required": false,
      "type": "integer"
    },
    "format": {
      "name": "format",
      "in": "query",
      "description": "Response format 'xml' or 'json'",
      "required": false,
      "type": "string",
      "default": "json"
    },
    "folder": {
      "name": "folder",
      "in": "query",
      "description": "The folder to query",
      "required": false,
      "type": "string",
      "default": ""
    },
    "includefiles": {
      "name": "includefiles",
      "in": "query",
      "description": "Whether to include files in the response",
      "required": false,
      "type": "boolean",
      "default": true
    },
    "includefolders": {
      "name": "includefolders",
      "in": "query",
      "description": "Whether to include folders in the response",
      "required": false,
      "type": "boolean",
      "default": true
    },
    "match": {
      "name": "match",
      "in": "query",
      "description": "Defines a list of wildcards to match against.  Multiple values should be separated with a semi-colon (e.g. '*.tif;*.ntf').",
      "required": false,
      "type": "string",
      "default": "*.*"
    },
    "subfolders": {
      "name": "subfolders",
      "in": "query",
      "description": "Whether to recursively explore subfolders and include their entries in the response",
      "required": false,
      "type": "boolean",
      "default": false
    }
  }
}