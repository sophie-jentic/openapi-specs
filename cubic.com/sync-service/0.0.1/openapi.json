{
  "openapi": "3.1.1",
  "info": {
    "title": "SYNC Service",
    "summary": "A service for synchronizing data",
    "version": "0.0.1",
    "contact": {
      "name": "Cubic Digital Intelligence",
      "url": "https://www.cubic.com/cubic-digital-intelligence",
      "email": "cdisupport@cubic.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/DANGLEVU/sync-service/0.0.1"
  },
  "servers": [
    {
      "url": "/{basePath}",
      "description": "Relative server URL with an variable base path",
      "variables": {
        "basePath": {
          "default": "sync",
          "description": "The base path where this service is hosted relative to the server"
        }
      }
    },
    {
      "url": "{scheme}://{host}/{basePath}",
      "description": "A templated server URL",
      "variables": {
        "scheme": {
          "default": "https",
          "description": "Scheme/protocol of the server",
          "enum": [
            "http",
            "https"
          ]
        },
        "host": {
          "default": "localhost",
          "description": "Hostname or IP of the server"
        },
        "basePath": {
          "default": "sync",
          "description": "Optional base path where the service is hosted"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Submission",
      "description": "Operations related to submitting data for synchronization (outbound)"
    },
    {
      "name": "Disposition",
      "description": "Operations related to approving/rejecting data that has been synchronized (inbound)"
    },
    {
      "name": "Support",
      "description": "Operations related to providing service support"
    }
  ],
  "paths": {
    "/outbound/submissions": {
      "get": {
        "tags": [
          "Submission"
        ],
        "summary": "Retrieves the list of submissions",
        "responses": {
          "200": {
            "$ref": "#/components/responses/submissionsResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      },
      "post": {
        "tags": [
          "Submission"
        ],
        "summary": "Submits data for synchronization",
        "requestBody": {
          "description": "The data to submit for synchronization",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/submissionRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/submissionResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/outbound/submissions/{submissionId}": {
      "get": {
        "tags": [
          "Submission"
        ],
        "summary": "Retrieves a submission",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionIdPath"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/submissionResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/outbound/collections": {
      "get": {
        "tags": [
          "Submission"
        ],
        "summary": "Retrieves the list of collections",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionIdQuery"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/collectionsResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/outbound/collections/{collectionId}": {
      "get": {
        "tags": [
          "Submission"
        ],
        "summary": "Retrieves a collection",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionIdPath"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/collectionResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/outbound/files": {
      "get": {
        "tags": [
          "Submission"
        ],
        "summary": "Retrieves the list of files",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionIdQuery"
          },
          {
            "$ref": "#/components/parameters/collectionIdQuery"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/filesResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/outbound/files/{fileId}": {
      "get": {
        "tags": [
          "Submission"
        ],
        "summary": "Retrieves a file",
        "parameters": [
          {
            "$ref": "#/components/parameters/fileIdPath"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/fileResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/inbound/submissions": {
      "get": {
        "tags": [
          "Disposition"
        ],
        "summary": "Retrieves the list of submissions",
        "responses": {
          "200": {
            "$ref": "#/components/responses/submissionsResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/inbound/submissions/{submissionId}": {
      "get": {
        "tags": [
          "Disposition"
        ],
        "summary": "Retrieves a submission",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionIdPath"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/submissionResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/inbound/collections/": {
      "get": {
        "tags": [
          "Disposition"
        ],
        "summary": "Retrieves the list of collections",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionIdQuery"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/collectionsResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/inbound/collections/{collectionId}": {
      "get": {
        "tags": [
          "Disposition"
        ],
        "summary": "Retrieves a collection",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionIdPath"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/collectionResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/inbound/collections/{collectionId}/decision": {
      "post": {
        "tags": [
          "Disposition"
        ],
        "summary": "Approve or reject a delivered item for further processing",
        "parameters": [
          {
            "$ref": "#/components/parameters/collectionIdPath"
          }
        ],
        "requestBody": {
          "description": "The approval/rejection decision",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/collectionDecisionRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/collectionDecisionResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/inbound/collection-decisions": {
      "post": {
        "tags": [
          "Disposition"
        ],
        "summary": "Bulk approval and rejection decisions to determine whether delivered items should receive further processing",
        "requestBody": {
          "description": "The decisions",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/bulkDecisionsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The decision response - individual entries will be marked with whether they were accepted or not.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/bulkDecisionsResponse"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/inbound/files": {
      "get": {
        "tags": [
          "Disposition"
        ],
        "summary": "Retrieves the list of files",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionIdQuery"
          },
          {
            "$ref": "#/components/parameters/collectionIdQuery"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/filesResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/inbound/files/{fileId}": {
      "get": {
        "tags": [
          "Disposition"
        ],
        "summary": "Retrieves a file",
        "parameters": [
          {
            "$ref": "#/components/parameters/fileIdPath"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/fileResponse"
          },
          "4XX": {
            "$ref": "#/components/responses/errorResponse"
          },
          "default": {
            "$ref": "#/components/responses/errorResponse"
          }
        }
      }
    },
    "/api": {
      "get": {
        "tags": [
          "Support"
        ],
        "summary": "Returns the API for the service",
        "responses": {
          "200": {
            "description": "The API for the service (this document)",
            "content": {
              "application/vnd.oai.openapi+json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "submission": {
        "type": "object",
        "description": "Basic information about a submission",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "name": {
            "type": "string",
            "description": "Name for the submission assigned by the user"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When the submission was created"
          },
          "user_metadata": {
            "type": "string",
            "description": "User provided metadata associated with the submission"
          },
          "data_type": {
            "type": "string",
            "description": "The type of data that this submission includes"
          },
          "submitter": {
            "type": "string",
            "description": "The submitting user"
          }
        }
      },
      "submissions": {
        "type": "object",
        "properties": {
          "submissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/submission"
            }
          }
        }
      },
      "collection": {
        "type": "object",
        "description": "An inseparable collection of files that is part of a collection",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "submission_id": {
            "type": "string",
            "description": "Unique identifer of the submission with which this collection is associated"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "description": "When the collection was created"
          },
          "modified": {
            "type": "string",
            "format": "date-time",
            "description": "When the collection was last modified"
          },
          "reviewer": {
            "type": "string",
            "description": "The user that reviewed the submission"
          },
          "reviewed": {
            "type": "string",
            "format": "date-time",
            "description": "When the collection was reviewed"
          },
          "state": {
            "type": "string",
            "enum": [
              "Error",
              "Preparing",
              "Submitted",
              "Pending",
              "Rejected",
              "Deleting",
              "Deleted",
              "Approved",
              "Ingesting",
              "Ingested",
              "Withdrawing",
              "Withdrawn"
            ],
            "description": "Current state of the collection"
          },
          "item_number": {
            "type": "integer",
            "description": "The unique number of this collection within the submission"
          }
        }
      },
      "collections": {
        "type": "object",
        "properties": {
          "collections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/collection"
            }
          }
        }
      },
      "file": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier"
          },
          "submission_id": {
            "type": "string",
            "description": "ID of the submission with which the file is associated"
          },
          "collection_id": {
            "type": "string",
            "description": "ID of the collection with which the file is associated"
          },
          "uri": {
            "type": "string",
            "description": "URI of the file"
          },
          "size": {
            "type": "integer",
            "description": "Size of the file in bytes"
          },
          "replacement_name": {
            "type": "string",
            "description": "Alternative name for the file"
          },
          "filename": {
            "type": "string",
            "description": "Name of the file (includes extension, excludes preceeding path)"
          },
          "checksum": {
            "type": "string",
            "description": "Checksum of the file at the time of submission"
          },
          "validated": {
            "type": "boolean",
            "description": "Whether the file has been validated"
          },
          "validation_error": {
            "type": "string",
            "description": "Description of any validation errors"
          },
          "bytes_transferred": {
            "type": "integer",
            "description": "Number of bytes that have been transferred"
          }
        }
      },
      "files": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/file"
            }
          }
        }
      },
      "submissionRequestBody": {
        "type": "object",
        "description": "The request body when posting a submission",
        "required": [
          "name",
          "items"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name for the submission assigned by the user"
          },
          "user_metadata": {
            "type": "string",
            "description": "User provided metadata associated with the submission"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/submissionBodyItem"
            }
          }
        }
      },
      "submissionBodyItem": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Location of the item"
          }
        }
      },
      "collectionStateUpdate": {
        "type": "string",
        "enum": [
          "Approved",
          "Rejected"
        ]
      },
      "collectionDecisionRequestBody": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "$ref": "#/components/schemas/collectionStateUpdate"
          }
        }
      },
      "collectionDecisionResponseBody": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the collection"
          },
          "status": {
            "type": "string",
            "enum": [
              "Succeeded",
              "Failed"
            ],
            "description": "Whether the decision was accepted successfully"
          },
          "message": {
            "type": "string",
            "description": "The description for the response to the decision"
          }
        }
      },
      "bulkDecisionsBody": {
        "type": "object",
        "properties": {
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/bulkDecisionEntry"
            }
          }
        }
      },
      "bulkDecisionEntry": {
        "type": "object",
        "required": [
          "id",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the collection"
          },
          "decision": {
            "$ref": "#/components/schemas/collectionStateUpdate"
          }
        }
      },
      "bulkDecisionsResponse": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "description": "The total number of decisions processed"
              },
              "succeeded": {
                "type": "integer",
                "description": "The number of decisions that were accepted successfully"
              },
              "failed": {
                "type": "integer",
                "description": "The number of decisions that were unable to be accepted"
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/collectionDecisionResponseBody"
            }
          }
        }
      },
      "errorResponse": {
        "type": "object",
        "description": "Provides information about why a request failed",
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable identifier of the error",
                "example": "not_found"
              },
              "message": {
                "type": "string",
                "description": "Human-readable summary of the error",
                "example": "The specified item(s) could not be found."
              },
              "details": {
                "type": "string",
                "description": "More specific explanation of the error",
                "example": "Item 'some.ntf' could not be found."
              }
            }
          }
        }
      }
    },
    "parameters": {
      "limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of entries to return in one response",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        }
      },
      "cursor": {
        "name": "cursor",
        "in": "query",
        "description": "An opaque offset into the entry list",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "description": "Sort order. Comma-separated fields. Prefix a field with '-' for descending. Example: '-receivedAt,id'. If omitted, defaults to '-receivedAt,id'.",
        "required": false,
        "schema": {
          "type": "string",
          "default": "-receivedAt,id",
          "examples": [
            "-receivedAt,id",
            "reviewStatus,-receivedAt,id"
          ]
        }
      },
      "submissionIdPath": {
        "name": "submissionId",
        "in": "path",
        "description": "The ID of a particular submission",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "submissionIdQuery": {
        "name": "submissionId",
        "in": "query",
        "description": "The ID of a particular submission",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "collectionIdPath": {
        "name": "collectionId",
        "in": "path",
        "description": "The ID of a particular collection",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "collectionIdQuery": {
        "name": "submissionId",
        "in": "query",
        "description": "The ID of a particular collection",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "fileIdPath": {
        "name": "fileId",
        "in": "path",
        "description": "The ID of a particular file",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "deliveryId": {
        "name": "deliveryId",
        "in": "path",
        "description": "The ID of a particular delivered item",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "submissionsResponse": {
        "description": "A successful request for the list of submissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/submissions"
            }
          }
        }
      },
      "submissionResponse": {
        "description": "The submission was accepted for processing",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/submission"
            }
          }
        }
      },
      "collectionsResponse": {
        "description": "A successful request for the list of collections associated with a submission",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/collections"
            }
          }
        }
      },
      "collectionResponse": {
        "description": "A successful request for a collection",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/collection"
            }
          }
        }
      },
      "filesResponse": {
        "description": "A successful request for the list of files",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/files"
            }
          }
        }
      },
      "fileResponse": {
        "description": "A successful request for a file",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/file"
            }
          }
        }
      },
      "collectionDecisionResponse": {
        "description": "A successful decision response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/collectionDecisionResponseBody"
            }
          }
        }
      },
      "errorResponse": {
        "description": "An error occurred",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/errorResponse"
            }
          }
        }
      }
    }
  }
}