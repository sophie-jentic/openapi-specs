{
  "openapi": "3.0.2",
  "info": {
    "title": "eOSCAR services API - Auth.",
    "description": "<h3>Auth provides authentication for all eoscar-services.</h3>",
    "termsOfService": "https://www.e-oscar.org/news/terms-of-use",
    "contact": {
      "name": "Support Form",
      "url": "https://app.smartsheet.com/b/form/7ac657bd7d374fbeadf830501fb97b33"
    },
    "license": {
