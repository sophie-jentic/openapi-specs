        "type": "object",
        "properties": {
          "uname": {
            "maxLength": 20,
            "type": "string",
            "example": "APIUSER"
          },
          "pwd": {
            "type": "string",
            "example": "blue0913"
          },
          "regId": {
            "maxLength": 7,
            "type": "integer",
            "format": "int32",
            "example": 1000126
          }
        },
        "xml": {
          "name": "authRequest"
        }
      },
      "AuthChangePwdRequestVo": {
        "title": "AuthChangePwdRequest",
        "required": [
          "newPwd",
          "pwd",
          "regId",
          "uname"
        ],
        "type": "object",
        "properties": {
          "uname": {
            "maxLength": 20,
            "type": "string",
            "example": "APIUSER"
          },
          "pwd": {
            "type": "string",
            "example": "blue0913"
          },
          "newPwd": {
            "type": "string",
            "example": "blue09132@"
          },
          "regId": {
            "maxLength": 7,
            "type": "integer",
            "format": "int32",
            "example": 1000126
          }
