{
  "openapi": "3.0.1",
  "info": {
    "title": "Innovex Cards Orders API",
    "description": "API para la gestión de órdenes y consulta de balances de cuentas dentro de la plataforma **Innovex Cards**.  \n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/one2many/innovex-cards-orders-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://2wudkobdx2.execute-api.us-east-1.amazonaws.com/{basePath}",
      "variables": {
        "basePath": {
          "default": "Dev"
        }
      }
    }
  ],
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "summary": "Obtener órdenes",
        "description": "Retorna la lista de órdenes realizadas por un usuario, filtradas por el `accountIdentifier`.\n",
        "parameters": [
          {
            "name": "accountIdentifier",
            "in": "query",
            "required": true,
            "description": "Identificador único de la cuenta para obtener sus órdenes.",
            "schema": {
              "type": "string",
              "example": "A78561964"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Órdenes obtenidas exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parámetro faltante o inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Falta el Api Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseApi"
                },
                "example": {
                  "message": "Forbidden"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear una nueva orden",
        "description": "Crea una orden de tarjeta de regalo .   Requiere autenticación mediante `x-api-key`.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              },
              "example": {
                "accountIdentifier": "A78561964",
                "amount": 300,
                "customerIdentifier": "testgroup",
                "emailSubject": "Test Innovex 010",
                "externalRefID": "GESTOPAGO10",
                "message": "Test Innovex message",
                "recipient": {
                  "email": "example@gmail.com",
                  "firstName": "Name",
                  "lastName": "LastName"
                },
                "sendEmail": true,
                "sender": {
                  "email": "admin@innovexcards.com",
                  "firstName": "Admin",
                  "lastName": "Innovex Cards"
                },
                "product_code": "UBR-01-MXN-V"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Orden creada exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                },
                "example": {
                  "referenceOrderID": "RA251028-160312-91",
                  "referenceLineItemID": "RA251028-160312-91-1",
                  "externalRefID": "GESTOPAGO11",
                  "customerIdentifier": "clientGroup01",
                  "accountIdentifier": "A78562001",
                  "accountNumber": "A78562001",
                  "amountCharged": {
                    "value": 500,
                    "currencyCode": "MXN",
                    "total": 500
                  },
                  "denomination": {
                    "value": 500,
                    "currencyCode": "MXN"
                  },
                  "rewardName": "Tarjeta de Regalo de Uber",
                  "sender": {
                    "firstName": "Carlos",
                    "lastName": "Innovex Cards",
                    "email": "carlos@innovexcards.com"
                  },
                  "recipient": {
                    "firstName": "Ana",
                    "lastName": "López",
                    "email": "ana.lopez@example.com",
                    "mobileNumber": null,
                    "address": null
                  },
                  "emailSubject": "Test Innovex 011",
                  "message": "Test Innovex order message",
                  "sendEmail": true,
                  "deliveryMethod": "EMAIL",
                  "etid": "E000001",
                  "status": "COMPLETE",
                  "orderStatus": "COMPLETE",
                  "lineItemStatus": "COMPLETE",
                  "createdAt": "2025-10-28T21:30:45.200Z",
                  "reward": {
                    "credentials": {
                      "Código de Seguridad (Security Code)": "A9BX72QK",
                      "URL de Canje (Redemption URL)": "https://sandbox.rewardcodes.com/r2/1/aG5oH2DmxMEXcTJxKi3axmZQqxAv0rtAkqI0-NEWURL"
                    },
                    "credentialList": [
                      {
                        "label": "Código de Seguridad (Security Code)",
                        "value": "A9BX72QK",
                        "type": "text",
                        "credentialType": "rewardSecurityCode"
                      },
                      {
                        "label": "URL de Canje (Redemption URL)",
                        "value": "https://sandbox.rewardcodes.com/r2/1/aG5oH2DmxMEXcTJxKi3axmZQqxAv0rtAkqI0-NEWURL",
                        "type": "url"
                      }
                    ],
                    "credentialType": "rewardSecurityUrl",
                    "redemptionInstructions": ""
                  },
                  "partner": "Tango",
                  "product_code": "UBR-01-MXN-V"
                }
              }
            }
          },
          "400": {
            "description": "Error en la validación o datos faltantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Validation error",
                  "message": "Missing required field: accountIdentifier",
                  "statusCode": 400
                }
              }
            }
          },
          "500": {
            "description": "Error interno o fallo en servicios externos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Internal server error",
                  "message": "Error conectando a la base de datos",
                  "statusCode": 500
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountIdentifier}": {
      "get": {
        "summary": "Consultar balance de cuenta",
        "description": "Obtiene el balance de una cuenta específica.   Se puede incluir el monto y el parámetro `balance_switch` para activar o desactivar la verificación.\n",
        "parameters": [
          {
            "name": "accountIdentifier",
            "in": "path",
            "required": true,
            "description": "Identificador único de la cuenta.",
            "schema": {
              "type": "string",
              "example": "A58780832"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "description": "Monto a verificar contra el balance disponible.",
            "schema": {
              "type": "number",
              "example": 300
            }
          },
          {
            "name": "balance_switch",
            "in": "query",
            "required": false,
            "description": "Activa (`true`) o desactiva (`false`) la verificación de saldo.",
            "schema": {
              "type": "boolean",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Balance obtenido exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                },
                "example": {
                  "accountIdentifier": "A78561964",
                  "currentBalance": 5000,
                  "currency": "MXN"
                }
              }
            }
          },
          "400": {
            "description": "Error en la solicitud o parámetros faltantes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Validation error",
                  "message": "Se requiere el monto a verificar",
                  "statusCode": 400
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Database connection error",
                  "message": "Error conectando a la base de datos",
                  "statusCode": 500
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    },
    "schemas": {
      "OrderRequest": {
        "type": "object",
        "required": [
          "accountIdentifier",
          "amount",
          "customerIdentifier",
          "externalRefID",
          "recipient",
          "sender",
          "utid"
        ],
        "properties": {
          "accountIdentifier": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "customerIdentifier": {
            "type": "string"
          },
          "emailSubject": {
            "type": "string"
          },
          "externalRefID": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recipient": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              },
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              }
            }
          },
          "sendEmail": {
            "type": "boolean"
          },
          "sender": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              },
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              }
            }
          },
          "utid": {
            "type": "string"
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "BalanceResponse": {
        "type": "object",
        "properties": {
          "accountIdentifier": {
            "type": "string"
          },
          "currentBalance": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "ErrorResponseApi": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string",
            "nullable": true
          },
          "statusCode": {
            "type": "integer"
          }
        }
      }
    }
  }
}
