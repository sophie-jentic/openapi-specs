    "title": "Charitas APIs for AI Agent Integration",
    "description": "This is the Charitas API for AI AGent Integration based on the OpenAPI 3.1 specification.",
    "contact": {
      "email": "support@bizcube.com.sg"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/bizcube/CharitasAIAgentAPI/1.0.0"
