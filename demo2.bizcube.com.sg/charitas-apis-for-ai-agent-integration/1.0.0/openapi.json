  "components": {
    "schemas": {
      "QueryDonorParams": {
        "type": "object",
        "properties": {
          "SearchRefID": {
            "type": "string",
            "description": "String to track each unique search request",
            "maxLength": 500,
            "examples": [
              "guid"
            ]
          },
          "DonFilter_Name": {
            "type": "string",
            "description": "Name filter string, wildcards supported",
            "maxLength": 200,
            "examples": [
              "",
              "%paul%"
            ]
          },
          "DonFilter_EntityType": {
            "type": "string",
            "description": "This filter can only be empty string or \"I\" (for individual records) or \"O\" (for organisation records)",
            "maxLength": 1,
            "enum": [
              "I",
              "O"
            ],
            "examples": [
              "O"
            ]
          },
          "DonFilter_DonDateFrom": {
            "type": "string",
            "description": "Filter donations from this start date",
            "format": "date",
            "examples": [
              "2020-01-01"
            ]
          },
          "DonFilter_DonDateTo": {
            "type": "string",
            "description": "Filter donations from this end date inclusive - includes donations made on this end date.",
            "format": "date",
            "examples": [
              "2026-01-01"
            ]
          },
          "DonFilter_DonCampaignCode": {
            "type": "string",
            "description": "Filter donations recorded for specific campaign code",
            "maxLength": 200,
            "examples": [
              "",
              "Online Donation",
              "Year end mailer"
            ]
          },
          "DonFilter_IncludeOneTimeDon": {
            "type": "integer",
            "description": "1 for including one-time donations, 0 for excluding one-time donations",
            "enum": [
              1,
              0
            ],
            "examples": [
              1,
              0
            ]
          },
          "DonFilter_IncludeRecurringDon": {
            "type": "integer",
            "description": "1 for including recurring donations, 0 for excluding recurring donations",
            "enum": [
              1,
              0
            ],
            "examples": [
              1,
              0
            ]
          },
          "DonAmtInFilter_From": {
            "type": "number",
            "description": "Filter for records with filtered total donation amount greater or equal to this value",
            "examples": [
              0
            ]
          },
          "DonAmtInFilter_To": {
            "type": "number",
            "description": "Filter for records with filtered total donation amount less than or equal to this value",
            "examples": [
              5000
            ]
          },
          "DonAmtLifetime_From": {
            "type": "number",
            "description": "Filter for records with lifetime total donation amount greater or equal to this value",
            "examples": [
              0
            ]
          },
          "DonAmtLifetime_To": {
            "type": "number",
            "description": "Filter for records with lifetime total donation amount less than or equal to this value",
            "examples": [
              10000
            ]
          },
          "ResultsFromLastPersonID": {
            "type": "number",
            "description": "For pagination support, return records after this last PersonID received in a previous API call.",
            "examples": [
              100
            ]
          }
        }
      },
