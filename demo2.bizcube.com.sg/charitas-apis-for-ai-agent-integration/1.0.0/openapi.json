  "servers": [
    {
      "url": "https://demo2.bizcube.com.sg/newcharitasdemo"
    }
  ],
  "paths": {
    "/Ext.Ctc1.AIAgent_Search_Donor.json": {
      "post": {
        "summary": "Query donor information from server",
        "description": "Call this endpoint to get donor data from server",
        "operationId": "AIAgent_Search_Donor",
        "requestBody": {
          "description": "Retrieve donor data based on the parameters given",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryDonorParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful operation request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse200"
                }
              }
            }
          },
          "403": {
            "description": "An error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse403"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "api_key": [
              "TestKeyChangeInProd"
            ]
          }
        ]
      }
    },
    "/Ext.Ctc1.AIAgent_Search_Volunteer.json": {
