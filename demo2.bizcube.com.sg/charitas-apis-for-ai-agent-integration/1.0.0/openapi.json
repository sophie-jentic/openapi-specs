                  ""
                ]
              },
              "RetData": {
                "type": "object",
                "description": "Data returned",
                "properties": {
                  "Tbl": {
                    "type": "object",
                    "properties": {
                      "Rows": {
                        "type": "array",
                        "items": null,
                        "oneOf": [
                          {
