      "SuccessResponse200": {
        "type": "object",
        "properties": {
          "d": {
            "type": "object",
            "description": "Return object",
            "properties": {
              "RetVal": {
                "type": "integer",
                "description": "-1 indicates sucessful operation",
                "examples": [
                  -1
                ]
              },
