{
  "openapi": "3.0.3",
  "info": {
    "title": "Red Dot Payment API",
    "description": "API specification for SALE/AUTH and CAPTURE/VOID transactions.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/KHOIRKAMALUDIN/API2/1.0.0"
  },
  "servers": [
    {
      "url": "https://secure-dev.reddotpayment.com/service/payment-api",
      "description": "UAT - SALE/AUTH"
    },
    {
      "url": "https://secure.reddotpayment.com/service/payment-api",
      "description": "Production - SALE/AUTH"
    },
    {
      "url": "https://test.reddotpayment.com/instanpanel/api/payment",
      "description": "UAT - CAPTURE/VOID"
    },
    {
      "url": "https://connect.reddotpayment.com/instanpanel/api/payment",
      "description": "Production - CAPTURE/VOID"
    }
  ],
  "paths": {
    "/sale-auth": {
      "post": {
        "summary": "SALE / AUTH Transaction",
        "description": "Perform Sale or Authorization transaction.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaleAuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaleAuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/capture-void": {
      "post": {
        "summary": "Capture or Void Transaction",
        "description": "Capture or void a previously authorized transaction.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CaptureVoidFormRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Capture/Void response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureVoidResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SaleAuthRequest": {
        "type": "object",
        "required": [
          "mid",
          "terminal_id",
          "order_id",
          "payment_type",
          "ccy",
          "amount",
          "api_mode",
          "signature"
        ],
        "properties": {
          "mid": {
            "type": "string",
            "description": "RDP Merchant ID"
          },
          "terminal_id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "payment_type": {
            "type": "string",
            "enum": [
              "A",
              "S"
            ],
            "description": "A = Authorization, S = Sale"
          },
          "ccy": {
            "type": "string",
            "description": "ISO-4217 currency code"
          },
          "amount": {
            "type": "string"
          },
          "api_mode": {
            "type": "string",
            "example": "direct_n3d"
          },
          "signature": {
            "type": "string"
          },
          "card_no": {
            "type": "string"
          },
          "exp_date": {
            "type": "string",
            "description": "MMYYYY"
          },
          "cvv2": {
            "type": "string"
          },
          "payer_name": {
            "type": "string",
            "description": "Conditional"
          },
          "merchant_reference": {
            "type": "string",
            "description": "Conditional"
          },
          "tips": {
            "type": "string",
            "description": "Optional; included in amount"
          },
          "card_reader_mode": {
            "type": "string",
            "enum": [
              "swipe",
              "contact",
              "contactless"
            ]
          },
          "card_fallback": {
            "type": "boolean"
          },
          "card_track1": {
            "type": "string",
            "description": "Conditional"
          },
          "card_track2": {
            "type": "string"
          },
          "card_track3": {
            "type": "string",
            "description": "Conditional"
          },
          "icc_data": {
            "type": "string",
            "description": "Mandatory for contact/contactless"
          },
          "pin": {
            "type": "string",
            "description": "Optional"
          }
        }
      },
      "SaleAuthResponse": {
        "type": "object",
        "properties": {
          "response_code": {
            "type": "string"
          },
          "response_msg": {
            "type": "string"
          },
          "response_status": {
            "type": "string"
          },
          "mid": {
            "type": "string"
          },
          "terminal_id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "transaction_type": {
            "type": "string"
          },
          "transaction_id": {
            "type": "string"
          },
          "request_ccy": {
            "type": "string"
          },
          "request_amount": {
            "type": "string"
          },
          "authorized_ccy": {
            "type": "string"
          },
          "authorized_amount": {
            "type": "string"
          },
          "created_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "acquirer_response_code": {
            "type": "string"
          },
          "acquirer_response_msg": {
            "type": "string"
          },
          "acquirer_authorized_ccy": {
            "type": "string"
          },
          "acquirer_authorized_amount": {
            "type": "string"
          },
          "acquirer_created_timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "acquirer_transaction_id": {
            "type": "string"
          },
          "acquirer_authorization_code": {
            "type": "string"
          },
          "first_6": {
            "type": "string"
          },
          "last_4": {
            "type": "string"
          },
          "payment_mode": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "payer_name": {
            "type": "string"
          },
          "merchant_reference": {
            "type": "string"
          },
          "rrn": {
            "type": "string"
          },
          "icc_data_response": {
            "type": "string"
          },
          "trace_number": {
            "type": "string"
          }
        }
      },
      "CaptureVoidFormRequest": {
        "type": "object",
        "required": [
          "mid",
          "response_type",
          "action_type",
          "terminal_id",
          "order_number",
          "transaction_id",
          "currency",
          "amount",
          "signature"
        ],
        "properties": {
          "mid": {
            "type": "string",
            "description": "RDP Merchant ID"
          },
          "response_type": {
            "type": "string",
            "example": "json"
          },
          "action_type": {
            "type": "string",
            "enum": [
              "capture",
              "void"
            ]
          },
          "terminal_id": {
            "type": "string"
          },
          "order_number": {
            "type": "string"
          },
          "transaction_id": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "description": "ISO-4217 currency code"
          },
          "amount": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "CaptureVoidResponse": {
        "type": "object",
        "properties": {
          "result_status": {
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "order_number": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "authorized_amount": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    }
  }
}