          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenericHelixValuesEnvelope"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created (Helix accepted the entry creation request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelixCreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/arsys/v1.0/entry/{formName}": {
      "get": {
        "tags": [
          "Generic Form Read"
        ],
        "summary": "Query entries from a Helix form",
        "operationId": "queryFormEntries",
        "description": "Generic read operation for Helix forms. Supports common AR System REST query parameters such as q and fields.\n\nUse this for reading staging or operational forms (Incident/Problem/Change etc).",
        "parameters": [
          {
            "name": "formName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Helix form name (e.g., HPD:Help Desk, VZ:API:IncidentInterface_Staging)."
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "AR System qualification query (URL-encoded)."
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Field selection (e.g., values(Field1,Field2))."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "description": "Maximum number of entries to return."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Offset for paging."
          }
        ],
        "responses": {
          "200": {
            "description": "Query results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelixQueryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/arsys/v1.0/entry/{formName}/{entryId}": {
      "get": {
        "tags": [
          "Generic Form Read"
        ],
        "summary": "Get a single Helix entry by ID",
        "operationId": "getFormEntryById",
        "description": "Reads a single entry from a Helix form by its AR System Entry ID.",
        "parameters": [
          {
            "name": "formName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Helix form name (e.g., HPD:Help Desk, VZ:API:IncidentInterface_Staging)."
          },
          {
            "name": "entryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "AR System Entry ID."
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Field selection (e.g., values(Field1,Field2))."
          }
        ],
        "responses": {
          "200": {
            "description": "Entry details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelixEntryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Layer7Auth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Authentication is enforced by VodafoneZiggo Layer7 API Gateway. The concrete mechanism depends on the assigned client profile."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request (invalid syntax / missing required request parts).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Not authorized to perform this operation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotAcceptable": {
        "description": "Not acceptable (e.g., content negotiation or validation mapped to 406 by gateway).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Validation error in request payload (recommended for functional validation failures).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "GenericHelixValuesEnvelope": {
        "type": "object",
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "object",
            "additionalProperties": true,
            "description": "Helix AR System values object. Extend with use-case specific fields."
          }
        }
      },
      "HelixCreateResponse": {
        "type": "object",
        "description": "Generic Helix create response (field selection depends on fields= query parameter).",
        "properties": {
          "values": {
            "type": "object",
            "properties": {
              "VZ_TicketNumber": {
                "type": "string",
                "nullable": true
              },
              "VZ_Return Code": {
                "type": "string",
                "nullable": true
              },
              "VZ_Return Status": {
                "type": "string",
                "nullable": true
              },
              "VZ_Return Message": {
                "type": "string",
                "nullable": true
              },
              "EXT_TicketNumber": {
                "type": "string",
                "nullable": true
              }
            },
            "additionalProperties": true
          },
          "_links": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "HelixQueryResponse": {
        "type": "object",
        "description": "Generic query response for Helix form entries.",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HelixEntryResponse"
            }
          },
          "_links": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "HelixEntryResponse": {
        "type": "object",
        "description": "Generic Helix entry response. Content depends on requested form and selected fields.",
        "properties": {
          "values": {
            "type": "object",
            "additionalProperties": true
          },
          "_links": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error envelope for Layer7 / Helix integration responses.",
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code (gateway or Helix)."
          },
          "message": {
            "type": "string",
            "description": "Human readable error message."
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional details for troubleshooting."
          }
        }
      },
      "DFN_FTTH_IncidentCreateRequest": {
        "type": "object",
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "$ref": "#/components/schemas/DFN_FTTH_IncidentValues"
          }
        },
        "description": "DFN FTTH individual incident reporting (ADT / FieldTool) via VZ:API:IncidentInterface_Staging."
      },
      "DFN_FTTH_IncidentValues": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "VZ_Action",
          "VZ_Template",
          "EXT_TicketNumber",
          "VZ_Summary",
          "VZ_Notes",
          "VZ_DFN_TicketType",
          "VZ_DFN_Connection_Ticket_Type",
          "VZ_DFN_connection_Been_active",
          "VZ_DFN_Zip_Code",
          "VZ_DFN_Home_nr",
          "VZ_DFN_WSO_Department",
          "VZ_DFN_WSO_Phone_Number",
          "VZ_DFN_WSO_Ticket_Type",
          "VZ_DFN_Lookingglass_rx_value",
          "VZ_DFN_Lookingglass_tx_value",
          "VZ_DFN_Bus_Switch_First_Link_Light",
          "VZ_DFN_Bus_Switch_Last_Link_Light",
          "VZ_DFN_Business_Switch_Light_1",
          "VZ_DFN_FTTO_V_Lan_ID",
          "VZ_DFN_Switch_Gate"
        ],
        "properties": {
          "VZ_Action": {
            "type": "string",
            "enum": [
              "CREATE"
            ],
            "default": "CREATE",
            "maxLength": 40,
            "description": "Action executed on the Helix staging form."
          },
          "VZ_Template": {
            "type": "string",
            "enum": [
              "ADT-NaxOS",
              "FieldTool-NaxOS"
            ],
            "maxLength": 40,
            "description": "Template used for routing/processing in Helix. ADT must use ADT-NaxOS; FieldTool must use FieldTool-NaxOS."
          },
          "EXT_TicketNumber": {
            "type": "string",
            "maxLength": 40,
            "description": "External ticket identifier from the API consumer. Must be unique per consumer/use-case."
          },
          "VZ_Summary": {
            "type": "string",
            "maxLength": 60,
            "description": "Short summary of the customer incident."
          },
          "VZ_Notes": {
            "type": "string",
            "maxLength": 4000,
            "description": "Detailed description / notes for the incident."
          },
          "VZ_DFN_TicketType": {
            "type": "string",
            "enum": [
              "ticket"
            ],
            "default": "ticket",
            "maxLength": 40,
            "description": "DFN ticket type. For this use-case only ticket is supported."
          },
          "VZ_DFN_Connection_Ticket_Type": {
            "type": "string",
            "enum": [
              "ftto_p2p"
            ],
            "maxLength": 40,
            "description": "Connection ticket type for DFN. For ticket_type ticket, DFN requires ftto_p2p."
          },
          "VZ_DFN_connection_Been_active": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "maxLength": 40,
            "description": "Indicates whether the connection has been active before."
          },
          "VZ_DFN_Zip_Code": {
            "type": "string",
            "maxLength": 10,
            "pattern": "^[1-9][0-9]{3}( ?)(?!SA|SD|SS)[A-Z]{2}$",
            "description": "Dutch postal code (e.g., 1433DC). Uppercase recommended."
          },
          "VZ_DFN_Home_nr": {
            "type": "integer",
            "description": "House number. Must be an integer (no quotes in JSON)."
          },
          "VZ_DFN_SearchCode": {
            "type": "string",
            "maxLength": 80,
            "description": "Optional search code (e.g., zipcode+home_nr+addition+room)."
          },
          "VZ_DFN_WSO_Department": {
            "type": "string",
            "enum": [
              "backoffice",
              "kcc"
            ],
            "maxLength": 40,
            "description": "Wholesale department. Allowed values: backoffice, kcc."
          },
          "VZ_DFN_WSO_Phone_Number": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^([0]|\\+[0-9]{1,5})?([0-9]{10})$",
            "description": "Contact phone number (NL)."
          },
          "VZ_DFN_WSO_Ticket_Type": {
            "type": "string",
            "maxLength": 40,
            "enum": [
              "signal_no_data",
              "no_signal",
              "performance",
              "service_interruption",
              "iptv"
            ],
            "description": "WSO ticket type for DFN ticket_type ticket."
          },
          "VZ_DFN_Lookingglass_rx_value": {
            "type": "integer",
            "description": "Looking glass RX value (integer)."
          },
          "VZ_DFN_Lookingglass_tx_value": {
            "type": "integer",
            "description": "Looking glass TX value (integer)."
          },
          "VZ_DFN_Bus_Switch_First_Link_Light": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "blinking",
              "unknown"
            ],
            "maxLength": 40,
            "description": "Business switch first link light status."
          },
          "VZ_DFN_Bus_Switch_Last_Link_Light": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "blinking",
              "unknown"
            ],
            "maxLength": 40,
            "description": "Business switch last link light status."
          },
          "VZ_DFN_Business_Switch_Light_1": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "blinking",
              "unknown"
            ],
            "maxLength": 40,
            "description": "Business switch light 1 status."
          },
          "VZ_DFN_FTTO_V_Lan_ID": {
            "type": "string",
