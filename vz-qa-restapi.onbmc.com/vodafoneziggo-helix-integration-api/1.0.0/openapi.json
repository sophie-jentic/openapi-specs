{
  "openapi": "3.0.3",
  "info": {
    "title": "VodafoneZiggo Helix Integration API",
    "version": "1.0.0",
    "description": "VodafoneZiggo BMC Helix.\n\nArchitecture:\n- Staging Interface APIs (POST): Create/ingest records into Helix staging interface forms (Incident/Problem/Change).\n- Generic Form APIs (GET): Read records from Helix forms (staging or operational) using AR System REST semantics.",
    "contact": {
      "name": "Helix Technical Platform Lead",
      "email": "jordy.heer@vodafoneziggo.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/VZ_Helix/vodafoneziggo-helix-integration-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://vz-qa-restapi.onbmc.com:443/api",
      "description": "UAT / Non-Production"
    },
    {
      "url": "https://vz-restapi.onbmc.com:443/api",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Incident Interface",
      "description": "Inbound create/modify into incident staging interface form (VZ:API:IncidentInterface_Staging)."
    },
    {
      "name": "Problem Interface",
      "description": "Inbound create/modify into problem staging interface form (VZ:API:ProblemInterface_Staging)."
    },
    {
      "name": "Change Interface",
      "description": "Inbound create/modify into change staging interface form (VZ:API:ChangeInterface_Staging)."
    },
    {
      "name": "Generic Form Read",
      "description": "Generic GET operations to read data from Helix forms (staging, operational or foundation)."
    }
  ],
  "security": [
    {
      "Layer7Auth": []
    }
  ],
  "paths": {
    "/arsys/v1.0/entry/VZ:API:IncidentInterface_Staging": {
      "post": {
        "tags": [
          "Incident Interface"
        ],
        "summary": "Create Incident record via staging interface",
        "operationId": "createIncidentViaStaging",
        "description": "Creates an incident record by submitting a payload to the Helix staging interface form VZ:API:IncidentInterface_Staging.\n\nUse-cases are represented as schemas in the request body (oneOf). Select the schema that matches your integration.\n\nImportant: Helix validation is enforced via server-side filters. Responses may contain validation messages in VZ_Return Message.",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "values(VZ_TicketNumber,VZ_Return Code,VZ_Return Status,VZ_Return Message,EXT_TicketNumber)"
            },
            "description": "Helix AR query parameter limiting returned response fields."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/DFN_FTTH_IncidentCreateRequest"
                  },
                  {
                    "$ref": "#/components/schemas/SAM_HFC_IncidentCreateRequest"
                  }
                ]
              },
              "examples": {
                "DFN_ADT": {
                  "summary": "DFN FTTH ticket (ADT)",
                  "value": {
                    "values": {
                      "VZ_Action": "CREATE",
                      "VZ_Template": "ADT-NaxOS",
                      "EXT_TicketNumber": "20260304143028",
                      "VZ_Summary": "Customer connectivity issue",
                      "VZ_Notes": "Customer reports connectivity issue on FTTO connection. Diagnostics collected.",
                      "VZ_DFN_TicketType": "ticket",
                      "VZ_DFN_Connection_Ticket_Type": "ftto_p2p",
                      "VZ_DFN_connection_Been_active": "yes",
                      "VZ_DFN_Zip_Code": "1433DC",
                      "VZ_DFN_Home_nr": 23,
                      "VZ_DFN_WSO_Department": "backoffice",
                      "VZ_DFN_WSO_Phone_Number": "0612345678",
                      "VZ_DFN_WSO_Ticket_Type": "performance",
                      "VZ_DFN_Lookingglass_rx_value": 1,
                      "VZ_DFN_Lookingglass_tx_value": 2,
                      "VZ_DFN_Bus_Switch_First_Link_Light": "on",
                      "VZ_DFN_Bus_Switch_Last_Link_Light": "on",
                      "VZ_DFN_Business_Switch_Light_1": "on",
                      "VZ_DFN_FTTO_V_Lan_ID": "6",
                      "VZ_DFN_Switch_Gate": "4",
                      "VZ_DFN_FTTO_Linename": "123"
                    }
                  }
                },
                "SAM_HFC": {
                  "summary": "SAM Monitoring HFC outage incident",
                  "value": {
                    "values": {
                      "VZ_Source System": "SAM",
                      "EXT_TicketNumber": "28455/185450614_000196",
                      "VZ_Action": "CREATE",
                      "VZ_Summary": "RT14.6005004A.005.008.01.3 - NOC-HFC - Outage on NODE - 0 #CUST",
                      "EXT_TypeField1": "MP-LC0001.RNW-0005-1A",
                      "EXT_TypeField3": "SAM_DNOC-HFC_FO-TECH-NL",
                      "EXT_TypeField4": "yes",
                      "EXT_TypeField16": "2026-03-03T13:51:35",
                      "EXT_Priority": "Low",
                      "EXT_Service": "HFC Cabling Service NL",
                      "EXT_ServiceType": "User Service Restoration",
                      "EXT_OpCat1": "",
                      "VZ_ImpactB2B": 0,
                      "VZ_ImpactB2C": 0,
                      "VZ_ImpactInternalIT": 0,
                      "VZ_WorkLog_Notes": "Trigger: SAM HFC monitoring\nCreated by: uat_tester\nSymptoms: Outage...\nAction: Assign a field engineer",
                      "VZ_Notes": "Trigger: SAM HFC monitoring\nCreated by: uat_tester\nSymptoms: Outage...\nAction: Assign a field engineer"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created (Helix accepted the entry creation request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelixCreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/arsys/v1.0/entry/VZ:API:ProblemInterface_Staging": {
      "post": {
        "tags": [
          "Problem Interface"
        ],
        "summary": "Create Problem record via staging interface",
        "operationId": "createProblemViaStaging",
        "description": "Creates a problem record by submitting a payload to the Helix staging interface form VZ:API:ProblemInterface_Staging.\n\nPlaceholder operation: add dedicated use-case schemas later (oneOf) similar to Incident.",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "values(VZ_TicketNumber,VZ_Return Code,VZ_Return Status,VZ_Return Message,EXT_TicketNumber)"
            },
            "description": "Helix AR query parameter limiting returned response fields."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenericHelixValuesEnvelope"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created (Helix accepted the entry creation request).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelixCreateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/arsys/v1.0/entry/VZ:API:ChangeInterface_Staging": {
      "post": {
        "tags": [
          "Change Interface"
        ],
        "summary": "Create Change record via staging interface",
        "operationId": "createChangeViaStaging",
        "description": "Creates a change record by submitting a payload to the Helix staging interface form VZ:API:ChangeInterface_Staging.\n\nPlaceholder operation: add dedicated use-case schemas later (oneOf) similar to Incident.",
        "parameters": [
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "values(VZ_TicketNumber,VZ_Return Code,VZ_Return Status,VZ_Return Message,EXT_TicketNumber)"
            },
