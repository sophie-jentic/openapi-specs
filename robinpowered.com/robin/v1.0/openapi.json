{
  "openapi": "3.0.3",
  "info": {
    "title": "Robin Powered Workplace Management API",
    "description": "Robin API provides access to workplace management data including spaces (conference rooms), locations (buildings), users, events (bookings), desks, presence information, and analytics exports. Enables scheduling, space booking, desk reservations, and workplace utilization reporting.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.robinpowered.com/"
  },
  "servers": [
    {
      "url": "https://api.robinpowered.com/v1.0",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "accessToken": []
    }
  ],
  "paths": {
    "/organizations/{organizationId}": {
      "get": {
        "operationId": "getOrganization",
        "summary": "Get organization details",
        "description": "Retrieves details for a specific organization.",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "description": "Organization identifier",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with organization data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Organization"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Organization not found"
          }
        }
      }
    },
    "/organizations/{organizationId}/locations": {
      "get": {
        "operationId": "getOrganizationLocations",
        "summary": "List locations for an organization",
        "description": "Returns all locations (buildings/offices) belonging to a specific organization.",
