        "summary": "Request desk reservations export",
        "description": "Requests an export of all desk assignments and reservations within a specified timeframe.",
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "description": "Organization identifier",
            "schema": {
