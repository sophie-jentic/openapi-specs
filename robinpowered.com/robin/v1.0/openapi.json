      }
    },
    "/insights/exports/{exportId}": {
      "get": {
        "operationId": "getExportStatus",
        "summary": "Get export status and download",
        "description": "Polls for generated export data using the export ID. Poll at 10 second or greater intervals. Returns CSV data when ready.",
        "parameters": [
          {
            "name": "exportId",
            "in": "path",
            "required": true,
            "description": "Export identifier returned from export request",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Export ready - returns CSV data",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "202": {
            "description": "Export still processing"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
