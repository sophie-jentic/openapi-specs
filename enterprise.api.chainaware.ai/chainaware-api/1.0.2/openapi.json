        },
        "forensic_details": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "riskProfile": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "segmentInfo": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "experience": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "recommendation": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "intention": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "x-nullable": true
        }
      }
    },
    "RugPullRequestBody": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string"
        },
        "contractAddress": {
          "type": "string"
        }
      }
    },
    "RugPullResponse": {
      "type": "object",
      "properties": {
