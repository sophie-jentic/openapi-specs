  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Provide the API token obtained from `/api/security/oauth/token`"
      }
    },
    "schemas": {
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "17a9e9bc-ea8e-4201-81de-638ed4caefc3"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 401
          },
          "message": {
            "type": "string",
            "example": "Unauthorized"
          }
        }
      },
      "PropertyDetails": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string"
          },
          "ownerName": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "PaymentHistory": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string"
          },
          "payments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "transactionId": {
                  "type": "string"
                },
                "amount": {
                  "type": "number"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      },
      "PaymentLink": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://pay.example.com/xyz123"
          }
        }
      },
      "YearlyTax": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string"
          },
          "financialYear": {
            "type": "string"
          },
          "totalTax": {
            "type": "number"
          }
        }
      },
      "PaymentStatus": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "SUCCESS"
          }
        }
      },
      "PaymentReceipt": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "receiptUrl": {
            "type": "string",
            "example": "https://stg.mapmyindia.in/receipt/AMC-1000253445.pdf"
          }
        }
      }
    }
  }
}