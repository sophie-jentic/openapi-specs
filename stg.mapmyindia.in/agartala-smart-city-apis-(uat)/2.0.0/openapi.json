{
  "openapi": "3.0.3",
  "info": {
    "title": "Agartala Smart City APIs (UAT)",
    "version": "2.0.0",
    "description": "API documentation for Agartala Smart City Tax & Payment APIs (UAT). - First, obtain a token from `/api/security/oauth/token` - Then call the other endpoints with `Authorization` header\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/mapmyindia-000/agartala-smart-city-apis-uat/2.0.0"
  },
  "servers": [
    {
      "url": "https://stg.mapmyindia.in"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/security/oauth/token": {
      "post": {
        "summary": "Get OAuth Token",
        "description": "Obtain access token using client credentials",
        "parameters": [
          {
            "name": "grant_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "client_credentials"
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "40d3b93a50212bb5fdee5d4c8be2d216"
          },
          {
            "name": "client_secret",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "b7ead3cd24d8f9ad127da29e7d1e4217"
          }
        ],
        "responses": {
          "200": {
            "description": "Token issued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/amc-ext/api/properties/tax-details": {
      "get": {
        "summary": "Property Search",
        "parameters": [
          {
            "name": "propertyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "AMCCZ00135"
          },
          {
            "name": "phoneNo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": ""
          },
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "application/vnd.taxsaas.v1+json"
          },
          {
            "name": "X-Account-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ascl-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Tax details fetched successfully",
            "content": {
              "application/vnd.taxsaas.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyDetails"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (Invalid API key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Property not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
