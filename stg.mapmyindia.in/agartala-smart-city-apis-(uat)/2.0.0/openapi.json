    "/amc-ext/api/properties/yearly-tax": {
      "post": {
        "summary": "Yearly Tax",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "application/vnd.taxsaas.v1+json"
          },
          {
            "name": "X-Account-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ascl-001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "AMCCZ00007"
                  },
                  "financial_year": {
                    "type": "string",
                    "example": "2024-2025"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Yearly tax calculated",
            "content": {
              "application/vnd.taxsaas.v1+json": {
                "schema": {
