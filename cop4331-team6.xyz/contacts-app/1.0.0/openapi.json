{
  "swagger": "2.0",
  "info": {
    "description": "This is the API documentation for Team 6's Small Project",
    "version": "1.0.0",
    "title": "Contacts App",
    "contact": {
      "email": "kushald592@gmail.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ucf-383/SmallProjectAPI/1.0.0"
  },
  "tags": [
    {
      "name": "Users",
      "description": "Operations related to user accounts"
    },
    {
      "name": "Contacts",
      "description": "Operations for managing the contact list"
    }
  ],
  "paths": {
    "/Login.php": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Logs into Contacts app",
        "operationId": "doLogin",
        "description": "Logs into Contacts app",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "loginItem",
            "description": "login credentials",
            "schema": {
              "$ref": "#/definitions/Login"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful login",
            "schema": {
              "$ref": "#/definitions/AuthResponse"
            }
          },
          "404": {
            "description": "Invalid login or password",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/Register.php": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Registers a new user",
        "operationId": "doRegister",
        "description": "Creates a new user account",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "registerItem",
            "description": "registration info",
            "schema": {
              "$ref": "#/definitions/Register"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful registration",
            "schema": {
              "$ref": "#/definitions/AuthResponse"
            }
          },
          "500": {
            "description": "Login already exists or registration failed",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/AddContact.php": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Adds a new contact for a user",
        "operationId": "addContact",
        "description": "Creates a new contact associated with a user",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "contactItem",
            "description": "contact info",
            "schema": {
              "$ref": "#/definitions/AddContact"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact added successfully",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            }
          },
          "500": {
            "description": "Failed to add contact",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/SearchContact.php": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Searches contacts for a user",
        "operationId": "searchContacts",
        "description": "Returns contacts matching search criteria or all contacts",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "searchItem",
            "description": "search parameters",
            "schema": {
              "$ref": "#/definitions/SearchContact"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An array of contacts",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ContactRecord"
              }
            }
          },
          "500": {
            "description": "Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/UpdateContact.php": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Updates a contact's information",
        "operationId": "updateContact",
        "description": "Updates an existing contact's details",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "updateItem",
            "description": "updated contact info",
            "schema": {
              "$ref": "#/definitions/UpdateContact"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact updated successfully",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            }
          },
          "404": {
            "description": "Contact Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/DeleteContact.php": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Deletes a contact",
        "operationId": "deleteContact",
        "description": "Removes a contact from the database",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "deleteItem",
            "description": "contact identifiers",
            "schema": {
              "$ref": "#/definitions/DeleteContact"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact deleted successfully",
            "schema": {
              "$ref": "#/definitions/SuccessResponse"
            }
          },
          "404": {
            "description": "Contact Not Found",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Server Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Login": {
      "type": "object",
      "required": [
        "login",
        "password"
      ],
      "properties": {
        "login": {
          "type": "string",
          "example": "fred"
        },
        "password": {
          "type": "string",
          "example": "secret"
        }
      }
    },
    "Register": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "login",
        "password"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "login": {
          "type": "string",
          "example": "johndoe"
        },
        "password": {
          "type": "string",
          "example": "mypassword123"
        }
      }
    },
    "AddContact": {
      "type": "object",
      "required": [
        "userId",
        "firstName",
        "lastName"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 1
        },
        "firstName": {
          "type": "string",
          "example": "Jane"
        },
        "lastName": {
          "type": "string",
          "example": "Smith"
        },
        "email": {
          "type": "string",
          "example": "jane.smith@example.com"
        },
        "phone": {
          "type": "string",
          "example": "555-1234"
        }
      }
    },
    "SearchContact": {
      "type": "object",
      "required": [
        "userId"
      ],
      "properties": {
        "userId": {
          "type": "integer",
          "example": 1
        },
        "search": {
          "type": "string",
          "example": "Jane"
        }
      }
    },
    "UpdateContact": {
      "type": "object",
      "required": [
        "id",
        "userId",
        "firstName",
        "lastName"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "example": 5
        },
        "userId": {
          "type": "integer",
          "example": 1
        },
        "firstName": {
          "type": "string",
          "example": "Jane"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "email": {
          "type": "string",
          "example": "jane.doe@example.com"
        },
        "phone": {
          "type": "string",
          "example": "555-5678"
        }
      }
    },
    "DeleteContact": {
      "type": "object",
      "required": [
        "id",
        "userId"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "example": 5
        },
        "userId": {
          "type": "integer",
          "example": 1
        }
      }
    },
    "AuthResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "example": 123
        },
        "login": {
          "type": "string",
          "example": "johndoe"
        },
        "firstName": {
          "type": "string",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "error": {
          "type": "string",
          "example": ""
        }
      }
    },
    "SuccessResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "example": true
        },
        "message": {
          "type": "string",
          "example": "Operation completed successfully"
        },
        "error": {
          "type": "string",
          "example": ""
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "Error message details here"
        }
      }
    },
    "ContactRecord": {
      "type": "object",
      "properties": {
        "ID": {
          "type": "integer",
          "example": 5
        },
        "FirstName": {
          "type": "string",
          "example": "Jane"
        },
        "LastName": {
          "type": "string",
          "example": "Smith"
        },
        "Email": {
          "type": "string",
          "example": "jane.smith@example.com"
        },
        "Phone": {
          "type": "string",
          "example": "555-1234"
        },
        "DateCreated": {
          "type": "string",
          "example": "2026-02-19 14:30:00"
        }
      }
    }
  },
  "host": "cop4331-team6.xyz",
  "basePath": "/api",
  "schemes": [
    "http"
  ]
}