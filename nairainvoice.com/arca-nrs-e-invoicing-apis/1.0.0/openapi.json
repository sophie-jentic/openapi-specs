            "type": "string",
            "description": "Customer email (optional)"
          },
          "customer_party_name": {
            "type": "string",
            "description": "Customer name (optional)"
          },
          "customer_party_telephone": {
            "type": "string",
            "description": "Customer phone (optional)"
          },
          "customer_party_business_description": {
            "type": "string",
            "description": "Customer business description (optional)"
          },
          "customer_city_name": {
            "type": "string"
          },
          "customer_postal_zone": {
            "type": "string"
          },
          "customer_country": {
            "type": "string"
          },
          "customer_street_name": {
            "type": "string"
          },
          "customer_lga": {
            "type": "string"
          },
          "customer_state": {
            "type": "string"
          },
          "supplier_party_tin": {
            "type": "string",
            "minLength": 6
          },
          "supplier_party_email": {
            "type": "string",
            "format": "email"
          },
