  "components": {
    "securitySchemes": {
      "BusinessKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Business-Key",
        "description": "Business authentication key obtained from the Request Business Key endpoint"
      }
    },
    "parameters": {
      "businessId": {
        "name": "businessId",
        "in": "path",
        "required": true,
        "description": "The unique FIRS identifier of the business",
        "schema": {
          "type": "string"
        },
