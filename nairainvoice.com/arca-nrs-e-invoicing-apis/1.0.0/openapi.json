{
  "openapi": "3.0.3",
  "info": {
    "title": "Arca NRS E-Invoicing APIs",
    "description": "The Arca E-Invoicing API enables Nigerian organisations to standardise, validate, and securely transmit invoices to the Nigerian Revenue Service (NRS/FIRS).\n\nArca Payments is one of the first 16 licensed Access Point Providers and System Integrators (APP/SI) approved by the NRS.\n\n## Authentication\nAll invoice lifecycle endpoints require an `X-Business-Key` header. Obtain this key by calling the **Request Business Key** endpoint.\n\n## Base URL\n- **Development:** `https://api-dev.nairainvoice.com/dev`\n- **Production:** `https://api.nairainvoice.com/api`\n",
    "version": "1.0.0",
    "contact": {
      "email": "finance@arca.network"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/arcapayments/arca-nrs-e-invoicing-apis/1.0.0"
  },
  "servers": [
    {
      "url": "https://api-dev.nairainvoice.com/dev",
      "description": "Development Server"
    },
    {
      "url": "https://api.nairainvoice.com/api",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Business Onboarding",
      "description": "Endpoints for registering a business and managing business keys"
    },
    {
      "name": "Invoice Creation",
      "description": "Endpoints for creating, retrieving, and managing invoices"
    },
    {
      "name": "Invoice Reversal",
      "description": "Endpoints for reversing invoices and generating credit notes"
    },
    {
      "name": "Invoice Receipt",
      "description": "Endpoints for fetching and confirming received invoices"
    },
    {
      "name": "FIRS Resources",
      "description": "Reference data endpoints for currencies, tax categories, product codes and more"
    }
  ],
  "paths": {
    "/external/request-business-key": {
      "post": {
        "tags": [
          "Business Onboarding"
        ],
        "summary": "Request Business Key",
        "description": "Registers a business entity and generates a business key used for authenticating all subsequent API calls.\nRequires valid FIRS credentials and business address details.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "businessAddress",
                  "businessAddressLg",
                  "businessAddressStreetName",
                  "businessCity",
                  "businessCountry",
                  "businessPostalCode",
                  "businessState",
                  "contactEmail",
                  "entityFirsId",
                  "businessFirsId"
                ],
                "properties": {
                  "businessAddress": {
                    "type": "string",
                    "description": "Full business address",
                    "example": "123 Commerce Plaza, Victoria Island"
                  },
                  "businessAddressLg": {
                    "type": "string",
                    "description": "Business address local government area",
                    "example": "Eti-Osa"
                  },
                  "businessAddressStreetName": {
                    "type": "string",
                    "description": "Street name of the business address",
                    "example": "Adeola Odeku Street"
                  },
                  "businessCity": {
                    "type": "string",
                    "description": "City where the business is located",
                    "example": "Lagos"
                  },
                  "businessCountry": {
                    "type": "string",
                    "description": "Country where the business is located",
                    "example": "Nigeria"
                  },
                  "businessPostalCode": {
                    "type": "string",
                    "description": "Postal/ZIP code of the business address",
                    "example": "101241"
                  },
                  "businessState": {
                    "type": "string",
                    "description": "State/province where the business is located",
                    "example": "Lagos"
                  },
                  "contactEmail": {
                    "type": "string",
                    "format": "email",
                    "description": "Contact email address for the business",
                    "example": "info@example.com"
                  },
                  "entityFirsId": {
                    "type": "string",
                    "description": "FIRS identification number for the entity",
                    "example": "ENT-87654321"
                  },
                  "businessFirsId": {
                    "type": "string",
                    "description": "FIRS identification number for the business",
                    "example": "26ede24b-ac50-475f-aacc-5ea6339f0863"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Business key generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessKeyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/external/businesses/{businessFirsId}/regenerate-business-key": {
      "post": {
        "tags": [
          "Business Onboarding"
        ],
        "summary": "Regenerate Business Key",
        "description": "Regenerates the business key for an existing business. Use this when rotating keys for security purposes or when an existing key has been compromised.\n\n**Warning:** Regenerating a business key immediately invalidates the previous key. Update all systems using the old key before or immediately after regeneration.\n",
        "parameters": [
          {
            "name": "businessFirsId",
            "in": "path",
            "required": true,
            "description": "The FIRS identification number for the business",
            "schema": {
              "type": "string"
            },
            "example": "26ede24b-ac50-475f-aacc-5ea6339f0863"
          }
        ],
        "responses": {
          "200": {
            "description": "Business key regenerated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessKeyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/external/businesses/{businessId}/invoices": {
      "post": {
        "tags": [
          "Invoice Creation"
        ],
        "summary": "Create Invoice",
        "description": "Creates a new NRS-compliant invoice for the specified business. The invoice is validated and transmitted to the Nigerian Revenue Service.\n\nSupports both **B2B** (Business to Business) and **B2C** (Business to Customer) invoice types.\n\nAt least one invoice line item and one tax total must be provided.\n",
        "security": [
          {
            "BusinessKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/businessId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvoiceRequest"
              },
              "example": {
                "requesttype": "B2B",
                "invoice_number": "INV236",
                "business_id": "b4009129-ece8-45fc-9584-976fcbe35f8d",
                "issue_date": "2025-08-26",
                "due_date": "2025-08-26",
                "issue_time": "12:57:15",
                "invoice_type_code": "389",
                "payment_status": "PAID",
                "note": "August Electricity Bill",
                "tax_point_date": "2025-08-26",
                "document_currency_code": "NGN",
                "tax_currency_code": "NGN",
                "supplier_party_tin": "68721523-8104",
                "supplier_party_email": "supplier@example.com",
                "supplier_party_name": "Arca Payments",
                "supplier_party_business_description": "Switching and Processing",
                "supplier_lga": "Eti-Osa",
                "supplier_state": "Lagos",
                "supplier_city_name": "Lagos",
                "supplier_postal_zone": "101245",
                "supplier_country": "NG",
                "supplier_street_name": "5, Furo Ezimora Street",
                "line_extension_amount": 30030.0,
                "tax_exclusive_amount": 30030.0,
                "tax_inclusive_amount": 30255.22,
                "payable_amount": 30255.22,
                "invoice_line": [
                  {
                    "hsn_code": "2716.00",
                    "product_category": "Electrical energy",
                    "invoiced_quantity": 200.0,
                    "line_extension_amount": 30030.0,
                    "item_name": "Electricity Supply",
                    "item_description": "Electricity Units",
                    "price_amount": 150.0,
                    "price_base_quantity": 1.0,
                    "price_unit": "NGN PER 1"
                  }
                ],
                "tax_total": [
                  {
                    "tax_amount": 225.22,
                    "tax_subtotal": [
                      {
                        "taxable_amount": 30030.0,
                        "tax_amount": 225.22,
                        "category_id": "STANDARD_VAT",
                        "category_percent": 0.75
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateInvoiceResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/external/businesses/{businessId}/invoices/{invoiceIrn}": {
      "get": {
        "tags": [
          "Invoice Creation"
        ],
        "summary": "Get Invoice Details",
        "description": "Retrieves comprehensive details of a specific invoice including line items, tax information, customer and supplier details, and payment status.",
        "security": [
          {
            "BusinessKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/businessId"
          },
          {
            "$ref": "#/components/parameters/invoiceIrn"
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceDetailResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/external/businesses/{businessId}/invoices/{invoiceIrn}/qr": {
      "get": {
        "tags": [
          "Invoice Creation"
        ],
        "summary": "Get Invoice QR Code",
        "description": "Retrieves the QR code for a specific invoice. Returns a base64-encoded PNG image and encrypted invoice data.\n\nThe QR code can be embedded in invoice PDFs or displayed in mobile apps to facilitate payment.\n",
        "security": [
          {
            "BusinessKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/businessId"
          },
          {
            "$ref": "#/components/parameters/invoiceIrn"
          }
        ],
        "responses": {
          "200": {
            "description": "QR code retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "encryptedDataBase64": {
                          "type": "string",
                          "description": "Base64 encoded encrypted invoice data"
                        },
                        "irn": {
                          "type": "string",
                          "description": "Invoice Reference Number"
                        },
                        "qrCodeBase64": {
                          "type": "string",
                          "description": "Base64 encoded QR code image (PNG format)"
                        },
                        "timestamp": {
                          "type": "integer",
                          "description": "Unix timestamp of response generation"
                        }
                      }
                    },
                    "responseCode": {
                      "type": "string",
                      "example": "00"
                    },
                    "responseMessage": {
                      "type": "string",
                      "example": "QR code retrieved successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/external/businesses/{businessId}/invoices/update-payment/{invoiceIrn}": {
      "post": {
        "tags": [
          "Invoice Creation"
        ],
        "summary": "Update Invoice Payment Status",
        "description": "Updates the payment status of an existing invoice.\n\n**Allowed status transitions:**\n- `PENDING` \u2192 `PAID` or `REJECTED`\n- `REJECTED` \u2192 `PENDING` (for reprocessing)\n",
        "security": [
          {
            "BusinessKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/businessId"
          },
          {
            "$ref": "#/components/parameters/invoiceIrn"
          },
          {
            "name": "invoiceStatus",
            "in": "query",
            "required": true,
            "description": "The new payment status for the invoice",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "PAID",
                "REJECTED"
              ]
            },
            "example": "PAID"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleSuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        }
      }
    },
    "/external/businesses/{businessId}/invoices/reversal": {
      "post": {
        "tags": [
          "Invoice Reversal"
        ],
        "summary": "Reverse Invoice",
        "description": "Reverses an existing invoice by its IRN. This creates a credit note against the original invoice.\n\n**Workflow:**\n1. Create Invoice\n2. Invoice Transmitted\n3. Identify error or cancellation need\n4. Call this endpoint to reverse\n5. Create a new corrected invoice if needed\n\nReversed invoices cannot be un-reversed.\n",
        "security": [
          {
            "BusinessKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/businessId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "irn"
                ],
                "properties": {
                  "irn": {
                    "type": "string",
                    "description": "Invoice Reference Number of the invoice to reverse",
                    "example": "INV236-1070ECE8-20250826"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice reversed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceReversalResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict - Invoice cannot be reversed (already reversed or in invalid state)"
          }
        }
      }
    },
    "/external/{businessId}/fetchInvoices": {
      "post": {
        "tags": [
          "Invoice Receipt"
        ],
        "summary": "Fetch Received Invoices",
