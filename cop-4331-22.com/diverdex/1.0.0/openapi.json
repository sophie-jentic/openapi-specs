{
  "swagger": "2.0",
  "info": {
    "description": "This is the API documentation for the DiverDex Project",
    "version": "1.0.0",
    "title": "DiverDex",
    "contact": {
      "email": "anaclara.machadogoncalves@ucf.edu"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ucf-094/DiverDexAPI/1.0.0"
  },
  "paths": {
    "/Login.php": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Logs in to the app",
        "operationId": "loginUser",
        "description": "Authenticates a user using their login and password. Returns the user's ID, first name, and last name on success, or an error message on failure.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "loginItem",
            "description": "Login credentials",
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/Signup.php": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Registers a new user",
        "operationId": "registerUser",
        "description": "Creates a new user account with the provided first name, last name, login, and password. Returns the new user's ID, first name, and last name on success. Returns an error if the username already exists or a database error occurs. Passwords are stored as an MD5 hash.\n",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "registerItem",
            "description": "Registration information",
            "schema": {
              "$ref": "#/definitions/RegisterRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/RegisterResponse"
            }
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/AddContact.php": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Adds a new contact",
        "operationId": "addContact",
        "description": "Adds a new contact to the database for the specified user. Returns a success message on success. Returns an error if the email or phone number already exists for that user (\"emailExists\" or \"phoneExists\"), or if a database error occurs.\n",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "contactItem",
            "description": "Contact information",
            "schema": {
              "$ref": "#/definitions/AddContactRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AddContactResponse"
            }
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/SearchContact.php": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Searches contacts",
        "operationId": "searchContacts",
        "description": "Searches a user's contacts by first name, last name, full name, email, or phone number using a partial match. Returns a list of matching contacts on success, or an error message if no records are found, required fields are missing, or a database error occurs.\n",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "searchItem",
            "description": "Contact search parameters",
            "schema": {
              "$ref": "#/definitions/SearchContactsRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SearchContactsResponse"
            }
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/UpdateContact.php": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Edits an existing contact",
        "operationId": "editContact",
        "description": "Updates an existing contact's first name, last name, phone number, and email for the specified user. The contact must belong to the given userId. Returns a success message if the contact was updated, or an error if the contact was not found, no changes were made, required fields are missing, or a database error occurs.\n",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "editContactItem",
            "description": "Updated contact information",
            "schema": {
              "$ref": "#/definitions/EditContactRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/EditContactResponse"
            }
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/DeleteContact.php": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Deletes a contact",
        "operationId": "deleteContact",
        "description": "Deletes a contact from the database by contact ID, scoped to the specified userId to prevent unauthorized deletions. Returns a success message if the contact was deleted, or an error if the contact was not found, the user does not have permission, required fields are missing, or a database error occurs.\n",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "deleteContactItem",
            "description": "Contact deletion parameters",
            "schema": {
              "$ref": "#/definitions/DeleteContactRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/DeleteContactResponse"
            }
          },
          "404": {
            "description": "URL Not Found"
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    }
  },
  "definitions": {
    "LoginRequest": {
      "type": "object",
      "required": [
        "login",
        "password"
      ],
      "properties": {
        "login": {
          "type": "string",
          "example": "RickL"
        },
        "password": {
          "type": "string",
          "example": "COP4331"
        }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "The unique ID of the authenticated user. Returns 0 on failure.",
          "example": 1
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the authenticated user. Empty string on failure.",
          "example": "Rick"
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the authenticated user. Empty string on failure.",
          "example": "Leinecker"
        },
        "error": {
          "type": "string",
          "description": "Error message on failure, empty string on success.",
          "example": ""
        }
      }
    },
    "RegisterRequest": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "login",
        "password"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "login": {
          "type": "string",
          "example": "jdoe"
        },
        "password": {
          "type": "string",
          "example": "secret"
        }
      }
    },
    "RegisterResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "The unique ID of the newly created user. Returns 0 on failure.",
          "example": 1
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the newly registered user. Empty string on failure.",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the newly registered user. Empty string on failure.",
          "example": "Doe"
        },
        "error": {
          "type": "string",
          "description": "Error message on failure (e.g. \"Username already exists\"), empty string on success.",
          "example": ""
        }
      }
    },
    "AddContactRequest": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "email",
        "phoneNumber",
        "userId"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "example": "Jane"
        },
        "lastName": {
          "type": "string",
          "example": "Smith"
        },
        "email": {
          "type": "string",
          "example": "jane.smith@email.com"
        },
        "phoneNumber": {
          "type": "string",
          "example": "407-555-1234"
        },
        "userId": {
          "type": "integer",
          "description": "The ID of the user adding the contact.",
          "example": 1
        }
      }
    },
    "AddContactResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "Success message on successful insertion. Empty string on failure.",
          "example": "Contact has been added"
        },
        "error": {
          "type": "string",
          "description": "Error message on failure. Possible values: \"emailExists\" if the email is already associated with a contact for this user, \"phoneExists\" if the phone number is already associated with a contact for this user, or a database error string. Empty string on success.\n",
          "example": ""
        }
      }
    },
    "SearchContactsRequest": {
      "type": "object",
      "required": [
        "search",
        "userId"
      ],
      "properties": {
        "search": {
          "type": "string",
          "description": "Partial search term matched against first name, last name, full name, email, and phone number.\n",
          "example": "jan"
        },
        "userId": {
          "type": "integer",
          "description": "The ID of the user whose contacts are being searched.",
          "example": 1
        }
      }
    },
    "ContactResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "description": "The unique ID of the contact.",
          "example": 7
        },
        "firstName": {
          "type": "string",
          "description": "The contact's first name.",
          "example": "Jane"
        },
        "lastName": {
          "type": "string",
          "description": "The contact's last name.",
          "example": "Smith"
        },
        "phone": {
          "type": "string",
          "description": "The contact's phone number.",
          "example": "407-555-1234"
        },
        "email": {
          "type": "string",
          "description": "The contact's email address.",
          "example": "jane.smith@email.com"
        }
      }
    },
    "SearchContactsResponse": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "description": "Array of contacts matching the search term. Empty array on failure.",
          "items": {
            "$ref": "#/definitions/ContactResult"
          }
        },
        "error": {
          "type": "string",
          "description": "Error message on failure. Possible values: \"No Records Found\" if no contacts match, \"Missing required fields\" if search or userId is absent, or a database error string. Empty string on success.\n",
          "example": ""
        }
      }
    },
    "EditContactRequest": {
      "type": "object",
      "required": [
        "id",
        "userId",
        "firstName",
        "lastName",
        "phone",
        "email"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "The unique ID of the contact to update.",
          "example": 7
        },
        "userId": {
          "type": "integer",
          "description": "The ID of the user who owns the contact.",
          "example": 42
        },
        "firstName": {
          "type": "string",
          "description": "The updated first name of the contact.",
          "example": "Jane"
        },
        "lastName": {
          "type": "string",
          "description": "The updated last name of the contact.",
          "example": "Smith"
        },
        "phone": {
          "type": "string",
          "description": "The updated phone number of the contact.",
          "example": "407-555-5678"
        },
        "email": {
          "type": "string",
          "description": "The updated email address of the contact.",
          "example": "jane.updated@email.com"
        }
      }
    },
    "EditContactResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "Success message on successful update. Empty string on failure.",
          "example": "Contact updated successfully"
        },
        "error": {
          "type": "string",
          "description": "Error message on failure. Possible values: \"No contact found to update or no changes made\" if the contact ID and userId do not match any record or the data is identical, \"Missing required fields\" if any required field is absent, or a database error string. Empty string on success.\n",
          "example": ""
        }
      }
    },
    "DeleteContactRequest": {
      "type": "object",
      "required": [
        "id",
        "userId"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "description": "The unique ID of the contact to delete.",
          "example": 7
        },
        "userId": {
          "type": "integer",
          "description": "The ID of the user who owns the contact.",
          "example": 42
        }
      }
    },
    "DeleteContactResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "Success message on successful deletion. Empty string on failure.",
          "example": "Contact deleted successfully"
        },
        "error": {
          "type": "string",
          "description": "Error message on failure. Possible values: \"No contact found to delete or you don't have permission\" if the contact ID and userId do not match any record, \"Missing required fields\" if id or userId is absent, or a database error string. Empty string on success.\n",
          "example": ""
        }
      }
    }
  },
  "host": "cop-4331-22.com",
  "basePath": "/LAMPAPI",
  "schemes": [
    "http"
  ]
}