          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "Bearer jwtdf1e854d0804f07d3e43e7d7fc391178..."
          },
          {
            "name": "codBoleto",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 123456
            }
          }
        ],
        "security": [
          {
            "centralSeguranca": [
              "write_grb"
            ]
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PendenteConfirmarDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/retorno"
                }
