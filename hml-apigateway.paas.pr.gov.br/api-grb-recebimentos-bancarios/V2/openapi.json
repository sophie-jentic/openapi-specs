  "paths": {
    "/gerar": {
      "post": {
        "description": "Gerar e registrar junto ao Banco um boleto de cobranca.",
        "parameters": [
          {
            "name": "consumerId",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "MEUSISTEMA"
          },
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "Bearer jwtdf1e854d0804f07d3e43e7d7fc391178..."
          }
        ],
        "security": [
          {
            "centralSeguranca": [
              "write_grb"
            ]
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitacaoBoletoDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/retorno"
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/retorno"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/retorno"
                }
              }
            }
          }
        }
      }
    },
    "/obter/{codBoleto}": {
      "get": {
        "description": "Obter os dados de boleto",
        "parameters": [
          {
            "name": "consumerId",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": true,
            "example": "MEUSISTEMA"
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Bearer jwt331746b131fe93dd18e9d7ef5d77a127..."
          },
          {
            "name": "codBoleto",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "codOrgao",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "codSistema",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "indGeraBoletoPdf",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "mostrarMovimento",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "anexarArquivoRetorno",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "security": [
          {
            "centralSeguranca": [
              "write_grb"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/retornoJsonXml"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/detalhe"
                }
              }
            }
          }
        }
      }
    },
