            "required": true,
            "example": "Bearer jwtdf1e854d0804f07d3e43e7d7fc391178..."
          },
          {
            "name": "codOrgao",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "codSistema",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "centralSeguranca": [
              "write_grb"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/retornoJsonXml"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/detalhe"
                }
              }
            }
          }
        }
      }
    },
