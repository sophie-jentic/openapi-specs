                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "jackets"
        ],
        "summary": "Add a new jacket product",
        "description": "Add a new jacket to the store inventory.",
        "requestBody": {
          "required": true,
