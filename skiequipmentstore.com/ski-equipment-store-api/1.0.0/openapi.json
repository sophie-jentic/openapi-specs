  },
  "components": {
    "schemas": {
      "Ski": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "price"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 101
          },
          "name": {
            "type": "string",
            "example": "All-Mountain Ski 170cm"
          },
          "brand": {
            "$ref": "#/components/schemas/Brand"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 499.99
          },
          "description": {
            "type": "string",
            "example": "Versatile ski suitable for all mountain conditions."
          }
        }
      },
      "Pole": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "price"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 201
          },
          "name": {
            "type": "string",
            "example": "Carbon Fiber Ski Pole"
          },
          "brand": {
            "$ref": "#/components/schemas/Brand"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 89.99
          },
          "length": {
            "type": "integer",
            "description": "Length in centimeters",
            "example": 130
          }
        }
      },
      "Glove": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "price"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 301
          },
          "name": {
            "type": "string",
            "example": "Waterproof Ski Gloves"
          },
          "brand": {
            "$ref": "#/components/schemas/Brand"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 59.99
          },
          "size": {
            "type": "string",
            "example": "M"
          }
        }
      },
      "Hat": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "price"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 401
          },
          "name": {
            "type": "string",
            "example": "Thermal Ski Hat"
          },
          "brand": {
            "$ref": "#/components/schemas/Brand"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 29.99
          },
          "color": {
            "type": "string",
            "example": "Red"
          }
        }
      },
      "Jacket": {
        "type": "object",
        "required": [
          "id",
          "name",
          "brand",
          "price"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 501
          },
          "name": {
            "type": "string",
            "example": "Insulated Ski Jacket"
          },
          "brand": {
            "$ref": "#/components/schemas/Brand"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 199.99
          },
          "size": {
            "type": "string",
            "example": "L"
          },
          "waterproof": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Brand": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "SnowMaster"
          },
          "country": {
            "type": "string",
            "example": "USA"
          }
        }
      },
      "PurchaseOrder": {
        "type": "object",
        "required": [
          "items",
          "customerName",
          "customerEmail"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "List of items to purchase",
            "items": {
              "type": "object",
              "required": [
                "productId",
                "quantity",
                "productType"
              ],
              "properties": {
                "productId": {
                  "type": "integer",
                  "format": "int64",
                  "example": 101
                },
                "productType": {
                  "type": "string",
                  "description": "Type of product (ski, pole, glove, hat, jacket)",
                  "enum": [
                    "ski",
                    "pole",
                    "glove",
                    "hat",
                    "jacket"
                  ]
                },
                "quantity": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          },
          "customerName": {
            "type": "string",
            "example": "Jane Doe"
          },
          "customerEmail": {
            "type": "string",
            "format": "email",
            "example": "jane.doe@example.com"
          },
          "shippingAddress": {
            "type": "string",
            "example": "123 Mountain Rd, Ski Town, CO"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "credit_card",
              "paypal",
              "bank_transfer"
            ],
            "example": "credit_card"
          }
        }
      },
      "PurchaseOrderResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int64",
            "example": 1001
          },
          "status": {
            "type": "string",
            "example": "confirmed"
          },
          "estimatedDelivery": {
            "type": "string",
            "format": "date",
            "example": "2024-12-15"
          },
          "totalAmount": {
            "type": "number",
            "format": "float",
            "example": 789.97
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "400"
          },
          "message": {
            "type": "string",
            "example": "Invalid request parameters"
          }
        }
      }
    }
  }
}