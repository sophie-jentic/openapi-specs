{
  "openapi": "3.0.4",
  "info": {
    "title": "Ski Equipment Store API",
    "description": "API for a ski equipment website including pricing, brands, and purchase options.",
    "version": "1.0.0",
    "contact": {
      "email": "support@skiequipmentstore.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/rcplan/Ski-Store-API-2/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.skiequipmentstore.com/v1"
    }
  ],
  "tags": [
    {
      "name": "skis",
      "description": "Operations related to skis"
    },
    {
      "name": "poles",
      "description": "Operations related to ski poles"
    },
    {
      "name": "gloves",
      "description": "Operations related to gloves"
    },
    {
      "name": "hats",
      "description": "Operations related to hats"
    },
    {
      "name": "jackets",
      "description": "Operations related to jackets"
    },
    {
      "name": "brands",
      "description": "Information about brands"
    },
    {
      "name": "purchase",
      "description": "Purchase and order operations"
    }
  ],
  "paths": {
    "/skis": {
      "get": {
        "tags": [
          "skis"
        ],
        "summary": "List all skis",
        "description": "Retrieve a list of all skis with pricing and brand information.",
        "responses": {
          "200": {
            "description": "A list of skis",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ski"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "skis"
        ],
        "summary": "Add a new ski product",
        "description": "Add a new ski to the store inventory.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ski"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ski added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ski"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
