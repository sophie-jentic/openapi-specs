{
  "openapi": "3.0.3",
  "info": {
    "title": "Running Certification API",
    "version": "1.0.0",
    "description": "사용자가 presigned URL로 이미지를 업로드한 뒤, 해당 업로드를 러닝 인증으로 등록해달라고 요청하는 API.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/nkt-9c0/certifications/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.예제.com"
    }
  ],
  "paths": {
    "/certifications": {
      "post": {
        "summary": "러닝 인증(업로드 완료)",
        "description": "사용자가 presigned URL로 이미지를 업로드한 뒤,\n해당 업로드를 러닝 인증으로 등록해달라고 요청하는 API입니다.\n업로드를 식별하는 `uploadId`를 바디로 전달하며,\n서버는 이를 기반으로 러닝 인증을 생성합니다.\n",
        "operationId": "createCertification",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "Certifications"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "멱등성 보장을 위한 요청 고유 키.\n동일한 인증 요청을 재시도할 때 반드시 같은 값을 보내야 함.\n네트워크 재전송/중복 클릭 시에도 중복 인증이 생성되지 않도록,\n서버가 이 키 기준으로 중복 요청을 판별합니다.\n",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "description": "(선택) 요청 추적용 ID.\n서버 로그 / 모니터링에서 디버깅할 때 사용.\n클라이언트에서 넣어주면 서버가 그대로 로그에 남깁니다.\n",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificationRequest"
              },
              "examples": {
                "default": {
                  "summary": "기본 요청 예시",
                  "value": {
                    "uploadId": "upload_a81fe1",
                    "type": "RUNNING",
                    "imageKey": "users/123/uploads/run_20250110_1412.jpg",
                    "exerciseAt": "2025-01-10T14:12:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "인증 생성 성공",
            "headers": {
              "Location": {
                "description": "생성된 인증 리소스의 URI. 멱등성 재시도 시에도 동일한 URI 반환.",
                "schema": {
                  "type": "string",
                  "example": "/certifications/cert_9f3bc1"
                }
              },
              "Idempotency-Key": {
                "description": "요청에서 전달받은 Idempotency-Key를 그대로 반환. 요청–응답 매칭을 용이하게 함.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificationResponse"
                },
                "examples": {
                  "default": {
                    "summary": "성공 응답 예시",
                    "value": {
                      "certificationId": "cert_9f3bc1",
                      "uploadId": "upload_a81fe1",
                      "type": "RUNNING",
                      "status": "PENDING_OCR",
                      "exerciseAt": "2025-01-10T14:12:00Z",
                      "createdAt": "2025-01-10T14:12:10Z",
                      "message": "러닝 인증이 등록되었습니다. 잠시 후 결과가 처리됩니다."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청(잘못된 필드 값, 타입, 비정상적인 exerciseAt 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidRequest": {
                    "summary": "잘못된 요청 예시",
                    "value": {
                      "error": {
                        "code": "INVALID_REQUEST",
                        "message": "요청 형식이 올바르지 않습니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증 필요 (로그인 안 됨, 토큰 문제)",
            "headers": {
              "WWW-Authenticate": {
                "description": "인증 방식 및 인증 방법 안내",
                "schema": {
                  "type": "string",
                  "example": "Bearer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unauthorized": {
                    "summary": "인증 필요 예시",
                    "value": {
                      "error": {
                        "code": "UNAUTHORIZED",
                        "message": "로그인이 필요합니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "권한 부족 (향후 Role/Scope 도입 시 사용 가능)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "forbidden": {
                    "summary": "권한 부족 예시",
                    "value": {
                      "error": {
                        "code": "FORBIDDEN",
                        "message": "해당 작업을 수행할 권한이 없습니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "리소스를 찾을 수 없음 (존재하지 않는 uploadId 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "summary": "리소스 없음 예시",
                    "value": {
                      "error": {
                        "code": "NOT_FOUND",
                        "message": "요청한 리소스를 찾을 수 없습니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "중복 요청 / 충돌 (이미 처리된 요청, 중복 인증 등)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "duplicateRequest": {
                    "summary": "Idempotency-Key 중복 예시",
                    "value": {
                      "error": {
                        "code": "DUPLICATE_REQUEST",
                        "message": "이미 처리된 요청입니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "너무 많은 요청 (Rate Limit / Throttling)",
            "headers": {
              "Retry-After": {
                "description": "다시 요청해도 되는까지의 대기 시간(초)",
                "schema": {
                  "type": "integer",
                  "example": 5
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "rateLimitExceeded": {
                    "summary": "너무 많은 요청 예시",
                    "value": {
                      "error": {
                        "code": "RATE_LIMIT_EXCEEDED",
                        "message": "요청이 너무 많습니다. 잠시 후 다시 시도해주세요."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CertificationRequest": {
        "type": "object",
        "required": [
          "uploadId",
          "type",
          "imageKey",
          "exerciseAt"
        ],
        "properties": {
          "uploadId": {
            "type": "string",
            "description": "presigned URL 발급 시 생성된 업로드 식별자",
            "example": "upload_a81fe1"
          },
          "type": {
            "type": "string",
            "description": "인증 유형. RUNNING / WORKOUT 등 (초기에는 RUNNING으로 고정)",
            "example": "RUNNING"
          },
          "imageKey": {
            "type": "string",
            "description": "S3에 업로드된 실제 이미지의 Key. presigned 발급 때 받은 값 그대로 전달",
            "example": "users/123/uploads/run_20250110_1412.jpg"
          },
          "exerciseAt": {
            "type": "string",
            "format": "date-time",
            "description": "사용자가 실제로 운동을 수행한 시각 (RFC 3339)",
            "example": "2025-01-10T14:12:00Z"
          }
        }
      },
      "CertificationResponse": {
        "type": "object",
        "required": [
          "certificationId",
          "uploadId",
          "type",
          "status",
          "exerciseAt",
          "createdAt"
        ],
        "properties": {
          "certificationId": {
            "type": "string",
            "description": "생성된 인증의 고유 식별자",
            "example": "cert_9f3bc1"
          },
          "uploadId": {
            "type": "string",
            "description": "요청에 전달된 uploadId (멱등성 재시도 시 동일 값)",
            "example": "upload_a81fe1"
          },
          "type": {
            "type": "string",
            "description": "인증 유형. RUNNING / WORKOUT 등",
            "example": "RUNNING"
          },
          "status": {
            "type": "string",
            "description": "현재 인증 상태. PENDING_OCR / DUPLICATED",
            "example": "PENDING_OCR"
          },
          "exerciseAt": {
            "type": "string",
            "format": "date-time",
            "description": "운동 수행 시각 (RFC 3339)",
            "example": "2025-01-10T14:12:00Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "인증 레코드 생성 시간 (RFC 3339)",
            "example": "2025-01-10T14:12:10Z"
          },
          "message": {
            "type": "string",
            "description": "사용자에게 보여줄 수 있는 간단한 안내 메시지",
            "example": "러닝 인증이 등록되었습니다. 잠시 후 결과가 처리됩니다."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "에러 코드 (도메인/기술 조합)",
                "example": "INVALID_REQUEST"
              },
              "message": {
                "type": "string",
                "description": "사용자 또는 클라이언트에게 보여줄 에러 메시지",
                "example": "요청 형식이 올바르지 않습니다."
              }
            }
          }
        }
      }
    }
  }
}
