{
  "openapi": "3.0.0",
  "info": {
    "title": "EatUp API",
    "description": "API pour la plateforme de livraison de repas EatUp au Burkina Faso",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/eatup/eatup-api/1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Serveur de d\u00e9veloppement local"
    },
    {
      "url": "https://api.eatup.bf/api",
      "description": "Serveur de production"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentification Clients"
    },
    {
      "name": "Driver Auth",
      "description": "Authentification Livreurs"
    },
    {
      "name": "Restaurants",
      "description": "Consultation des restaurants (Client )"
    },
    {
      "name": "Restaurant Owner",
      "description": "Gestion du restaurant (Propri\u00e9taire)"
    },
    {
      "name": "Orders",
      "description": "Gestion des commandes (Client)"
    },
    {
      "name": "Delivery",
      "description": "Gestion des livraisons (Livreur)"
    }
  ],
  "paths": {
    "/auth/send-otp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Envoyer un code OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "+22670123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify-otp": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "V\u00e9rifier le code OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "+22670123456"
                  },
                  "code": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Connexion classique (T\u00e9l\u00e9phone + Mot de passe)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "+22670222222"
                  },
                  "password": {
                    "type": "string",
                    "example": "Test123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/driver/auth/signup": {
      "post": {
        "tags": [
          "Driver Auth"
        ],
        "summary": "Inscription d'un nouveau livreur",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "vehicle_type": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cr\u00e9\u00e9",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/driver/auth/login": {
      "post": {
        "tags": [
          "Driver Auth"
        ],
        "summary": "Connexion livreur",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/restaurants": {
      "get": {
        "tags": [
          "Restaurants"
        ],
        "summary": "Liste des restaurants actifs",
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/restaurants/{id}": {
      "get": {
        "tags": [
          "Restaurants"
        ],
        "summary": "D\u00e9tails d'un restaurant et son menu",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/restaurants/{restaurantId}/orders": {
      "get": {
        "tags": [
          "Restaurant Owner"
        ],
        "summary": "Voir les commandes re\u00e7ues par le restaurant",
        "parameters": [
          {
            "name": "restaurantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/restaurants/orders/{orderId}/status": {
      "patch": {
        "tags": [
          "Restaurant Owner"
        ],
        "summary": "Changer le statut d'une commande",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "example": "ready"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Cr\u00e9er une nouvelle commande",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "restaurantId": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "deliveryAddress": {
                    "type": "string"
                  },
                  "quartier": {
                    "type": "string"
                  },
                  "pointDeRepere": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cr\u00e9\u00e9",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/orders/history": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Historique des commandes du client",
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/delivery/available": {
      "get": {
        "tags": [
          "Delivery"
        ],
        "summary": "Liste des commandes pr\u00eates \u00e0 \u00eatre livr\u00e9es",
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/delivery/orders/{orderId}/accept": {
      "patch": {
        "tags": [
          "Delivery"
        ],
        "summary": "Le livreur accepte une commande",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/delivery/orders/{orderId}/deliver": {
      "patch": {
        "tags": [
          "Delivery"
        ],
        "summary": "Marquer la commande comme livr\u00e9e",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Succ\u00e8s",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "V\u00e9rifier l'\u00e9tat du serveur",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}