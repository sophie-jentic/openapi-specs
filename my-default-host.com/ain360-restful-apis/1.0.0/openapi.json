          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Request status",
                      "type": "boolean",
                      "example": false
                    },
                    "status_code": {
                      "description": "HTTP status code",
                      "type": "integer",
                      "example": 401
                    },
                    "message": {
                      "description": "Error message",
                      "type": "string",
                      "example": "Invalid credentials"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Request status",
                      "type": "boolean",
                      "example": false
                    },
                    "status_code": {
                      "description": "HTTP status code",
                      "type": "integer",
                      "example": 422
                    },
                    "message": {
                      "description": "Error message",
                      "type": "string",
                      "example": "Validation failed"
                    },
                    "errors": {
                      "description": "Validation errors by field",
                      "properties": {
                        "email": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "example": "The email field is required."
                          }
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
