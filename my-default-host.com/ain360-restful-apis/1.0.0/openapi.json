        ],
        "summary": "Refresh JWT token",
        "description": "Generate a new JWT access token using the current token. The old token will be invalidated.",
        "operationId": "b2eae7a8032954d25b46c7ec6f489c68",
        "responses": {
          "200": {
            "description": "Token refreshed successfully",
            "content": {
