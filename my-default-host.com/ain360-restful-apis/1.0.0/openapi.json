  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "description": "Create a new user account with email and password. Returns user details and JWT authentication token.",
        "operationId": "d764dd091cc4494ae0baf360b03319f3",
        "requestBody": {
          "description": "User registration data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "name",
                  "email",
                  "password",
                  "password_confirmation"
                ],
                "properties": {
                  "name": {
                    "description": "Full name of the user",
                    "type": "string",
                    "maxLength": 255,
                    "example": "John Doe"
                  },
                  "email": {
                    "description": "Valid email address (must be unique)",
                    "type": "string",
                    "format": "email",
                    "maxLength": 255,
                    "example": "john@example.com"
                  },
                  "password": {
                    "description": "User password (minimum 6 characters)",
                    "type": "string",
                    "format": "password",
                    "minLength": 6,
                    "example": "password123"
                  },
                  "password_confirmation": {
                    "description": "Password confirmation (must match password)",
                    "type": "string",
                    "format": "password",
                    "minLength": 6,
                    "example": "password123"
                  },
                  "phone": {
                    "description": "Phone number with country code (optional)",
                    "type": "string",
                    "maxLength": 20,
                    "example": "+1234567890",
                    "nullable": true
                  },
                  "country_code": {
                    "description": "ISO 3166-1 alpha-2 country code - 2 uppercase letters (optional)",
                    "type": "string",
                    "maxLength": 2,
                    "minLength": 2,
                    "pattern": "^[A-Z]{2}$",
                    "example": "US",
                    "nullable": true
                  },
                  "status": {
                    "description": "User account status (optional, defaults to 'active')",
                    "type": "string",
                    "default": "active",
                    "enum": [
                      "active",
                      "inactive"
                    ],
                    "example": "active",
                    "nullable": true
                  },
                  "is_super_admin": {
                    "description": "Super admin privileges (optional, defaults to false)",
                    "type": "boolean",
                    "default": false,
                    "example": false,
                    "nullable": true
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Request status",
                      "type": "boolean",
                      "example": true
                    },
                    "status_code": {
                      "description": "HTTP status code",
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "description": "Success message",
                      "type": "string",
                      "example": "User registered successfully"
                    },
                    "data": {
                      "description": "Response data",
                      "properties": {
                        "user": {
                          "description": "Registered user information",
                          "properties": {
                            "id": {
                              "description": "User ID",
                              "type": "integer",
                              "format": "int64",
                              "example": 1
                            },
                            "name": {
                              "description": "User's full name",
                              "type": "string",
                              "example": "John Doe"
                            },
                            "email": {
                              "description": "User's email address",
                              "type": "string",
                              "format": "email",
                              "example": "john@example.com"
                            },
                            "phone": {
                              "description": "User's phone number",
                              "type": "string",
                              "example": "+1234567890",
                              "nullable": true
                            },
                            "country_code": {
                              "description": "Country code",
                              "type": "string",
                              "example": "US",
                              "nullable": true
                            },
                            "status": {
                              "description": "Account status",
                              "type": "string",
                              "example": "active"
                            },
                            "is_super_admin": {
                              "description": "Super admin privileges",
                              "type": "boolean",
                              "example": false
                            }
                          },
                          "type": "object"
                        },
                        "token": {
                          "description": "JWT access token",
                          "type": "string",
                          "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "description": "Request status",
                      "type": "boolean",
                      "example": false
                    },
                    "status_code": {
                      "description": "HTTP status code",
                      "type": "integer",
                      "example": 422
                    },
                    "message": {
                      "description": "Error message",
                      "type": "string",
                      "example": "Validation failed"
                    },
                    "errors": {
                      "description": "Validation errors by field",
                      "properties": {
                        "email": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "example": "This email is already registered."
                          }
                        },
                        "password": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "example": "Password confirmation does not match."
                          }
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
