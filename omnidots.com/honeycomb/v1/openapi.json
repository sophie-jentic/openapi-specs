            "description": "API authentication token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of sensors retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "sensors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Sensor"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing token parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenInvalidResponse"
                }
              }
            }
          }
        }
      }
    },
    "/get_peak_records": {
      "get": {
        "operationId": "getPeakRecords",
        "summary": "Fetch peak particle velocity/acceleration records",
        "description": "Retrieve peak particle velocity and acceleration records for a given measuring point within a specified time range. Returns dominant frequency and peak velocity for each axis.",
        "tags": ["Measurement Data"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "API authentication token",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "measuring_point_id",
            "in": "query",
            "required": true,
            "description": "ID of the measuring point to fetch records from",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "required": true,
            "description": "Start time in milliseconds since epoch",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "description": "End time in milliseconds since epoch",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Peak records retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "samples": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PeakRecord"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenInvalidResponse"
                }
              }
            }
          }
        }
      }
    },
