  },
  "components": {
    "securitySchemes": {
      "tokenAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "API token obtained via the /user/authenticate endpoint or generated from the Honeycomb token management page. Passed as a query parameter on all requests."
      }
    },
    "schemas": {
      "MeasuringPoint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique measuring point identifier"
          },
          "name": {
            "type": "string",
            "description": "Measuring point name"
          },
          "active": {
            "type": "boolean",
            "description": "Whether the measuring point is currently active"
          },
          "category": {
            "type": "string",
            "description": "Category classification (e.g., CAT1, CAT2, CAT3)"
          },
          "building_level": {
            "type": "string",
            "description": "Building structure classification"
          },
          "guide_line": {
            "type": "string",
            "description": "Vibration guideline standard (e.g., Circulaire86, BS7385_250Hz, DIN4150_2)"
          },
          "measuring_type": {
            "type": "string",
            "enum": ["indicative", "limited", "extensive"],
            "description": "Type of measurement"
          },
          "vibration_type": {
            "type": "string",
            "enum": ["longTerm", "continually", "continuous", "shortTerm", "repeated", "momentarily", "peak", "impulsive"],
            "description": "Type of vibration being measured"
          },
          "data_save_level": {
            "type": "number",
            "description": "Threshold in mm/s for recording data"
          },
          "trace_save_level": {
            "type": "number",
            "description": "Threshold in mm/s for recording traces"
          },
          "measurement_duration": {
            "type": "number",
            "description": "Sampling interval in seconds"
          },
          "trace_pre_trigger": {
            "type": "number",
            "description": "Pre-event capture window in seconds"
          },
          "trace_post_trigger": {
            "type": "number",
            "description": "Post-event capture window in seconds"
          },
          "log_flush_interval": {
            "type": "integer",
            "description": "Seconds between non-alarm measurement transmissions"
          },
          "disable_led": {
            "type": "boolean",
            "description": "Whether the front LED is disabled"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone identifier"
          },
          "schedule_enable_0": {
            "type": "string",
            "description": "Sunday enable time (HH:mm:ss)"
          },
          "schedule_disable_0": {
            "type": "string",
            "description": "Sunday disable time (HH:mm:ss)"
          },
          "schedule_enable_1": {
            "type": "string",
            "description": "Monday enable time (HH:mm:ss)"
          },
          "schedule_disable_1": {
            "type": "string",
            "description": "Monday disable time (HH:mm:ss)"
          },
          "schedule_enable_2": {
            "type": "string",
            "description": "Tuesday enable time (HH:mm:ss)"
          },
          "schedule_disable_2": {
            "type": "string",
            "description": "Tuesday disable time (HH:mm:ss)"
