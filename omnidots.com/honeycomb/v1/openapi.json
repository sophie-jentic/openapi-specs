{
  "openapi": "3.0.3",
  "info": {
    "title": "Honeycomb by Omnidots API",
    "description": "Vibration monitoring and sensor data API for the Honeycomb platform by Omnidots. Provides access to vibration measurement data including peak particle velocity, VDV (Vibration Dose Value), and Veff/KB records from deployed sensors and measuring points. Supports user authentication, sensor management, measuring point configuration, and detailed trace data retrieval.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://honeycomb.omnidots.com/api/docs"
  },
  "servers": [
    {
      "url": "https://honeycomb.omnidots.com/api/v1",
      "description": "Honeycomb API v1 Production"
    }
  ],
  "paths": {
    "/user/authenticate": {
      "post": {
        "operationId": "authenticateUser",
        "summary": "Authenticate user and obtain API token",
        "description": "Authenticate with username and password to receive a temporary API token. The token expires after 14 days of inactivity; each API call resets the expiration timer.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "User's username"
                  },
                  "password": {
                    "type": "string",
                    "description": "User's password"
                  }
                },
                "required": ["username", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "token": {
                      "type": "string",
                      "description": "Temporary API token valid for 14 days of inactivity",
                      "example": "702811da14ff4225973c4054ed52bb9f"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "username and/or password wrong"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/user/account": {
      "get": {
        "operationId": "getUserAccount",
        "summary": "Get user account details",
        "description": "Retrieve the authenticated user's account information including name and email.",
        "tags": ["Authentication"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "API authentication token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "account": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string"
                        },
                        "first_name": {
                          "type": "string"
                        },
                        "last_name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing token parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenInvalidResponse"
                }
              }
            }
          }
        }
      }
    },
    "/token_details": {
      "get": {
        "operationId": "getTokenDetails",
        "summary": "Validate token and get account info",
        "description": "Test the validity of an API token and return associated account information if valid.",
        "tags": ["Authentication"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "API authentication token to validate",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token is valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "token_description": {
                      "type": "string",
                      "description": "Human-readable description of the token's purpose"
                    },
                    "username": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Token not supplied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Token not supplied"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenInvalidResponse"
                }
              }
            }
          }
        }
      }
    },
    "/list_measuring_points": {
      "get": {
        "operationId": "listMeasuringPoints",
        "summary": "List accessible measuring points",
        "description": "Retrieve a list of all measuring points accessible by the authenticated token. Returns configuration details, sensor information, and location data for each measuring point.",
        "tags": ["Measuring Points"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "API authentication token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of measuring points retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "measuring_points": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MeasuringPoint"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing token parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenInvalidResponse"
                }
              }
            }
          }
        }
      }
    },
    "/configure_measuring_point": {
      "post": {
        "operationId": "configureMeasuringPoint",
        "summary": "Configure a measuring point",
        "description": "Create or update a measuring point configuration. Omit measuring_point_id to create a new measuring point. Includes settings for measurement standards, data capture thresholds, alarm levels, scheduling, and webhook notifications.",
        "tags": ["Measuring Points"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "API authentication token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeasuringPointConfig"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Measuring point configured successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid configuration parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenInvalidResponse"
                }
              }
            }
          }
        }
      }
    },
    "/list_sensors": {
      "get": {
        "operationId": "listSensors",
        "summary": "List accessible sensors",
        "description": "Retrieve a list of currently active sensors accessible by the authenticated token. Only returns current active sensors, not historical ones.",
        "tags": ["Sensors"],
        "parameters": [
          {
            "name": "token",
            "in": "query",
