                "example": "UNPROCESSABLE_ENTITY"
              },
              "message": {
                "type": "string",
                "description": "error message",
                "example": "Argument error: parameter {wrong parameter name} is not accepted"
              }
            }
          }
        }
      },
      "AuthenticationError": {
        "type": "object",
