                "type": "string"
              }
            }
          }
        }
      },
      "EncuestaRequest": {
        "type": "object",
        "required": [
          "numEncuesta",
          "remesa",
          "respuestas"
        ],
        "properties": {
          "numEncuesta": {
            "type": "integer",
            "description": "N\u00famero \u00fanico de encuesta dentro de la remesa",
            "example": 1
          },
          "remesa": {
            "type": "object",
            "required": [
              "id",
              "cuestionario"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "ID de la remesa",
                "example": 7766
              },
              "cuestionario": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "description": "ID del cuestionario (debe coincidir con el de la remesa)",
                    "example": 217
                  }
                }
              }
            }
          },
          "respuestas": {
            "type": "array",
            "description": "Array de respuestas a las preguntas del cuestionario",
            "items": {
              "$ref": "#/components/schemas/RespuestaInput"
            }
          },
          "comentarios": {
            "type": "array",
            "description": "Array opcional de comentarios de texto libre",
            "items": {
              "$ref": "#/components/schemas/ComentarioInput"
            }
          }
        }
      },
      "RespuestaInput": {
        "type": "object",
        "required": [
          "pregunta",
          "tipoRespuesta"
        ],
        "properties": {
          "pregunta": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "ID de la pregunta del cuestionario",
                "example": 3184
              }
            }
          },
          "tipoRespuesta": {
            "type": "object",
            "required": [
              "id",
              "valor"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "ID del tipo de respuesta",
                "example": 3
              },
              "valor": {
                "type": "string",
                "description": "Texto del valor de la respuesta",
                "example": "Muy contento"
              }
            }
          },
          "valor": {
            "type": "string",
            "nullable": true,
            "description": "Valor adicional si aplica (puede ser null)",
            "example": null
          }
        }
      },
      "ComentarioInput": {
        "type": "object",
        "required": [
          "texto",
          "tipoComentario"
        ],
        "properties": {
          "texto": {
            "type": "string",
            "description": "Texto del comentario extra\u00eddo de la encuesta f\u00edsica",
            "example": "La habitaci\u00f3n estaba muy limpia y el personal fue muy amable"
          },
          "tipoComentario": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "ID del tipo de comentario:\n- 1: Queja\n- 2: Sugerencia\n- 3: Felicitaci\u00f3n\n- 4: Comentario\n",
                "example": 3
              }
            }
          },
          "departamento": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "integer",
                "description": "ID del departamento relacionado (opcional)",
                "example": 2
              }
            }
          },
          "dimension": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "integer",
                "description": "ID de la dimensi\u00f3n relacionada (opcional)",
                "example": 1
              }
            }
          },
          "etiquetas": {
            "type": "array",
            "description": "Array opcional de etiquetas asociadas",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "example": 328
                }
              }
            }
          }
        }
      },
      "EncuestaResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID de la encuesta creada en el sistema",
            "example": 470791
          },
          "numEncuesta": {
            "type": "integer",
            "example": 1
          },
          "remesa": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 7766
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Estado de la encuesta",
            "example": "PROCESADA"
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-13T10:30:00Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Tipo de error",
            "example": "Validation Error"
          },
          "message": {
            "type": "string",
            "description": "Mensaje descriptivo del error",
            "example": "El ID de pregunta 9999 no existe en el cuestionario 217"
          },
          "code": {
            "type": "string",
            "description": "C\u00f3digo de error para debugging",
            "example": "VALIDATION_ERROR"
          }
        }
      }
    }
  }
}