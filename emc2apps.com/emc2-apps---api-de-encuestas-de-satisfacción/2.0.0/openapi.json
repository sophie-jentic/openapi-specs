{
  "openapi": "3.0.3",
  "info": {
    "title": "EMC2 Apps - API de Encuestas de Satisfacci\u00f3n",
    "description": "API para la gesti\u00f3n y carga automatizada de encuestas de satisfacci\u00f3n f\u00edsicas digitalizadas.\n\n## Flujo de autenticaci\u00f3n\n1. Realizar login en `/Usuarios/LogIn` para obtener token JWT\n2. Incluir el token en todas las llamadas posteriores: `Authorization: Bearer {token}`\n\n## Flujo principal\n### Fase inicial (una vez por sesi\u00f3n):\n1. Login \u2192 Obtener token\n2. GET /Cuestionarios \u2192 Cargar todos los cuestionarios\n3. GET /Remesas \u2192 Cargar todas las remesas y mapear con cuestionarios\n4. GET /TiposComentario \u2192 Cargar cat\u00e1logo de tipos\n\n### Fase por encuesta (repetir por cada encuesta):\n5. Identificar cuestionario de la encuesta f\u00edsica\n6. GET /Cuestionarios/{id} \u2192 Obtener preguntas\n7. GET /Cuestionarios/{id}/Departamentos \u2192 Obtener departamentos\n8. GET /Cuestionarios/{id}/Dimensiones \u2192 Obtener dimensiones\n9. GET /Etiquetas?cuestionarioId={id} \u2192 Obtener etiquetas\n10. POST /Remesas/{id}/Encuestas \u2192 Enviar encuesta procesada\n",
    "version": "2.0.0",
    "contact": {
      "name": "MC2 Calidad - Soporte T\u00e9cnico",
      "email": "soporte@mc2calidad.com"
    },
    "termsOfService": "https://www.emc2apps.com/terminos",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/keldai/emc2-apps-api-de-encuestas-de-satisfaccion/2.0.0"
  },
  "servers": [
    {
      "url": "https://api.emc2apps.com/EMC2GeneralWS/resources",
      "description": "Servidor de autenticaci\u00f3n"
    },
    {
      "url": "https://api.emc2apps.com/EMC2WS/resources",
      "description": "Servidor principal de API"
    }
  ],
  "tags": [
    {
      "name": "Autenticaci\u00f3n",
      "description": "Endpoints de login y gesti\u00f3n de tokens"
    },
    {
      "name": "Cat\u00e1logos",
      "description": "Endpoints para cargar cat\u00e1logos generales (cuestionarios, remesas, tipos)"
    },
    {
      "name": "Cuestionario",
      "description": "Endpoints para obtener datos espec\u00edficos de un cuestionario"
    },
    {
      "name": "Encuestas",
      "description": "Endpoints para enviar encuestas procesadas"
    }
  ],
  "paths": {
    "/Usuarios/LogIn": {
      "post": {
        "tags": [
          "Autenticaci\u00f3n"
        ],
        "summary": "Login de usuario",
        "description": "Autenticaci\u00f3n de usuario para obtener token JWT.\nEl token debe incluirse en todas las llamadas posteriores.\n",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "ejemplo1": {
                  "summary": "Login b\u00e1sico",
                  "value": {
                    "email": "usuario@ejemplo.com",
                    "password": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "examples": {
                  "ejemplo1": {
                    "summary": "Respuesta exitosa",
                    "value": {
                      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                      "usuario": {
                        "id": 123,
                        "nombre": "Juan P\u00e9rez",
                        "email": "usuario@ejemplo.com"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Formato de request incorrecto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
