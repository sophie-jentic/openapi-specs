    "/Remesas/{id}/Encuestas": {
      "post": {
        "tags": [
          "Encuestas"
        ],
        "summary": "Crear/enviar una encuesta procesada",
        "description": "Env\u00eda una encuesta f\u00edsica procesada al sistema.\n\n**IMPORTANTE:** Validar todos los IDs antes de enviar:\n- remesa.id existe y no est\u00e1 cerrada\n- cuestionario.id coincide con el de la remesa\n- Todos los pregunta.id existen en el cuestionario\n- Todos los tipoRespuesta.id son v\u00e1lidos\n- Todos los departamento.id, dimension.id y etiquetas.id existen\n\n**PENDIENTE CONFIRMAR:** \u00bfSe puede enviar array de encuestas o solo una?\n",
        "operationId": "createEncuesta",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID de la remesa donde se carga la encuesta",
            "schema": {
              "type": "integer"
            },
            "example": 7766
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EncuestaRequest"
              },
              "examples": {
                "ejemplo1": {
                  "summary": "Encuesta completa con respuestas y comentarios",
                  "value": {
                    "numEncuesta": 1,
                    "remesa": {
                      "id": 7766,
                      "cuestionario": {
                        "id": 217
                      }
                    },
                    "respuestas": [
                      {
                        "pregunta": {
                          "id": 3184
                        },
                        "tipoRespuesta": {
                          "id": 3,
                          "valor": "Muy contento"
                        },
                        "valor": null
                      },
                      {
                        "pregunta": {
                          "id": 3185
                        },
                        "tipoRespuesta": {
                          "id": 4,
                          "valor": "Contento"
                        },
                        "valor": null
                      }
                    ],
                    "comentarios": [
                      {
                        "texto": "La habitaci\u00f3n estaba muy limpia y el personal fue muy amable",
                        "tipoComentario": {
                          "id": 3
                        },
                        "departamento": {
                          "id": 2
                        },
                        "dimension": {
                          "id": 1
                        },
                        "etiquetas": [
                          {
                            "id": 328
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Encuesta creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EncuestaResponse"
                },
                "examples": {
                  "ejemplo1": {
                    "summary": "Respuesta exitosa",
                    "value": {
                      "id": 470791,
                      "numEncuesta": 1,
                      "remesa": {
                        "id": 7766
                      },
                      "status": "PROCESADA",
                      "fechaCreacion": "2026-01-13T10:30:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inv\u00e1lidos o formato incorrecto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "validacion": {
                    "summary": "Error de validaci\u00f3n",
                    "value": {
                      "error": "Validaci\u00f3n fallida",
                      "message": "El ID de pregunta 9999 no existe en el cuestionario 217",
                      "code": "VALIDATION_ERROR"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Remesa o cuestionario no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto - Encuesta duplicada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtenido del endpoint /Usuarios/LogIn.\nIncluir en header: Authorization: Bearer {token}\n"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Token no v\u00e1lido, expirado o no proporcionado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "tokenInvalido": {
                "summary": "Token inv\u00e1lido",
                "value": {
                  "error": "Unauthorized",
                  "message": "Token JWT inv\u00e1lido o expirado",
                  "code": "INVALID_TOKEN"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email del usuario",
            "example": "usuario@ejemplo.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Contrase\u00f1a del usuario",
            "example": "password123"
          }
        }
      },
      "LoginResponse": {
