            "example": 1
          },
          "nombre": {
            "type": "string",
            "example": "Queja"
          },
          "queja": {
            "type": "boolean"
          },
          "sugerencia": {
            "type": "boolean"
          },
          "felicitacion": {
            "type": "boolean"
          },
          "observacion": {
            "type": "boolean"
          }
