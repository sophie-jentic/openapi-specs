  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Auth using API Key ID as username and API Key Secret as password. Obtain keys from the Razorpay Dashboard under Settings > API Keys."
      }
    },
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Unique identifier of the order.", "example": "order_DBJOWzybf0sJbb" },
          "entity": { "type": "string", "example": "order" },
          "amount": { "type": "integer", "description": "Order amount in smallest currency sub-unit.", "example": 50000 },
          "amount_paid": { "type": "integer", "description": "Amount paid against the order.", "example": 0 },
          "amount_due": { "type": "integer", "description": "Amount remaining to be paid.", "example": 50000 },
          "currency": { "type": "string", "example": "INR" },
          "receipt": { "type": "string", "example": "receipt#1" },
          "offer_id": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["created", "attempted", "paid"], "example": "created" },
          "attempts": { "type": "integer", "example": 0 },
          "notes": { "type": "object", "additionalProperties": { "type": "string" } },
          "created_at": { "type": "integer", "description": "Unix timestamp of creation." }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "pay_FHfGzKyHkUTa4m" },
          "entity": { "type": "string", "example": "payment" },
          "amount": { "type": "integer", "example": 50000 },
          "currency": { "type": "string", "example": "INR" },
          "status": { "type": "string", "enum": ["created", "authorized", "captured", "refunded", "failed"], "example": "captured" },
          "order_id": { "type": "string", "example": "order_DBJOWzybf0sJbb" },
          "invoice_id": { "type": "string", "nullable": true },
          "international": { "type": "boolean" },
          "method": { "type": "string", "enum": ["card", "netbanking", "wallet", "emi", "upi", "bank_transfer"], "example": "upi" },
          "amount_refunded": { "type": "integer", "example": 0 },
          "refund_status": { "type": "string", "nullable": true, "enum": ["null", "partial", "full"] },
          "captured": { "type": "boolean" },
          "description": { "type": "string" },
          "card_id": { "type": "string", "nullable": true },
          "bank": { "type": "string", "nullable": true },
          "wallet": { "type": "string", "nullable": true },
          "vpa": { "type": "string", "nullable": true, "description": "Virtual Payment Address for UPI." },
          "email": { "type": "string" },
          "contact": { "type": "string" },
          "customer_id": { "type": "string", "nullable": true },
          "fee": { "type": "integer", "description": "Fee charged by Razorpay." },
          "tax": { "type": "integer", "description": "Tax on the fee." },
          "error_code": { "type": "string", "nullable": true },
          "error_description": { "type": "string", "nullable": true },
          "notes": { "type": "object", "additionalProperties": { "type": "string" } },
          "created_at": { "type": "integer" }
        }
      },
      "Refund": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "rfnd_FP8QHiV938haTz" },
          "entity": { "type": "string", "example": "refund" },
          "amount": { "type": "integer", "example": 50000 },
          "currency": { "type": "string", "example": "INR" },
          "payment_id": { "type": "string", "example": "pay_FHfGzKyHkUTa4m" },
          "notes": { "type": "object", "additionalProperties": { "type": "string" } },
          "receipt": { "type": "string", "nullable": true },
          "acquirer_data": {
            "type": "object",
            "properties": {
              "rrn": { "type": "string", "nullable": true }
            }
          },
          "status": { "type": "string", "enum": ["pending", "processed", "failed"], "example": "processed" },
          "speed_processed": { "type": "string", "enum": ["normal", "instant"] },
          "speed_requested": { "type": "string", "enum": ["normal", "optimum"] },
          "created_at": { "type": "integer" }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "cust_1Aa00000000004" },
          "entity": { "type": "string", "example": "customer" },
          "name": { "type": "string", "example": "Gaurav Kumar" },
          "email": { "type": "string", "example": "gaurav.kumar@example.com" },
          "contact": { "type": "string", "example": "9876543210" },
          "gstin": { "type": "string", "nullable": true },
          "notes": { "type": "object", "additionalProperties": { "type": "string" } },
          "created_at": { "type": "integer" }
        }
      },
      "PaymentLink": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "plink_ExjpAUN3gVHrPJ" },
          "amount": { "type": "integer", "example": 100000 },
          "currency": { "type": "string", "example": "INR" },
          "accept_partial": { "type": "boolean" },
          "first_min_partial_amount": { "type": "integer" },
          "description": { "type": "string" },
          "customer": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "email": { "type": "string" },
              "contact": { "type": "string" }
            }
          },
          "notify": {
            "type": "object",
            "properties": {
              "sms": { "type": "boolean" },
              "email": { "type": "boolean" }
            }
          },
          "reminder_enable": { "type": "boolean" },
          "expire_by": { "type": "integer" },
          "short_url": { "type": "string", "description": "Shortened URL for the payment link." },
          "status": { "type": "string", "enum": ["created", "partially_paid", "expired", "cancelled", "paid"] },
          "amount_paid": { "type": "integer" },
          "cancelled_at": { "type": "integer", "nullable": true },
          "expired_at": { "type": "integer", "nullable": true },
          "closed_at": { "type": "integer", "nullable": true },
          "notes": { "type": "object", "additionalProperties": { "type": "string" } },
          "created_at": { "type": "integer" },
          "updated_at": { "type": "integer" }
        }
      },
      "Settlement": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "setl_DGf4xzavSuhanK" },
          "entity": { "type": "string", "example": "settlement" },
          "amount": { "type": "integer" },
          "status": { "type": "string", "enum": ["created", "processed", "failed"] },
          "fees": { "type": "integer" },
          "tax": { "type": "integer" },
          "utr": { "type": "string", "description": "Unique Transaction Reference number." },
          "created_at": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "description": "Error code.", "example": "BAD_REQUEST_ERROR" },
              "description": { "type": "string", "description": "Human-readable error description." },
              "source": { "type": "string", "description": "Source of the error." },
              "step": { "type": "string", "description": "Step at which the error occurred." },
              "reason": { "type": "string", "description": "Reason for the error." },
              "metadata": { "type": "object" },
              "field": { "type": "string", "description": "Field that caused the error." }
            }
          }
        }
      }
    }
  }
}