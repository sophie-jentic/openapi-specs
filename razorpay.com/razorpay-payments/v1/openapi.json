                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/payments/{payment_id}/refund": {
      "post": {
        "operationId": "createRefundForPayment",
        "summary": "Create a refund for a payment",
        "description": "Create a normal or instant refund for a specific payment.",
        "tags": ["Refunds"],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the payment to refund.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount"],
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "Amount to be refunded in the smallest currency sub-unit.",
                    "example": 50000
                  },
                  "speed": {
                    "type": "string",
                    "description": "Speed of refund processing.",
                    "enum": ["normal", "optimum"],
                    "default": "normal"
                  },
                  "notes": {
                    "type": "object",
                    "description": "Key-value pairs for additional information.",
                    "additionalProperties": { "type": "string" }
                  },
                  "receipt": {
                    "type": "string",
                    "description": "Unique receipt number for the refund."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Refund" }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid refund amount or payment not refundable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
