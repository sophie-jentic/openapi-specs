    "/alerts": {
      "get": {
        "summary": "Get Alerts",
        "description": "Retrieve alerts for a campus",
        "tags": [
          "Integration"
        ],
        "security": [
          {
            "Integration_Authorizer": []
          }
        ],
        "parameters": [
          {
            "name": "campus_id",
            "in": "query",
            "required": true,
            "description": "PalCare campus ID",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "response_type",
            "in": "query",
            "required": false,
            "description": "Response type: 'normal' for V2 alerts only, 'all-alerts' for V2 and V4 alerts",
            "schema": {
              "type": "string",
              "enum": [
                "normal",
                "all-alerts"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Status": {
                      "type": "string",
                      "enum": [
                        "OK",
                        "Error"
                      ]
                    },
                    "ErrorCode": {
                      "type": "string"
                    },
                    "Content": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create or Fetch Alerts",
        "description": "Create a new alert or fetch alerts",
        "tags": [
          "Integration"
        ],
        "security": [
          {
            "Integration_Authorizer": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Alert request",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "campus_id": {
                    "type": "integer",
                    "description": "PalCare campus ID"
                  },
                  "request": {
                    "type": "string",
                    "enum": [
                      "fetch",
                      "create",
                      "create V2",
                      "clear"
                    ],
                    "description": "Action to perform"
                  },
                  "resident": {
                    "type": "object",
                    "description": "Resident information (required for create)"
                  },
                  "area": {
                    "type": "object",
                    "description": "Area information (required for create)"
                  },
                  "device": {
                    "type": "object",
                    "description": "Device information (required for create)"
                  },
                  "area_id": {
                    "type": "integer",
                    "description": "Area ID (required for create)"
                  },
                  "event_id": {
                    "type": "string",
                    "description": "Event ID to clear (required for clear)"
                  },
                  "username": {
                    "type": "string",
                    "description": "Username clearing the alert (required for clear)"
                  }
                },
                "required": [
                  "campus_id",
                  "request"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Alerts",
        "description": "Update existing alerts",
        "tags": [
          "Integration"
        ],
        "security": [
          {
            "Integration_Authorizer": []
