            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "fetch_and_normalize"
                    ],
                    "description": "Action type"
                  },
                  "client_id": {
                    "type": "string",
                    "description": "UCC client ID"
                  },
                  "campus_id": {
                    "type": "integer",
                    "description": "PalCare campus ID"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
