{
  "openapi": "3.1.0",
  "info": {
    "title": "DASP XForms API",
    "description": "This is a simple API for the Declarative Amsterdam 2025 conference to show how to build REST APIs in [Elemental](https://www.elemental.xyz) to work with [XForms](https://www.w3.org/community/xformsusers/). The impetus for the workshop and demo originally came from Steven Pemberton.\n\nSome useful links:\n- [The Elemental Slack Workspace](https://join.slack.com/t/elemental-xyz/shared_invite/zt-34r53san4-fzHCV0vDT9lYSMChUdn3cQ)\n- [Elemental's Documentation](https://www.elemental.xyz/documentation)\n- [agence XML's XSLTForms (XForms implementation)](https://www.agencexml.com/xsltforms)",
    "contact": {
      "email": "tech@evolvedbinary.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/evolvedbinary/dasp-xforms-api/1.0.0"
  },
  "externalDocs": {
    "description": "Find out more about Elemental",
    "url": "https://www.elemental.xyz"
  },
  "servers": [
    {
      "url": "https://localhost:8080/exist/restxq/dasp"
    }
  ],
  "tags": [
    {
      "name": "document",
      "description": "Resources about your documents"
    },
    {
      "name": "user",
      "description": "Resources about users of your system"
    },
    {
      "name": "member",
      "description": "These resources can be accessed by authorised users. If the resource is also available to the public, then an authorised user may have further access over and above the general public. If the resource is not also available to the public, then authentication is required."
    },
    {
      "name": "public",
      "description": "These resources may be accessed without authentication by the general public without authentication."
    }
  ],
