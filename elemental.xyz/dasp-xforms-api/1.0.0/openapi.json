  "components": {
    "schemas": {
      "Documents": {
        "description": "A list of documents.",
        "type": "array",
        "item-type": "#/components/schemas/Document",
        "xml": {
          "name": "documents",
          "prefix": "dasp",
          "namespace": "http://ns.declarative.amsterdam/dasp"
        }
      },
      "Document": {
        "description": "Metadata about a document.",
        "type": "object",
        "xml": {
          "name": "document",
          "prefix": "dasp",
          "namespace": "http://ns.declarative.amsterdam/dasp"
        },
        "required": [
          "id",
          "created",
          "last-modified",
          "owner",
          "group",
          "permissions"
        ],
        "properties": {
          "id": {
            "description": "The ID of the document.",
            "type": "string",
            "xml": {
              "attribute": true
            }
          },
          "created": {
            "description": "The date that the document was created.",
            "type": "string",
            "format": "date-time",
            "xml": {
              "attribute": true
            }
          },
          "last-modified": {
            "description": "The date that the document was last modified.",
            "type": "string",
            "format": "date-time",
            "xml": {
              "attribute": true
            }
          },
          "owner": {
            "description": "The owning user of the document.",
            "type": "string",
            "xml": {
              "attribute": true
            }
          },
          "group": {
            "description": "The owning group of the document.",
            "type": "string",
