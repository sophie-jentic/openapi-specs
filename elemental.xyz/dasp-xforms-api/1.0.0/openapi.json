              }
            },
            "application/json": {
              "schema": {
                "type": "string",
                "format": "json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created. Returns the identifier of the new Document.",
            "headers": {
              "Last-Modified": {
                "$ref": "#/components/headers/lastModified"
              },
              "Location": {
                "$ref": "#/components/headers/location"
              }
            },
            "content": {
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
