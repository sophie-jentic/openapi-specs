        ],
        "summary": "Envio de Laudo.",
        "description": "Envio de Laudo.",
        "operationId": "laudo",
        "parameters": [
          {
            "in": "path",
            "name": "domain",
            "description": "Dom\u00ednio.",
            "required": true,
            "type": "string"
          },
          {
            "in": "path",
