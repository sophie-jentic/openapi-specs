                },
                "conteudo": {
                  "type": "string",
                  "description": "Conte\u00fado do arquivo base64."
                },
                "conselho": {
                  "type": "string",
                  "description": "Conselho (Ex: CRM, CREFITO, etc).",
                  "example": "CRM"
                },
                "numeroConselho": {
                  "type": "string",
                  "description": "N\u00famero do Conselho.",
                  "example": "1234"
                },
                "estadoConselho": {
                  "type": "string",
                  "description": "UF do Conselho.",
                  "example": "BA"
                }
              }
            }
          }
