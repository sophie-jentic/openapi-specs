{
  "openapi": "3.0.0",
  "info": {
    "title": "ZooTicket Payment System API",
    "description": "API \u0434\u043b\u044f \u043e\u043f\u043b\u0430\u0442\u044b \u0431\u0438\u043b\u0435\u0442\u043e\u0432 \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u043b\u0430\u0442\u0435\u0436\u0430\u043c\u0438",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/lizakorob/zooticket150/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.zooticket.com/v1",
      "description": "\u0421\u0435\u0440\u0432\u0435\u0440"
    }
  ],
  "paths": {
    "/payments": {
      "post": {
        "summary": "\u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043f\u043b\u0430\u0442\u0435\u0436\u043d\u043e\u0439 \u0441\u0435\u0441\u0441\u0438\u0438",
        "description": "\u0421\u043e\u0437\u0434\u0430\u0435\u0442 \u043d\u043e\u0432\u0443\u044e \u043f\u043b\u0430\u0442\u0435\u0436\u043d\u0443\u044e \u0441\u0435\u0441\u0441\u0438\u044e \u0434\u043b\u044f \u043e\u043f\u043b\u0430\u0442\u044b \u0437\u0430\u043a\u0430\u0437\u0430 \u0431\u0438\u043b\u0435\u0442\u043e\u0432",
        "tags": [
          "\u041f\u043b\u0430\u0442\u0435\u0436\u0438"
        ],
        "requestBody": {
          "required": true,
          "description": "\u0414\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043f\u043b\u0430\u0442\u0435\u0436\u0430",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              },
              "example": {
                "order_id": "T-251201-001",
                "amount": 500,
                "description": "\u0411\u0438\u043b\u0435\u0442 \u0432 \u0437\u043e\u043e\u043f\u0430\u0440\u043a",
                "customer_email": "ivanov@mail.ru",
                "callback_url": "https://zooticket.com/callback",
                "customer_phone": "+71234567890",
                "customer_name": "\u0418\u0432\u0430\u043d\u043e\u0432 \u0418.\u0418."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "\u041f\u043b\u0430\u0442\u0435\u0436\u043d\u0430\u044f \u0441\u0435\u0441\u0441\u0438\u044f \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u043d\u0430",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessPaymentResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "payment_id": "pay_001",
                    "payment_url": "https://bank.ru/pay/001",
                    "status": "pending"
                  }
                }
              }
            }
          },
          "400": {
            "description": "\u041e\u0448\u0438\u0431\u043a\u0430 \u0432\u0430\u043b\u0438\u0434\u0430\u0446\u0438\u0438 \u0432\u0445\u043e\u0434\u043d\u044b\u0445 \u0434\u0430\u043d\u043d\u044b\u0445",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 \u0444\u043e\u0440\u043c\u0430\u0442 email. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0430\u0434\u0440\u0435\u0441"
                }
              }
            }
          },
          "402": {
            "description": "\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u043d\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442\u0430",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u041c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u2014 50 \u0440\u0443\u0431\u043b\u0435\u0439"
                }
              }
            }
          },
          "409": {
            "description": "\u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 - \u043f\u043b\u0430\u0442\u0435\u0436 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0437\u0430\u043a\u0430\u0437\u0430 \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0437\u0430\u043a\u0430\u0437\u0430 \u0443\u0436\u0435 \u0441\u043e\u0437\u0434\u0430\u043d \u043f\u043b\u0430\u0442\u0435\u0436"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}": {
      "get": {
        "summary": "\u041f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0441\u0442\u0430\u0442\u0443\u0441\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430",
        "description": "\u041f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u043f\u043e \u0435\u0433\u043e \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440\u0443",
        "tags": [
          "\u041f\u043b\u0430\u0442\u0435\u0436\u0438"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID \u043f\u043b\u0430\u0442\u0435\u0436\u0430, \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438",
            "example": "pay_001"
          }
        ],
        "responses": {
          "200": {
            "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0435\u043d",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "status": "paid",
                    "amount": 500,
                    "paid_at": "2025-05-15T17:30:00Z"
                  }
                }
              }
            }
          },
          "404": {
            "description": "\u041f\u043b\u0430\u0442\u0435\u0436 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u041f\u043b\u0430\u0442\u0435\u0436 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d"
                }
              }
            }
          },
          "410": {
            "description": "\u0421\u0440\u043e\u043a \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u0438\u0441\u0442\u0435\u043a",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u0421\u0440\u043e\u043a \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u0438\u0441\u0442\u0435\u043a"
                }
              }
            }
          },
          "423": {
            "description": "\u041f\u043b\u0430\u0442\u0435\u0436 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u041f\u043b\u0430\u0442\u0435\u0436 \u0437\u0430\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d"
                }
              }
            }
          }
        }
      }
    },
    "/refunds": {
      "post": {
        "summary": "\u0421\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432",
        "description": "\u0418\u043d\u0438\u0446\u0438\u0438\u0440\u0443\u0435\u0442 \u0432\u043e\u0437\u0432\u0440\u0430\u0442 \u0434\u0435\u043d\u0435\u0436\u043d\u044b\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0437\u0430 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u043d\u044b\u0439 \u0431\u0438\u043b\u0435\u0442",
        "tags": [
          "\u0412\u043e\u0437\u0432\u0440\u0430\u0442\u044b"
        ],
        "requestBody": {
          "required": true,
          "description": "\u0414\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430 \u0441\u0440\u0435\u0434\u0441\u0442\u0432",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRefundRequest"
              },
              "example": {
                "payment_id": "pay_001",
                "amount": 500,
                "reason": "\u041e\u0442\u043c\u0435\u043d\u0430 \u0431\u0438\u043b\u0435\u0442\u0430"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "\u0412\u043e\u0437\u0432\u0440\u0430\u0442 \u0441\u0440\u0435\u0434\u0441\u0442\u0432 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0441\u043e\u0437\u0434\u0430\u043d",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "refund_id": "ref_001",
                    "status": "processing"
                  }
                }
              }
            }
          },
          "400": {
            "description": "\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 \u0437\u0430\u043f\u0440\u043e\u0441",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u0421\u0443\u043c\u043c\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u0441\u0443\u043c\u043c\u0443 \u043f\u043b\u0430\u0442\u0435\u0436\u0430"
                }
              }
            }
          },
          "403": {
            "description": "\u0417\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043e",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u0412\u043e\u0437\u0432\u0440\u0430\u0442 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u0435\u043d. \u041f\u043b\u0430\u0442\u0435\u0436 \u043d\u0435 \u043e\u043f\u043b\u0430\u0447\u0435\u043d"
                }
              }
            }
          },
          "409": {
            "description": "\u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": "\u041f\u043e \u044d\u0442\u043e\u043c\u0443 \u043f\u043b\u0430\u0442\u0435\u0436\u0443 \u0443\u0436\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d \u0432\u043e\u0437\u0432\u0440\u0430\u0442"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePaymentRequest": {
        "type": "object",
        "required": [
          "order_id",
          "amount",
          "description",
          "customer_email",
          "callback_url"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "description": "\u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0439 \u043d\u043e\u043c\u0435\u0440 \u0437\u0430\u043a\u0430\u0437\u0430 \u0432 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 ZooTicket",
            "example": "T-251201-001"
          },
          "amount": {
            "type": "integer",
            "description": "\u0421\u0443\u043c\u043c\u0430 \u043a \u043e\u043f\u043b\u0430\u0442\u0435 \u0432 \u0440\u0443\u0431\u043b\u044f\u0445",
            "minimum": 50,
            "example": 500
          },
          "description": {
            "type": "string",
            "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0437\u0430\u043a\u0430\u0437\u0430 \u0434\u043b\u044f \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f",
            "example": "\u0411\u0438\u043b\u0435\u0442 \u0432 \u0437\u043e\u043e\u043f\u0430\u0440\u043a"
          },
          "customer_email": {
            "type": "string",
            "format": "email",
            "description": "Email \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f",
            "example": "ivanov@mail.ru"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "description": "\u0410\u0434\u0440\u0435\u0441 \u0434\u043b\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438 \u0443\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0439 \u043e\u0431 \u043e\u043f\u043b\u0430\u0442\u0435",
            "example": "https://zooticket.com/callback"
          },
          "customer_phone": {
            "type": "string",
            "description": "\u0422\u0435\u043b\u0435\u0444\u043e\u043d \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f",
            "example": "+71234567890"
          },
          "customer_name": {
            "type": "string",
            "description": "\u0418\u043c\u044f \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f",
            "example": "\u0418\u0432\u0430\u043d\u043e\u0432 \u0418.\u0418."
          }
        }
      },
      "SuccessPaymentResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "required": [
              "payment_id",
              "payment_url",
              "status"
            ],
            "properties": {
              "payment_id": {
                "type": "string",
                "description": "ID \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u0432 \u043f\u043b\u0430\u0442\u0435\u0436\u043d\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435",
                "example": "pay_001"
              },
              "payment_url": {
                "type": "string",
                "format": "uri",
                "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0445\u043e\u0434\u0430 \u043d\u0430 \u043e\u043f\u043b\u0430\u0442\u0443",
                "example": "https://bank.ru/pay/001"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending"
                ],
                "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043f\u043b\u0430\u0442\u0435\u0436\u0430",
                "example": "pending"
              }
            }
          }
        }
      },
      "PaymentStatusResponse": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "required": [
              "status",
              "amount"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "paid",
                  "failed",
                  "expired"
                ],
                "description": "\u0422\u0435\u043a\u0443\u0449\u0438\u0439 \u0441\u0442\u0430\u0442\u0443\u0441 \u043f\u043b\u0430\u0442\u0435\u0436\u0430",
                "example": "paid"
              },
              "amount": {
                "type": "integer",
                "description": "\u0421\u0443\u043c\u043c\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430 \u0432 \u0440\u0443\u0431\u043b\u044f\u0445",
                "example": 500
              },
              "paid_at": {
                "type": "string",
                "format": "date-time",
                "description": "\u0414\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0443\u0441\u043f\u0435\u0448\u043d\u043e\u0439 \u043e\u043f\u043b\u0430\u0442\u044b",
                "example": "2025-05-15T17:30:00Z"
              }
            }
          }
        }
      },
      "CreateRefundRequest": {
        "type": "object",
        "required": [
          "payment_id",
          "amount"
        ],
        "properties": {
          "payment_id": {
            "type": "string",
            "description": "ID \u043f\u043b\u0430\u0442\u0435\u0436\u0430, \u043f\u043e \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u0434\u0435\u043b\u0430\u0435\u043c \u0432\u043e\u0437\u0432\u0440\u0430\u0442",
            "example": "pay_001"
          },
          "amount": {
            "type": "integer",
            "description": "\u0421\u0443\u043c\u043c\u0430 \u0432\u043e\u0437\u0432\u0440\u0430\u0442\u0430 \u0432 \u0440\u0443\u0431\u043b\u044f\u0445",
            "minimum": 1,
            "example": 500
          },
          "reason": {
            "type": "string",
