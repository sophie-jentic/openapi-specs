{
  "openapi": "3.0.3",
  "info": {
    "title": "Voice Similarity API",
    "description": "بررسی شباهت بین متن ورودی و فایل صوتی با استفاده از سرویس Avalai",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/rdana-970/Voice1ForRdana/1.0.0"
  },
  "servers": [
    {
      "url": "https://voice1.tech-rdana.workers.dev",
      "description": "Cloudflare Worker endpoint"
    }
  ],
  "paths": {
    "/": {
      "post": {
        "summary": "بررسی شباهت صوت و متن",
        "description": "دریافت فایل صوتی و متن، تبدیل صوت به متن",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password",
                  "text",
                  "audio"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "voice1"
                  },
                  "password": {
                    "type": "string",
                    "example": "@123Voice!#1"
                  },
                  "text": {
                    "type": "string",
                    "example": "سلام، اینجا تهران است."
                  },
                  "audio": {
                    "type": "string",
                    "format": "binary",
                    "description": "فایل صوتی با فرمت مجاز (MP3, WAV, M4A, OGG)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "پاسخ موفق با درصد شباهت",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "integer",
                      "example": 200
                    },
                    "description": {
                      "type": "string",
                      "example": "شباهت محاسبه شد"
                    },
                    "similarity": {
                      "type": "integer",
                      "example": 87
                    },
                    "transcribed_text": {
                      "type": "string",
                      "example": "سلام، اینجا تهران است. صدای من را از تهران می‌شنوید."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ورودی نامعتبر"
          },
          "401": {
            "description": "اعتبارسنجی ناموفق"
          },
          "403": {
            "description": "فایل صوتی نامعتبر"
          },
          "404": {
            "description": "فرمت فایل پشتیبانی نمی‌شود"
          },
          "502": {
            "description": "خطای سرویس کارگزار"
          },
          "500": {
            "description": "خطای داخلی در Worker"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
