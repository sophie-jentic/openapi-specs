  "definitions": {
    "Register": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "login",
        "password"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "example": "John",
          "description": "new user's first name"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "login": {
          "type": "string",
          "example": "Johnny"
        },
        "password": {
          "type": "string",
          "example": "VeryDifficultPassword"
        }
      }
    },
    "Login": {
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "login",
        "password"
      ],
      "properties": {
        "login": {
          "type": "string",
          "example": "Johnny"
        },
        "password": {
          "type": "string",
          "example": "VeryDifficultPassword"
        }
      }
    },
    "Create": {
      "type": "object",
      "required": [
        "userID",
        "firstName",
        "lastName",
        "phone",
        "email"
      ],
      "properties": {
        "userID": {
          "type": "integer",
          "example": 31
        },
        "firstName": {
          "type": "string",
          "example": "Jane"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "phone": {
          "type": "string",
          "example": "4075551234"
        },
        "email": {
          "type": "string",
          "example": "jane@email.com"
        }
      }
    },
    "Search": {
      "type": "object",
      "required": [
        "userID",
        "search"
      ],
      "properties": {
        "userID": {
          "type": "integer",
          "example": 31
        },
        "search": {
          "type": "string",
          "example": "do"
        }
      }
    },
    "Update": {
      "type": "object",
      "required": [
        "id",
        "firstName",
        "lastName",
        "phone",
        "email"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "example": 80
        },
        "firstName": {
          "type": "string",
          "example": "Jo"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "phone": {
          "type": "string",
          "example": "4075551234"
        },
        "email": {
          "type": "string",
          "example": "joey@email.com"
        }
      }
    },
    "Delete": {
      "type": "object",
      "required": [
        "userID",
        "ID",
        "firstName",
        "lastName",
        "number",
        "email"
      ],
      "properties": {
        "ID": {
          "type": "integer",
          "example": 80
        },
        "userID": {
          "type": "integer",
          "example": 31
        }
      }
    }
  },
